#!/usr/bin/env sh
set -e

touches_app_src() {
  zero=0000000000000000000000000000000000000000
  seen=0
  while read -r _ local_sha _ remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" = "$zero" ] && continue
    seen=1
    if [ "$remote_sha" = "$zero" ]; then
      base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || return 0
    else
      git cat-file -e "$remote_sha^{commit}" 2>/dev/null || return 0
      base=$remote_sha
    fi
    files=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) || return 0
    printf '%s\n' "$files" | grep -q '^app/src/' && return 0
  done
  [ "$seen" -eq 0 ] && return 0
  return 1
}

if [ -d app/node_modules ]; then
  RUN_QUALITY=0
  touches_app_src && RUN_QUALITY=1
  (cd app && npm test)
  if [ "$RUN_QUALITY" -eq 1 ]; then
    bash scripts/check-quality-benchmarks.sh
  fi
else
  echo "SKIP: app/node_modules absent — full suite and quality benchmarks not run." >&2
fi
