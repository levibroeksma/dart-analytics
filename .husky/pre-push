#!/usr/bin/env sh
set -e

# Prints the files the pushed ranges change, read from the hook's stdin; prints
# ALL when a range cannot be resolved (so every gate runs) or nothing is pushed.
pushed_files() {
  zero=0000000000000000000000000000000000000000
  seen=0
  while read -r _ local_sha _ remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" = "$zero" ] && continue
    seen=1
    if [ "$remote_sha" = "$zero" ]; then
      base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || { echo ALL; return; }
    else
      git cat-file -e "$remote_sha^{commit}" 2>/dev/null || { echo ALL; return; }
      base=$remote_sha
    fi
    git diff --name-only "$base" "$local_sha" 2>/dev/null || { echo ALL; return; }
  done
  [ "$seen" -eq 0 ] && echo ALL
  return 0
}

if [ -d app/node_modules ]; then
  FILES=$(pushed_files)
  touches() { printf '%s\n' "$FILES" | grep -Eq "^(ALL\$|$1)"; }
  (cd app && npm test)
  if touches 'app/'; then
    bash scripts/check-types.sh
  fi
  if touches 'app/src/'; then
    bash scripts/fallow-gate.sh
    bash scripts/check-quality-benchmarks.sh
  fi
else
  echo "SKIP: app/node_modules absent — full suite, type check, fallow and quality benchmarks not run." >&2
fi
