.DS_Store
.cursor/
node_modules/
dist/
.astro/
.env
.env.*
!.env.example
.wrangler/

.superpowers/sdd/

# graphify — commit graph.json only (Task 3); ignore regenerable/local artifacts
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/20*/
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_*
graphify-out/.graphify_root
.graphify_python

# dbmate writes a schema dump next to the migrations run; the migration chain is the source of truth
app/db/

# drizzle-kit introspect rewrites its whole out/ dir; only schema.ts is committed (D290, issue #352)
app/src/db/0000_*.sql
app/src/db/relations.ts
app/src/db/meta/

# worktrees are local scratch checkouts, never committed
# .worktrees/ is the only home (D312) — one of the two prefixes the
# superpowers finishing skill owns at cleanup. The legacy
# .claude/worktrees/ entry is gone: the last worktree there landed, and
# scripts/check-worktree-location.sh now fails if the path reappears.
.worktrees/
