    "sql": "select $1::timestamptz, $2::timestamptz, "status_key", "context_key", "ruleset_version_key", ("turn_count" = 0), count(*), sum("turn_count"), sum("dart_count"), sum("duration_seconds"), sum("counted_score"), min("counted_score"), max("counted_score"), (array_agg("session_id" order by "counted_score" asc, "completed_at" asc))[1], (array_agg("session_id" order by "counted_score" desc, "completed_at" desc))[1], case when max("dart_count") > 0 then (array_agg("v_stats_session_facts"."session_id" order by "v_stats_session_facts"."counted_score"::numeric / nullif("v_stats_session_facts"."dart_count", 0) desc nulls last, "v_stats_session_facts"."completed_at" desc))[1] end, case when max("dart_count") > 0 then (array_agg("v_stats_session_facts"."counted_score" order by "v_stats_session_facts"."counted_score"::numeric / nullif("v_stats_session_facts"."dart_count", 0) desc nulls last, "v_stats_session_facts"."completed_at" desc))[1] end, case when max("dart_count") > 0 then (array_agg("v_stats_session_facts"."dart_count" order by "v_stats_session_facts"."counted_score"::numeric / nullif("v_stats_session_facts"."dart_count", 0) desc nulls last, "v_stats_session_facts"."completed_at" desc))[1] end, case when max("dart_count") > 0 then to_char(((array_agg("v_stats_session_facts"."completed_at" order by "v_stats_session_facts"."counted_score"::numeric / nullif("v_stats_session_facts"."dart_count", 0) desc nulls last, "v_stats_session_facts"."completed_at" desc))[1]) AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') end from "v_stats_session_facts" where ("v_stats_session_facts"."player_id" = $3 and "v_stats_session_facts"."game_type_key" = $4 and "v_stats_session_facts"."completed_at" >= $5 and "v_stats_session_facts"."completed_at" < $6 and "v_stats_session_facts"."status_key" in ($7) and "v_stats_session_facts"."session_id" IN (SELECT "v_stats_routine_step_facts"."session_id" FROM "v_stats_routine_step_facts" WHERE "v_stats_routine_step_facts"."player_id" = $8 AND "v_stats_routine_step_facts"."routine_key" = $9 AND "v_stats_routine_step_facts"."step_key" = $10)) group by "v_stats_session_facts"."status_key", "v_stats_session_facts"."context_key", "v_stats_session_facts"."ruleset_version_key", ("v_stats_session_facts"."turn_count" = 0)",
  },
]
`;

