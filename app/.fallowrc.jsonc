{
  "$schema": "https://fallow.tools/schema/config.json",
  "entry": [
    "neon.ts",
    "astro.config.mjs",
    "scripts/seed.ts",
    "scripts/smoke.ts",
    "scripts/seed-dev-auth.ts",
    "src/lib/client/alpine/app.factory.ts",
    "src/types/api/index.ts",
    // services/ area-root types.ts barrel (type-raising convention, docs/architecture/06-API/03-Shared-Conventions.md);
    // kept reachable even though nothing currently imports @services/types directly.
    "src/services/types.ts",
    "vitest.config.ts",
  ],
  "ignoreDependencies": [
    "@astrojs/alpinejs",
    "@astrojs/cloudflare",
    "@tailwindcss/vite",
    "postgres",
    "jose",
    // Offline brand asset generators (`icons:generate` / `logo:generate`) — not Worker runtime
    "@resvg/resvg-js",
    "culori",
    "opentype.js",
  ],
  "duplicates": {
    "ignore": ["src/db/schema.ts"],
  },
  "ignoreExports": [
    // Intentional two-barrel API (D103/D156): the Worker route's type is
    // canonically re-exported once through @client/api/types, and again by
    // each leaf module so a caller can import fetch fn + type from one path.
    {
      "file": "src/lib/client/api/configuration-templates.ts",
      "exports": ["ConfigurationPresetData"],
    },
    {
      "file": "src/lib/client/api/sessions.ts",
      "exports": ["SessionActiveData"],
    },
    {
      "file": "src/lib/client/api/types.ts",
      "exports": ["ConfigurationPresetData", "SessionActiveData"],
    },
  ],
  "health": {
    "ignore": ["src/middleware.ts", "src/lib/auth/verify-jwt.ts"],
    "thresholdOverrides": [
      {
        "files": ["src/components/ui/CardWrapper.astro"],
        "maxCrap": 100,
        "reason": "Glass card markup; complexity tracked for PR2 split",
      },
      {
        "files": ["src/components/layout/games/ScoreInput.astro"],
        "maxCrap": 60,
        "reason": "Play UI template; pre-existing layout complexity",
      },
    ],
  },
}
