---
import BaseLayout from "@layouts/BaseLayout.astro";
import BottomNav from "@components/layout/BottomNav.astro";

interface Props {
  title?: string;
  backdrop?: "home";
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <div class="mx-auto flex h-full max-w-lg flex-col">
    <main
      class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-y-contain pb-[calc(env(safe-area-inset-bottom)+5.5rem)]"
    >
      <slot />
    </main>
    <BottomNav />
  </div>
</BaseLayout>
