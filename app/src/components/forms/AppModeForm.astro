---
/**
 * App-mode picker. Reads and writes the `settings` Alpine store, which loads
 * itself in `init()`; each choice persists on click and the store keeps the
 * previous pair when a save fails. Roving-tabindex radiogroup: the selected
 * option is the group's only tab stop, arrow keys move + persist selection
 * and follow it with focus, and the checkmark supplements colour as the
 * selected-state cue. Quick score holds the tab stop whenever the stored mode
 * is neither of the two offered here — `PATCH` accepts pairs this form does
 * not show (RECREATIONAL + DETAILED_DARTS), and without the fallback both
 * options would be tabindex -1 and the group unreachable by keyboard.
 * @param {string} [class] Extra classes
 */
interface Props {
  class?: string;
  [key: string]: unknown;
}

// Props
const { class: classNameProp, ...props }: Props = Astro.props;

// Components
import ErrorAlert from "@components/ui/ErrorAlert.astro";

// Lib
import { cn } from "@client/cn";

// Styles
const className = cn(
  "glass flex flex-col gap-4 rounded-2xl p-4 shadow-none",
  classNameProp,
);
const eyebrowClass =
  "px-0.5 font-mono text-[10px]/[normal] font-semibold tracking-[0.12em] text-muted-foreground";
const trackClass = "field-inset grid grid-cols-2 gap-1 rounded-full p-1";
const optionClass =
  "flex h-10 items-center justify-center rounded-full text-[13px]/[normal] font-semibold transition-colors duration-150 disabled:cursor-not-allowed disabled:opacity-40";
---

<section
  class={className}
  aria-labelledby="app-mode-heading"
  {...props}
>
  <div class="flex flex-col gap-2">
    <h2
      id="app-mode-heading"
      class="font-display text-[13px]/[normal] tracking-[0.06em]"
    >
      App mode
    </h2>
    <p class="text-xs/[1.5] text-pretty text-muted">
      Analytics tracks every dart for in-depth statistics and focused
      improvements to your game. Recreational just logs a visit total.
    </p>
  </div>

  <div
    class="flex flex-col gap-2"
    x-show="!$store.settings.loading"
    x-cloak
  >
    <span class={eyebrowClass}>MODE</span>
    <div
      class={trackClass}
      role="radiogroup"
      aria-labelledby="app-mode-heading"
      x-data="{
        async selectOther(captureModeKey, inputModeKey, ref) {
          if ($store.settings.loading) return;
          await $store.settings.save(captureModeKey, inputModeKey);
          $nextTick(() => $refs[ref].focus());
        },
      }"
    >
      <button
        type="button"
        role="radio"
        x-ref="quickScoreOption"
        class={optionClass}
        :class="$store.settings.inputModeKey === 'QUICK_SCORE' ? 'accent-orb text-foreground' : 'text-muted-foreground'"
        :aria-checked="$store.settings.inputModeKey === 'QUICK_SCORE'"
        :tabindex="$store.settings.inputModeKey === 'VISUAL_BOARD' ? -1 : 0"
        :disabled="$store.settings.loading"
        @click="$store.settings.save('RECREATIONAL', 'QUICK_SCORE')"
        @keydown.arrow-left.prevent="selectOther('ANALYTICS', 'VISUAL_BOARD', 'analyticsOption')"
        @keydown.arrow-up.prevent="selectOther('ANALYTICS', 'VISUAL_BOARD', 'analyticsOption')"
        @keydown.arrow-right.prevent="selectOther('ANALYTICS', 'VISUAL_BOARD', 'analyticsOption')"
        @keydown.arrow-down.prevent="selectOther('ANALYTICS', 'VISUAL_BOARD', 'analyticsOption')"
      >
        Quick score
      </button>

      <button
        type="button"
        role="radio"
        x-ref="analyticsOption"
        class={optionClass}
        :class="$store.settings.inputModeKey === 'VISUAL_BOARD' ? 'accent-orb text-foreground' : 'text-muted-foreground'"
        :aria-checked="$store.settings.inputModeKey === 'VISUAL_BOARD'"
        :tabindex="$store.settings.inputModeKey === 'VISUAL_BOARD' ? 0 : -1"
        :disabled="$store.settings.loading"
        @click="$store.settings.save('ANALYTICS', 'VISUAL_BOARD')"
        @keydown.arrow-left.prevent="selectOther('RECREATIONAL', 'QUICK_SCORE', 'quickScoreOption')"
        @keydown.arrow-up.prevent="selectOther('RECREATIONAL', 'QUICK_SCORE', 'quickScoreOption')"
        @keydown.arrow-right.prevent="selectOther('RECREATIONAL', 'QUICK_SCORE', 'quickScoreOption')"
        @keydown.arrow-down.prevent="selectOther('RECREATIONAL', 'QUICK_SCORE', 'quickScoreOption')"
      >
        Analytics
      </button>
    </div>
  </div>

  <div
    class="flex flex-col gap-2"
    x-show="$store.settings.loading"
    x-cloak
    aria-hidden="true"
  >
    <span class={eyebrowClass}>MODE</span>
    <div class={trackClass}>
      <div class="h-10 animate-pulse rounded-full bg-surface-raised"></div>
      <div class="h-10 animate-pulse rounded-full bg-surface-raised"></div>
    </div>
  </div>

  <ErrorAlert
    showExpr="$store.settings.error"
    textExpr="$store.settings.error"
  />
</section>
