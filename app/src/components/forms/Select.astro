---
/**
 * Glass dropdown: a full-width 48px glass bar showing the picked label that
 * grows downward into a panel listing every option, and collapses back on
 * pick, outside click or Escape. The open panel overlays the content below.
 *
 * Options stay laid out while closed: a `grid-template-rows` transition
 * (`0fr` ↔ `1fr`) animates the panel's own height, so nothing is measured or
 * reflowed mid-animation; options fade in once the panel has mostly grown,
 * and are `inert` while closed.
 *
 * The value lives in the caller's scope — `model` names a writable Alpine
 * expression there; the caller seeds it (no placeholder state).
 * Options are either fixed at build time (`options`) or read at runtime from
 * the caller's scope (`optionsExpr`, e.g. data fetched in `init()`); pass one.
 * @param {SelectOption[]} [options] Build-time options
 * @param {string} [optionsExpr] Alpine expression yielding `SelectOption[]`
 * @param {string} model Writable Alpine expression holding the picked value
 * @param {string} ariaLabel Accessible name of the control
 * @param {string} [class] Extra wrapper classes
 */
interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  options?: readonly SelectOption[];
  optionsExpr?: string;
  model: string;
  ariaLabel: string;
  class?: string;
}

// Props
const {
  options = [],
  optionsExpr,
  model,
  ariaLabel,
  class: classNameProp,
}: Props = Astro.props;

// Components
import Button from "@components/forms/Button.astro";

// Lib
import { cn } from "@client/cn";

// Icons
import CheckIcon from "@icons/check.svg";
import ChevronDownIcon from "@icons/chevron-down.svg";

// Data
const scope = JSON.stringify({ open: false, fixedOptions: options });
const list = optionsExpr ?? "fixedOptions";
const picked = `${model} === option.value`;
const pickedLabel = `(${list}).find((option) => ${picked})?.label ?? ''`;
const pickedClass = `${picked} ? 'border-border bg-tab-active backdrop-blur-[2px]' : ''`;
const pick = `${model} = option.value; open = false`;

// Styles
const wrapperClass = cn("relative h-12", classNameProp);
---

<div
  class={wrapperClass}
  x-data={scope}
  @click.outside="open = false"
  @keydown.escape.window="open = false"
>
  <div
    class="glass group absolute inset-x-0 top-0 z-40 overflow-hidden rounded-3xl"
    :data-open="open"
  >
    <Button
      variant="ghost"
      class="h-12 w-full justify-between rounded-3xl px-4 text-sm font-normal text-foreground"
      loadingExpr="false"
      aria-haspopup="listbox"
      ariaLabel={ariaLabel}
      :aria-expanded="open"
      @click="open = !open"
    >
      <span
        slot="iconBefore"
        x-text={pickedLabel}
      >
      </span>
      <ChevronDownIcon
        slot="iconAfter"
        class="size-4 transition-transform duration-250 ease-in group-data-open:rotate-180"
        aria-hidden="true"
      />
    </Button>
    <div
      class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-250 ease-in group-data-open:grid-rows-[1fr]"
    >
      <div
        role="listbox"
        aria-label={ariaLabel}
        class="min-h-0 overflow-hidden"
        :inert="!open"
      >
        <div
          class="max-h-[60dvh] space-y-1 overflow-y-auto p-2 pt-0 opacity-0 transition-opacity duration-75 group-data-open:opacity-100 group-data-open:delay-150 group-data-open:duration-150"
        >
          <template
            x-for={`option in ${list}`}
            :key="option.value"
          >
            <button
              type="button"
              role="option"
              class="flex w-full items-center justify-between rounded-2xl border border-transparent px-3 py-2.5 text-left text-sm text-foreground transition-colors duration-150 hover:bg-glass-strong"
              x-bind:class={pickedClass}
              x-bind:aria-selected={picked}
              x-on:click={pick}
            >
              <span x-text="option.label"></span>
              <CheckIcon
                class="size-4 text-accent"
                x-show={picked}
                x-cloak
                aria-hidden="true"
              />
            </button>
          </template>
        </div>
      </div>
    </div>
  </div>
</div>
