---
/**
 * Native `<select>` styled to match `Input.astro`. Bind the chosen value from
 * a parent scope with `x-model`; extra attributes spread onto the element.
 * @param {SelectOption[]} options
 * @param {string} [id]
 * @param {string} [name]
 * @param {string} [placeholder] Disabled first option with value `""`
 * @param {boolean} [disabled]
 * @param {string} [class] Extra classes
 */
interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  options: readonly SelectOption[];
  id?: string;
  name?: string;
  placeholder?: string;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

// Props
const {
  options,
  id,
  name,
  placeholder,
  disabled = false,
  class: classNameProp = "",
  ...props
} = Astro.props;

// Lib
import { cn } from "@client/cn";

// Styles
const selectId = id ?? name;
const className = cn(
  "input w-full rounded-md border border-border px-3.5 py-2.5 text-sm text-foreground outline-none transition-[border-color,box-shadow,background-color] duration-150",
  classNameProp,
);
---

<select
  id={selectId}
  name={name}
  disabled={disabled}
  class={className}
  {...props}
>
  {
    placeholder && (
      <option
        value=""
        disabled
        selected
      >
        {placeholder}
      </option>
    )
  }
  {
    options.map((option) => (
      <option value={option.value}>{option.label}</option>
    ))
  }
</select>
