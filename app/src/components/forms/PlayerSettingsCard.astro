---
/**
 * Player settings card: display name, darts, weight, and throwing hand as
 * inset fields in one shadowless glass card. Every field renders its
 * skeleton until the profile's first load settles.
 * @param {string} [class] Extra classes
 */
interface Props {
  class?: string;
  [key: string]: unknown;
}

// Props
const { class: classNameProp = "", ...props }: Props = Astro.props;

// Components
import SettingRow from "@components/forms/SettingRow.astro";
import HandednessForm from "@components/forms/HandednessForm.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";

// Lib
import { cn } from "@client/cn";

// Styles
const className = cn(
  "glass flex flex-col gap-4 rounded-2xl p-4 shadow-none",
  classNameProp,
);
const handedLabelClass =
  "px-0.5 font-mono text-[10px]/[normal] font-semibold tracking-[0.12em] text-muted-foreground uppercase";
---

<div
  class={className}
  {...props}
>
  <h2 class="font-display text-[13px]/[normal] tracking-[0.06em]">
    Player settings
  </h2>
  <SettingRow
    id="displayName"
    label="Display name"
    valueExpr="$store.profile.displayName"
    modelExpr="$store.profile.displayName"
    saveExpr="$store.profile.save()"
    placeholder="Display name"
    skeletonWidth="w-12"
    required
    maxlength={24}
    disabledExpr="$store.profile.loaded && $store.profile.loading"
    skeletonExpr="!$store.profile.loaded"
  />
  <SettingRow
    id="dartsDescription"
    label="Darts"
    valueExpr="$store.profile.dartsDescription"
    modelExpr="$store.profile.dartsDescription"
    saveExpr="$store.profile.save()"
    placeholder="e.g. Winmau Pro-Series 23g"
    skeletonWidth="w-44"
    emptyText="Not set"
    disabledExpr="$store.profile.loaded && $store.profile.loading"
    skeletonExpr="!$store.profile.loaded"
  />
  <SettingRow
    id="dartsWeightGrams"
    label="Weight"
    valueExpr="$store.profile.weightLabel"
    modelExpr="$store.profile.dartsWeightGrams"
    saveExpr="$store.profile.save()"
    placeholder="Weight in grams"
    skeletonWidth="w-9"
    emptyText="Not set"
    numeric
    inputmode="numeric"
    disabledExpr="$store.profile.loaded && $store.profile.loading"
    skeletonExpr="!$store.profile.loaded"
  />
  <div class="flex flex-col gap-2">
    <span
      id="handedness-label"
      class={handedLabelClass}
    >
      Handed
    </span>
    <HandednessForm skeletonExpr="!$store.profile.loaded" />
  </div>

  <ErrorAlert
    showExpr="$store.profile.error"
    textExpr="$store.profile.error"
  />
</div>
