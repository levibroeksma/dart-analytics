---
/**
 * Mono eyebrow label over an inset field. View mode is a button showing
 * `valueExpr` (falling back to `emptyText` when empty) with a pencil;
 * tapping it swaps to an inset input bound to `modelExpr`, which runs
 * `saveExpr` and flips back to view mode on blur or Enter. With `maxlength`,
 * editing shows a `n / max` hint under the input. While `skeletonExpr` is
 * true the value renders as a pulsing bar of `skeletonWidth`, inside the
 * same field, so the row keeps its size when data arrives.
 * @param {string} id
 * @param {string} label
 * @param {string} valueExpr Alpine expression for the displayed value
 * @param {string} modelExpr Alpine `x-model` target for the input
 * @param {string} saveExpr Alpine call fired on blur/Enter
 * @param {string} [placeholder]
 * @param {string} [emptyText] Shown in place of an empty `valueExpr`
 * @param {boolean} [numeric] Use `x-model.number` instead of `x-model`
 * @param {"numeric"} [inputmode] Passed through to the input
 * @param {boolean} [required]
 * @param {number} [maxlength] Input length cap; also enables the counter hint
 * @param {string} [disabledExpr] Alpine expression; defaults to `"false"`
 * @param {string} [skeletonExpr] Alpine expression; defaults to `"false"`
 * @param {string} [skeletonWidth] Width class for the placeholder bar
 * @param {string} [class] Extra classes
 */
interface Props {
  id: string;
  label: string;
  valueExpr: string;
  modelExpr: string;
  saveExpr: string;
  placeholder?: string;
  emptyText?: string;
  numeric?: boolean;
  inputmode?: "numeric";
  required?: boolean;
  maxlength?: number;
  disabledExpr?: string;
  skeletonExpr?: string;
  skeletonWidth?: string;
  class?: string;
  [key: string]: unknown;
}

// Props
const {
  id,
  label,
  valueExpr,
  modelExpr,
  saveExpr,
  placeholder,
  emptyText,
  numeric = false,
  inputmode,
  required = false,
  maxlength,
  disabledExpr = "false",
  skeletonExpr = "false",
  skeletonWidth = "w-24",
  class: classNameProp = "",
  ...props
}: Props = Astro.props;

// Components
import Input from "@components/forms/Input.astro";
import Button from "@components/forms/Button.astro";

// Lib
import { cn } from "@client/cn";

// Icons
import PencilIcon from "@icons/pencil.svg";

// Styles
const className = cn("flex flex-col gap-2", classNameProp);
const labelClass =
  "px-0.5 font-mono text-[10px]/[normal] font-semibold tracking-[0.12em] uppercase";
const fieldClass = "field-inset h-13 w-full rounded-xl border-0 px-4";
const skeletonClass = cn(
  "inline-block h-[1lh] animate-pulse rounded-md bg-foreground/12 align-top",
  skeletonWidth,
);
const hintExpr =
  maxlength === undefined
    ? undefined
    : `String(${modelExpr} ?? "").length + " / ${maxlength} · saves when you leave the field"`;
const displayExpr = emptyText
  ? `(${valueExpr}) || ${JSON.stringify(emptyText)}`
  : valueExpr;
const modelDirective = numeric
  ? { "x-model.number": modelExpr }
  : { "x-model": modelExpr };
const requiredEmptyExpr = required
  ? `(!${modelExpr} || ${modelExpr}.trim() === "")`
  : "false";
/**
 * Blur/Enter never blindly saves: `$store.profile.save()` round-trips every
 * profile field together, so a stray blur on one row would otherwise
 * re-validate and resubmit the other two. Unchanged values are a no-op; a
 * required field left empty reverts to the value present when editing
 * started instead of attempting an invalid save.
 */
const dataExpr = `{
  editing: false,
  openValue: null,
  commit() {
    if (${requiredEmptyExpr}) {
      ${modelExpr} = this.openValue;
    } else if (${modelExpr} !== this.openValue) {
      ${saveExpr};
    }
    this.editing = false;
  },
}`;
/** A skeleton row is inert without `disabled`'s dimming, so it keeps the design's full-opacity field. */
const openExpr = `if (${skeletonExpr}) return; editing = true; openValue = ${modelExpr}; $nextTick(() => $refs.input.focus())`;
---

<div
  x-data={dataExpr}
  class={className}
  {...props}
>
  <label
    for={id}
    class={labelClass}
    :class="editing ? 'text-accent-bright' : 'text-muted-foreground'"
  >
    {label}
  </label>
  <div class="grid min-h-13">
    <Button
      variant="ghost"
      loadingExpr="false"
      ariaLabel={`Edit ${label}`}
      :aria-label={`${JSON.stringify(`Edit ${label}: `)} + (${displayExpr})`}
      class={cn(fieldClass, "justify-between gap-3 text-foreground")}
      x-show="!editing"
      x-cloak
      :disabled={disabledExpr}
      :aria-busy={skeletonExpr}
      @click={openExpr}
    >
      <span
        slot="iconBefore"
        class="min-w-0 truncate text-[15px]/[normal] font-normal"
      >
        <span
          x-show={`!(${skeletonExpr})`}
          x-cloak
          x-text={displayExpr}
        ></span>
        <span
          class={skeletonClass}
          x-show={skeletonExpr}
          x-cloak
          aria-hidden="true"
        ></span>
      </span>
      <PencilIcon
        slot="iconAfter"
        class="size-4 shrink-0 text-muted-foreground"
        aria-hidden="true"
      />
    </Button>
    <Input
      id={id}
      name={id}
      type="text"
      inputmode={inputmode}
      placeholder={placeholder}
      required={required}
      maxlength={maxlength}
      class={cn(fieldClass, "py-0 text-[15px]")}
      x-show="editing"
      x-cloak
      x-ref="input"
      {...modelDirective}
      :disabled={disabledExpr}
      @blur="commit()"
      @keydown.enter.prevent="commit()"
    />
  </div>
  {
    hintExpr && (
      <span
        class="px-0.5 text-xs/[normal] text-muted"
        x-show="editing"
        x-cloak
        x-text={hintExpr}
      />
    )
  }
</div>
