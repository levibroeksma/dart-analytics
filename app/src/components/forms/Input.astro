---
/**
 * Text-like input: a 48px inset-well pill with a sky focus ring and an
 * optional coral error state.
 * @param {string} [id]
 * @param {"text"|"email"|"password"|"number"|"tel"|"url"|"search"|"submit"} [type]
 * @param {string} [name]
 * @param {string} [value]
 * @param {string} [placeholder]
 * @param {boolean} [error]
 * @param {boolean} [required]
 * @param {boolean} [disabled]
 * @param {string} [ariaDescribedby]
 * @param {string} [class] Extra classes
 */
interface Props {
  id?: string;
  type?:
    | "text"
    | "email"
    | "password"
    | "number"
    | "tel"
    | "url"
    | "search"
    | "submit";
  name?: string;
  value?: string;
  placeholder?: string;
  error?: boolean;
  required?: boolean;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

// Props
const {
  id,
  type = "text",
  name,
  value,
  placeholder,
  error = false,
  required = false,
  disabled = false,
  class: classNameProp = "",
  ...props
} = Astro.props;

// Lib
import { cn } from "@client/cn";

// Styles
const inputId = id ?? name;
const className = cn(
  "input h-12 w-full rounded-full px-4.5 text-control font-medium text-foreground outline-none transition duration-150 placeholder:text-muted",
  error && "input-error",
  classNameProp,
);
---

<input
  id={inputId}
  type={type}
  name={name}
  value={value}
  placeholder={placeholder}
  disabled={disabled}
  required={required}
  class={className}
  {...props}
/>
