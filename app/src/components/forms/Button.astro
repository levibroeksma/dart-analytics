---
/**
 * Button with design-system variants.
 * @param {"button"|"submit"|"reset"} [type]
 * @param {"primary"|"secondary"|"ghost"|"error"|"dashed"|"sheet-muted"|"sheet-raised"} [variant]
 * @param {boolean} [icon] Equal padding on all sides (icon-only / square hit area)
 * @param {boolean} [disabled]
 * @param {string} [ariaLabel] Accessible name (required for icon-only)
 * @slot default Visible label for text only known at runtime (e.g. an Alpine `x-text` inside `x-for`); replaces `title` when present
 * @param {string} [class] Extra classes
 */
interface Props {
  type?: "button" | "submit" | "reset";
  title?: string;
  variant?:
    | "primary"
    | "secondary"
    | "ghost"
    | "error"
    | "dashed"
    | "sheet-muted"
    | "sheet-raised";
  icon?: boolean;
  grow?: boolean;
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
  /**
   * Alpine expression evaluating to a boolean; controls the built-in spinner.
   * Omitted, it reads `loading` from the enclosing Alpine scope when one is
   * defined, so a button outside any `loading` scope never spins. A button
   * whose scope defines an unrelated `loading` must pass `"false"`.
   */
  loadingExpr?: string;
  [key: string]: unknown;
}

// Props
const {
  type = "button",
  title,
  variant = "primary",
  icon = false,
  grow = false,
  disabled = false,
  ariaLabel,
  class: classNameProp = "",
  loadingExpr = "typeof loading !== 'undefined' && loading",
  ...props
}: Props = Astro.props;

// Lib
import { cn } from "@client/cn";

// Icons
import LoadingIcon from "@icons/loading.svg";

// Slots
const hasLabelSlot = Astro.slots.has("default");

// Styles
const variantClasses = {
  primary: "border-transparent bg-white text-black btn-primary",
  secondary: "border-border text-foreground btn-secondary",
  ghost: "text-muted-foreground btn-ghost",
  error: "bg-error-strong text-error-foreground btn-error",
  dashed: "border-accent border-dashed bg-transparent text-muted-foreground",
  "sheet-muted":
    "h-13 rounded-2xl text-button inset-well-muted text-muted-foreground",
  "sheet-raised": "h-13 rounded-2xl text-button glass-button text-foreground",
}[variant];

const className = cn(
  "btn inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold transition-[transform,color,background-color,border-color,box-shadow] duration-150 text-nowrap",
  !variant.startsWith("sheet-") && "border border-transparent",
  variantClasses,
  icon ? "p-2.5" : "px-4 py-2.5",
  grow && "flex-1 min-w-0",
  classNameProp,
);
---

<button
  type={type}
  disabled={disabled}
  aria-label={ariaLabel}
  class={className}
  {...props}
>
  <slot name="iconBefore" />
  {
    (hasLabelSlot || title) && (
      <span
        x-show={`!(${loadingExpr})`}
        x-cloak
      >
        {hasLabelSlot ? <slot /> : title}
      </span>
    )
  }
  <LoadingIcon
    x-show={loadingExpr}
    x-cloak
    class="size-5 animate-spin"
  />
  <slot name="iconAfter" />
</button>
