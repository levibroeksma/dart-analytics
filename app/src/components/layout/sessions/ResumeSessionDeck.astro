---
/**
 * Homepage deck of the player's open games, run by `resumeDeck()`: once the
 * load settles, the newest game on top of a card stack with a pager and swipe
 * to step through the rest. Not rendered while loading, when there is nothing
 * to resume, or when the load failed. Only the session this device holds can be
 * resumed: its button reads "Resume game", any other reads "Start over"
 * beside a note that its progress is elsewhere (setup asks before abandoning it, D460).
 * The top card is one persistent element so
 * its phase animation and `animationend` survive an index change.
 * @param {string} [class] Extra classes for the section
 */
interface Props {
  class?: string;
  [key: string]: unknown;
}

// Props
const { class: classNameProp, ...props }: Props = Astro.props;

// Components
import Button from "@components/forms/Button.astro";
import CardStack from "@components/ui/CardStack.astro";
import DeckPager from "@components/ui/DeckPager.astro";

// Lib
import { cn } from "@client/cn";

// Icons
import PlayIcon from "@icons/play-rounded.svg";

// Styles
const cardClass = "deck-top-card flex flex-col gap-3.5 rounded-2xl p-4";
const phaseClassExpr =
  "{ 'animate-deck-out motion-reduce:animate-deck-fade-out': phase === 'out', 'animate-deck-rise motion-reduce:animate-deck-fade-rise': phase === 'rise', 'animate-deck-in motion-reduce:animate-deck-fade-in': phase === 'in' }";
---

<section
  class={cn(classNameProp)}
  x-data="resumeDeck()"
  x-show="visible()"
  x-cloak
  {...props}
>
  <template x-if="visible()">
    <CardStack layersExpr="layers()">
      <div
        class={cn(cardClass, "relative touch-pan-y touch-pinch-zoom")}
        :class={phaseClassExpr}
        @animationend.self="settle()"
        @pointerdown="swipeStart($event)"
        @pointerup="swipeEnd($event)"
        @pointercancel="swipeCancel()"
      >
        <div
          class="flex min-h-7 items-center justify-between font-mono text-caption font-semibold"
        >
          <span class="text-eyebrow-lg text-foreground">IN PROGRESS</span>
          <DeckPager
            positionExpr="position()"
            prevExpr="prev()"
            nextExpr="next()"
            prevLabel="Previous open game"
            nextLabel="Next open game"
            labelExpr="top()?.title"
            x-show="cards.length > 1"
            x-cloak
          />
          <span
            class="text-accent-foreground-muted"
            x-show="cards.length <= 1"
            x-cloak
            x-text="top()?.started"
          ></span>
        </div>
        <div class="flex items-end justify-between gap-3">
          <div class="flex min-w-0 flex-col gap-1.5">
            <span
              class="font-display text-xl"
              x-text="top()?.title"
            ></span>
            <span
              class="text-body-sm font-semibold text-accent-foreground-muted"
              x-text="top()?.detail"
            ></span>
            <span
              class="text-body-sm font-semibold text-accent-foreground-muted"
              x-show="!top()?.local"
              x-cloak
              >Progress is on another device</span
            >
          </div>
          <div
            class="flex flex-none flex-col items-end gap-0.5"
            x-show="top()?.big"
            x-cloak
          >
            <span
              class="font-display text-3xl leading-none"
              x-text="top()?.big?.value"
            ></span>
            <span
              class="font-mono text-eyebrow font-semibold text-accent-foreground-muted"
              x-text="top()?.big?.label"
            ></span>
          </div>
        </div>
        <Button
          variant="secondary"
          loadingExpr="false"
          class="glass-button h-12 w-full rounded-lg text-control"
          @click="resume()"
        >
          <PlayIcon
            slot="iconBefore"
            class="size-4.5"
            aria-hidden="true"
            x-show="top()?.local"
            x-cloak
          />
          <span x-text="top()?.local ? 'Resume game' : 'Start over'"></span>
        </Button>
      </div>
    </CardStack>
  </template>
</section>
