---
/**
 * The three-dart strip above the board during a Dartbot visit: each slot
 * reads `DART n` until its dart lands, then the hit (`T20`) over a filled
 * accent bar; the dart being aimed or thrown gets the accent ring. Reads
 * `$data.botFlight` from the enclosing play scope and renders only while it is set.
 */
---

<div
  class="grid w-full grid-cols-3 gap-2 rounded-key inset-well px-3 py-2.5"
  x-show="$data.botFlight"
  x-cloak
>
  <template
    x-for="i in [0, 1, 2]"
    :key="i"
  >
    <div class="flex flex-col items-center gap-2">
      <span
        class="font-mono text-eyebrow font-semibold"
        :class="$data.botFlight?.landed[i] ? 'text-accent' : $data.botFlight?.dartIndex === i ? 'text-foreground' : 'text-muted'"
        x-text="$data.botFlight?.landed[i]?.label ?? `DART ${i + 1}`"
      ></span>
      <span
        class="h-1.5 w-full rounded-full transition-colors duration-200"
        :class="$data.botFlight?.landed[i] ? 'bg-accent' : $data.botFlight?.dartIndex === i ? 'next-dart-ring' : 'inset-well'"
      ></span>
    </div>
  </template>
</div>
