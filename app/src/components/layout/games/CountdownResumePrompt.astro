---
/**
 * Paused rest screen for a MINUTES countdown (#253, #1210): a full-viewport
 * overlay over the title bar and the score, with a glass play symbol at the
 * viewport centre and a rotating tip card centred in the space above it.
 * It has the same `disabledExpr` contract as `CountdownPauseControl`;
 * `pausedExpr` and `toggleExpr` override the `$store.game` defaults for a
 * scope with its own pause, and `tipKeyExpr` names the tips key.
 */
interface Props {
  /** Alpine expression evaluating to a boolean; disables the resume button. */
  disabledExpr: string;
  /** Alpine expression: whether the timer is paused. */
  pausedExpr?: string;
  /** Alpine expression: the pause toggle call. */
  toggleExpr?: string;
  /** Alpine expression: the ruleset or step key the tips match on. */
  tipKeyExpr?: string;
}

// Props
const {
  disabledExpr,
  pausedExpr = "$store.game.timerPaused",
  toggleExpr = "togglePause()",
  tipKeyExpr = "$store.game.rulesetVersionKey",
}: Props = Astro.props;

// Components
import Button from "@components/forms/Button.astro";

const uid = crypto.randomUUID().slice(0, 8);
const fillId = `paused-play-fill-${uid}`;
const edgeId = `paused-play-edge-${uid}`;

const PLAY_PATH =
  "M7.5 5.147c0-.909 1.008-1.457 1.771-.964l10.157 6.553c.792.511.755 1.677-.066 2.137L9.34 19.4c-.797.446-1.777-.13-1.777-1.043z";
---

<div
  class="fixed inset-0 z-50 bg-surface"
  x-data={`pausedTips(() => (${tipKeyExpr}))`}
  x-effect={`(${pausedExpr}) ? start() : stop()`}
  x-show={pausedExpr}
  x-cloak
>
  <div class="absolute inset-x-4 top-0 bottom-1/2 mb-14 flex items-center">
    <div
      class="glass mx-auto w-full max-w-md rounded-2xl px-4 py-3 transition-opacity duration-300 ease-out motion-reduce:transition-none"
      :class="visible ? 'opacity-100' : 'opacity-0'"
    >
      <p
        class="font-mono text-eyebrow font-semibold uppercase tracking-widest text-accent"
      >
        Tip
      </p>
      <p
        class="mt-1 text-sm text-muted"
        x-text="tip"
      >
      </p>
    </div>
  </div>
  <Button
    type="button"
    variant="ghost"
    icon
    ariaLabel="Resume timer"
    loadingExpr="false"
    class="absolute top-1/2 left-1/2 size-28 -translate-x-1/2 -translate-y-1/2 p-0 hover:bg-transparent"
    :disabled={disabledExpr}
    @click={toggleExpr}
  >
    <svg
      slot="iconBefore"
      class="size-full"
      viewBox="0 0 24 24"
      aria-hidden="true"
      style="filter: var(--play-glass-shadow)"
    >
      <defs>
        <radialGradient
          id={fillId}
          cx="50%"
          cy="0%"
          r="110%"
        >
          <stop
            offset="0"
            style="stop-color: var(--play-glass-fill-top)"
          ></stop>
          <stop
            offset="0.85"
            style="stop-color: var(--play-glass-fill-bottom)"
          ></stop>
        </radialGradient>
        <linearGradient
          id={edgeId}
          x1="0"
          y1="0"
          x2="0"
          y2="1"
        >
          <stop
            offset="0"
            style="stop-color: var(--play-glass-edge-top)"
          ></stop>
          <stop
            offset="0.5"
            style="stop-color: var(--play-glass-edge-mid)"
          ></stop>
          <stop
            offset="1"
            style="stop-color: var(--play-glass-edge-bottom)"
          ></stop>
        </linearGradient>
      </defs>
      <path
        d={PLAY_PATH}
        fill={`url(#${fillId})`}
        stroke={`url(#${edgeId})`}
        stroke-width="0.5"
        stroke-linejoin="round"
      ></path>
    </svg>
  </Button>
</div>
