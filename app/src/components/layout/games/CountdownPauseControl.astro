---
/**
 * MINUTES-mode countdown label plus its Pause/Resume toggle. Shared by every
 * ruleset that runs a `SegmentTimer` countdown (Score Training, TUOD, 121
 * `_V2`) — reads `remainingLabel()`/`togglePause()`/`$store.game.timerPaused`
 * from the page's own Alpine scope; `disabledExpr` is the only thing that
 * varies per game (which of its own confirm-dialog flags should also block
 * the toggle while open).
 */
interface Props {
  /** Alpine expression evaluating to a boolean; disables both buttons. */
  disabledExpr: string;
}

const { disabledExpr }: Props = Astro.props;

import Button from "@components/forms/Button.astro";

// Icons
import PauseIcon from "@icons/pause.svg";
import PlayIcon from "@icons/play.svg";
---

<div
  class="flex justify-center items-center gap-2 px-3"
  x-show="$store.game.configSnapshot?.durationType === 'MINUTES'"
  x-cloak
>
  <p
    class="text-lg font-bold font-mono text-muted-foreground"
    x-text="remainingLabel()"
  >
  </p>
  <Button
    type="button"
    variant="ghost"
    icon
    ariaLabel="Pause timer"
    :disabled={disabledExpr}
    @click="togglePause()"
    x-show="!$store.game.timerPaused"
    x-cloak
  >
    <PauseIcon
      class="size-5 text-accent"
      slot="iconBefore"
    />
  </Button>
  <Button
    type="button"
    variant="ghost"
    icon
    ariaLabel="Resume timer"
    :disabled={disabledExpr}
    @click="togglePause()"
    x-show="$store.game.timerPaused"
    x-cloak
  >
    <PlayIcon
      class="size-5 text-muted"
      slot="iconBefore"
    />
  </Button>
</div>
