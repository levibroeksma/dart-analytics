---
/**
 * The header's countdown pill for a MINUTES session, placed in
 * `GameLayout`'s `header-end` slot by the four countdown play pages. It
 * shows a pause icon and `remainingLabel()`, and a tap pauses. While paused
 * it stays visible with the remaining time but is disabled ("Timer paused"):
 * resuming is `CountdownResumePrompt`'s job. Reads `remainingLabel()`,
 * `togglePause()`, `hasActiveSession` and `finished` from the play scope,
 * or from `scopeExpr` when the play store is a nullable member of the page
 * scope. A scope with its own pause (the routine page, Quick Subtract)
 * overrides the four reads with `pausedExpr`, `showExpr`, `labelExpr` and
 * `toggleExpr`.
 */
interface Props {
  /** Alpine expression evaluating to a boolean; disables the pill. */
  disabledExpr: string;
  /** Alpine expression for a nullable play store; hidden while it is null. */
  scopeExpr?: string;
  /** Alpine expression: whether the timer is paused. */
  pausedExpr?: string;
  /** Alpine expression: whether the pill shows. */
  showExpr?: string;
  /** Alpine expression: the pill's clock text. */
  labelExpr?: string;
  /** Alpine expression: the pause toggle call. */
  toggleExpr?: string;
}

// Props
const {
  disabledExpr,
  scopeExpr,
  pausedExpr = "$store.game.timerPaused",
  showExpr,
  labelExpr,
  toggleExpr,
}: Props = Astro.props;

// Data
const scope = scopeExpr ? `${scopeExpr}?.` : "";
const shown =
  showExpr ??
  `${scope}hasActiveSession && !${scope}finished && $store.game.configSnapshot?.durationType === 'MINUTES'`;
const label = labelExpr ?? `${scope}remainingLabel()`;
const toggle = toggleExpr ?? `${scope}togglePause()`;

// Components
import Button from "@components/forms/Button.astro";

// Icons
import PauseIcon from "@icons/pause.svg";
---

<Button
  type="button"
  variant="sheet-muted"
  loadingExpr="false"
  class="h-11 shrink-0 gap-1.5 rounded-full px-3 py-0 font-mono text-body-sm font-medium text-foreground"
  :aria-label={`${pausedExpr} ? 'Timer paused' : 'Pause timer'`}
  :disabled={`(${disabledExpr}) || ${pausedExpr}`}
  @click={toggle}
  x-show={shown}
  x-cloak
>
  <PauseIcon
    slot="iconBefore"
    class="size-3"
  />
  <span x-text={label}></span>
</Button>
