---
/**
 * The header's countdown pill for a MINUTES session, placed in
 * `GameLayout`'s `header-end` slot by the four countdown play pages. It
 * shows a pause icon and `remainingLabel()`, and a tap pauses. While paused
 * it stays visible with the remaining time but is disabled ("Timer paused"):
 * resuming is `CountdownResumePrompt`'s job. Reads `remainingLabel()`,
 * `togglePause()`, `hasActiveSession` and `finished` from the play scope,
 * or from `scopeExpr` when the play store is a nullable member of the page
 * scope (the routine page's `game` step).
 */
interface Props {
  /** Alpine expression evaluating to a boolean; disables the pill. */
  disabledExpr: string;
  /** Alpine expression for a nullable play store; hidden while it is null. */
  scopeExpr?: string;
}

// Props
const { disabledExpr, scopeExpr }: Props = Astro.props;

// Data
const scope = scopeExpr ? `${scopeExpr}?.` : "";

// Components
import Button from "@components/forms/Button.astro";

// Icons
import PauseIcon from "@icons/pause.svg";
---

<Button
  type="button"
  variant="sheet-muted"
  loadingExpr="false"
  class="h-11 shrink-0 gap-1.5 rounded-full px-3 py-0 font-mono text-body-sm font-medium text-foreground"
  :aria-label="$store.game.timerPaused ? 'Timer paused' : 'Pause timer'"
  :disabled={`(${disabledExpr}) || $store.game.timerPaused`}
  @click={`${scope}togglePause()`}
  x-show={`${scope}hasActiveSession && !${scope}finished && $store.game.configSnapshot?.durationType === 'MINUTES'`}
  x-cloak
>
  <PauseIcon
    slot="iconBefore"
    class="size-3"
  />
  <span x-text={`${scope}remainingLabel()`}></span>
</Button>
