---
/**
 * Play screen for the round-target games (Baseball, Shanghai): the seat shell
 * with the running score, a round tile then the `Target` tile, the target as
 * the waiting seat's stat, `VisitPreview` and the singles tap input.
 * @param {object} roundLabel `{ label, key }` — the round tile's label and the
 *   state key its value reads
 */
interface Props {
  roundLabel: { label: string; key: string };
  [key: string]: unknown;
}

// Props
const { roundLabel, ...props }: Props = Astro.props;

// Components
import SeatedPlayScreen from "@components/layout/games/SeatedPlayScreen.astro";
import VisitPreview from "@components/layout/games/VisitPreview.astro";
import SinglesRecreationalInput from "@components/layout/games/SinglesRecreationalInput.astro";
---

<SeatedPlayScreen
  big={{ isTarget: false, value: (c) => c("currentScore") }}
  tiles={[
    { label: roundLabel.label, value: (c) => c(roundLabel.key) },
    { label: "Target", value: (c) => c("currentTargetLabel") },
  ]}
  idle={{ label: "Target", value: (c) => c("currentTargetLabel") }}
  {...props}
>
  <VisitPreview />

  <SinglesRecreationalInput
    x-show="$store.game.inputModeKey !== 'VISUAL_BOARD'"
    x-cloak
  />
</SeatedPlayScreen>
