---
/**
 * Presentational — parent play page owns `showDoubleConfirm` (x-show).
 * Three-action footer (Cancel / Bust-miss / Yes) on the `Modal` shell:
 * `ConfirmDialog` only supports two actions, and 501 needs a safe way to back
 * out of a mistyped score in addition to the win/bust choice.
 */

// Components
import Modal from "@components/ui/Modal.astro";
import Button from "@components/forms/Button.astro";
---

<Modal
  titleId="double-confirm-title"
  descriptionId="double-confirm-desc"
  dismissible={false}
>
  <h2
    id="double-confirm-title"
    class="text-lg font-semibold text-foreground"
  >
    Finished on a double?
  </h2>
  <p
    id="double-confirm-desc"
    class="mt-2 text-sm text-muted-foreground"
  >
    Confirm the last dart landed in a double, or the visit is recorded as a
    bust.
  </p>

  <div
    slot="footer"
    class="mt-6 flex flex-col gap-3"
  >
    <Button
      variant="primary"
      title="Yes"
      @click="confirmDouble()"
    />
    <div class="flex gap-3">
      <Button
        variant="secondary"
        class="flex-1"
        title="Bust / miss"
        @click="denyDouble()"
      />
      <Button
        variant="ghost"
        class="flex-1"
        title="Cancel"
        @click="cancelCheckout()"
      />
    </div>
  </div>
</Modal>
