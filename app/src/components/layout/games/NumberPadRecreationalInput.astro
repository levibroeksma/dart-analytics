---
/**
 * Shared number-pad input (Follow the Leader, Killer). Row 1: `RingKeyRow`.
 * Row 2: the numbers 1–20 on a five-column grid. The bottom row is the
 * default slot, filled by each game with its own grid. Reads `ring` and
 * `finished` from the surrounding play scope.
 * @param {string} class Root classes, per game
 */
interface Props {
  class: string;
  [key: string]: unknown;
}

// Props
const { class: classNameProp, ...props }: Props = Astro.props;

// Components
import InputButton from "./InputButton.astro";
import RingKeyRow from "./RingKeyRow.astro";

// Lib
import { cn } from "@client/cn";

// Styles
const className = cn(classNameProp);
---

<div
  class={className}
  {...props}
>
  <RingKeyRow />
  <div class="grid min-h-0 flex-4 auto-rows-fr grid-cols-5 gap-2">
    <template
      x-for="n in 20"
      :key="n"
    >
      <InputButton
        class="text-2xl"
        :disabled="finished"
        @click="recordNumber(n)"
        x-text="n"
      />
    </template>
  </div>
  <slot />
</div>
