---
/**
 * Inlay stat tile — eyebrow label over value. With `skeletonWidth` the value
 * pulses until results are saved.
 * @param {string} labelExpr Alpine expression for the label
 * @param {string} valueExpr Alpine expression for the value
 * @param {string} [skeletonWidth] Width class for the value's pulse bar
 */
interface Props {
  labelExpr: string;
  valueExpr: string;
  skeletonWidth?: string;
}

// Props
const { labelExpr, valueExpr, skeletonWidth }: Props = Astro.props;

// Components
import ResultValue from "@components/layout/games/ResultValue.astro";
---

<div class="inset-well flex min-w-0 flex-col gap-2 rounded-inlay px-3 py-3.5">
  <dt
    class="truncate font-mono text-stat-label font-semibold uppercase text-muted-foreground"
    x-text={labelExpr}
  >
  </dt>
  {
    skeletonWidth ? (
      <dd class="text-lg/tight">
        <ResultValue
          class="font-display text-lg/tight tabular-nums text-foreground"
          valueExpr={valueExpr}
          skeletonWidth={skeletonWidth}
        />
      </dd>
    ) : (
      <dd
        class="font-display text-lg/tight tabular-nums text-foreground"
        x-text={valueExpr}
      />
    )
  }
</div>
