---
/**
 * Mickey Mouse's tap input in an `input-well`. Row 1: `RingKeyRow`.
 * Row 2: `tapTargets()` and MISS — four columns on a single (20–12, Bull),
 * seven once D or T is armed and 11…1 join. Target labels are 24px on four
 * columns and 16px on seven, so BULL and MISS fit the narrow keys. Treble
 * cannot apply to the bull, so BULL is disabled while T is armed.
 */
interface Props {
  [key: string]: unknown;
}

// Props
const { ...props }: Props = Astro.props;

// Components
import TargetTapRecreationalInput from "./TargetTapRecreationalInput.astro";
---

<TargetTapRecreationalInput {...props} />
