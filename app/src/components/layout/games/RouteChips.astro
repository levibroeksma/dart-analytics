---
/**
 * Checkout route as a 28px `inset-well` pill: the route's parts in mono,
 * separated by 3px dots. Hidden while the route is blank.
 * @param {string} routeExpr Alpine expression for the route string ("T20 9 D16")
 * @param {string} [currentExpr] Alpine expression for the current part; that part is lit (`accent-bright`), the rest dimmed
 */
interface Props {
  routeExpr: string;
  currentExpr?: string;
}

// Lib
import { cn } from "@client/cn";

// Props
const { routeExpr, currentExpr }: Props = Astro.props;

// Current-part highlight
const partAttrs = currentExpr
  ? {
      ":class": `part === (${currentExpr}) ? 'text-accent-bright' : 'text-faint-foreground'`,
    }
  : {};
const partClass = cn(
  "font-mono text-body-sm",
  !currentExpr && "text-soft-foreground",
);
---

<div
  class="inset-well flex h-7 items-center gap-2 rounded-full px-3"
  x-show={routeExpr}
  x-cloak
>
  <template
    x-for={`(part, index) in (${routeExpr}).split(' ').filter(Boolean)`}
    :key="index"
  >
    <span class="flex items-center gap-2">
      <span
        class="size-0.75 rounded-full bg-faint-foreground"
        aria-hidden="true"
        x-show="index > 0"
        x-cloak
      ></span>
      <span
        class={partClass}
        {...partAttrs}
        x-text="part"
      ></span>
    </span>
  </template>
</div>
