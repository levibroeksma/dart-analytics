---
import ScoreAverageCard from "./ScoreAverageCard.astro";
import ScoreTrendSection from "./ScoreTrendSection.astro";
import GameHeatmapSection from "./GameHeatmapSection.astro";
import GameCompletionSection from "./GameCompletionSection.astro";
import GameSessionList from "./GameSessionList.astro";
---

<div
  class="flex flex-col gap-2"
  x-data="scoreTrendSection()"
>
  <div class="grid grid-cols-2 gap-2">
    <ScoreAverageCard
      label="3-dart average"
      averageExpr="averages.threeDart"
      deltaExpr="threeDartDeltaPercent"
    />
    <ScoreAverageCard
      label="First nine"
      averageExpr="averages.firstNine"
      deltaExpr="firstNineDeltaPercent"
    />
    <ScoreAverageCard
      label="Personal best"
      averageExpr="personalBestAverage"
      subtextExpr="personalBestDate"
      loadingExpr="personalBestLoading"
    />
    <GameCompletionSection />
  </div>
  <ScoreTrendSection />
  <GameHeatmapSection />
  <GameSessionList />
</div>
