---
/**
 * The Doubles Training statistics layout: the completion tile, the doubles
 * card over the page period (hit rate, miss direction, wire band and near
 * misses per double), then the heatmap and the session list.
 */
import { NEAR_MISS_MM } from "@lib/stats/constants";
import AimCardSection from "./AimCardSection.astro";
import GameCompletionSection from "./GameCompletionSection.astro";
import GameHeatmapSection from "./GameHeatmapSection.astro";
import GameSessionList from "./GameSessionList.astro";
---

<div class="flex flex-col gap-2">
  <div class="grid grid-cols-2 gap-2">
    <GameCompletionSection />
  </div>
  <AimCardSection
    factory="doublesTrainingCardSection"
    title="DOUBLES"
    titleId="doubles-training-card-title"
    headers={[
      "Double",
      "Hit",
      "Left/Right",
      "High/Low",
      "In/Within/Out",
      "Near/Loose",
    ]}
    footerExpr={`\`\${card.darts} double darts · near miss within ${NEAR_MISS_MM} mm\``}
  />
  <GameHeatmapSection />
  <GameSessionList />
</div>
