---
/**
 * The Track games statistics layout: the completion tile, the Track targets
 * card (tiles and the sortable per-target table), then the heatmap and the
 * session list.
 */
import GameCompletionSection from "./GameCompletionSection.astro";
import GameHeatmapSection from "./GameHeatmapSection.astro";
import GameSessionList from "./GameSessionList.astro";
import TrackTargetsCard from "./TrackTargetsCard.astro";
---

<div class="flex flex-col gap-2">
  <div class="grid grid-cols-2 gap-2">
    <GameCompletionSection />
  </div>
  <TrackTargetsCard />
  <GameHeatmapSection />
  <GameSessionList />
</div>
