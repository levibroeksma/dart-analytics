---
/**
 * Heatmap section: where darts landed over the page-level game and period (optionally for one target),
 * drawn as a density layer on the board. Owns its fetch through
 * `gameHeatmapSection()`. The glass surface is a sibling layer, not an
 * ancestor, for the same reason as `ScoreTrendSection.astro`. While loading,
 * the bare board pulses in the heatmap's place at the same size.
 */
import Select from "@components/forms/Select.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import StatsDensityHeatmap from "@components/ui/StatsDensityHeatmap.astro";
import DartBoard from "@components/ui/DartBoard.astro";
---

<section
  class="relative"
  x-data="gameHeatmapSection()"
>
  <div
    class="glass absolute inset-0 rounded-2xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative space-y-3 p-4">
    <h2 class="text-sm text-foreground">Heatmap</h2>
    <div
      x-show="targetOptions.length"
      x-cloak
    >
      <Select
        optionsExpr="targetOptions"
        model="target"
        ariaLabel="Heatmap target"
      />
    </div>
    <ErrorAlert
      showExpr="error"
      textExpr="error"
    />
    <div
      class="opacity-30"
      aria-hidden="true"
      x-show="loading"
      x-cloak
    >
      <DartBoard class="mx-auto max-w-64 animate-pulse" />
    </div>
    <div
      class="space-y-3"
      x-show="!loading && !error"
      x-cloak
    >
      <p
        class="text-sm text-muted-foreground"
        x-show="isEmpty"
        x-cloak
      >
        No darts in range.
      </p>
      <div
        x-show="!isEmpty"
        x-cloak
      >
        <StatsDensityHeatmap
          stampsExpr="stamps"
          class="mx-auto max-w-64"
        />
      </div>
    </div>
  </div>
</section>
