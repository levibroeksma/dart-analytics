---
/**
 * The Elimination statistics layout for Killer, Follow the Leader and
 * Prisoner: the completion tile, the game's win rate and three game tiles
 * against the preceding period, the Follow the Leader match rate by bed or
 * the Prisoner dart results card, then the heatmap and the session list.
 */
import AimTableCard from "./AimTableCard.astro";
import ComparisonStatsLayout from "./ComparisonStatsLayout.astro";
---

<ComparisonStatsLayout scope="eliminationSection()">
  <AimTableCard
    title="MATCH RATE BY BED"
    headers={["Bed", "Match rate"]}
    rows="card.beds"
    hideEmpty
  />
  <AimTableCard
    title="DART RESULTS"
    headers={["Result", "Share"]}
    rows="card.results"
    hideEmpty
  />
</ComparisonStatsLayout>
