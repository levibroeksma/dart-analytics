---
/**
 * Square glass stat card: one average with a caption line under it — the percent
 * change against the preceding period, or a plain subtext such as the date a
 * personal best was set. Reads from the enclosing `scoreTrendSection()` scope.
 * @param {string} label Card caption
 * @param {string} averageExpr Alpine expression yielding the average or `null`
 * @param {string} [deltaExpr] Alpine expression yielding the percent delta or `null`
 * @param {string} [subtextExpr] Alpine expression yielding a caption string or `null`; shown instead of the delta
 * @param {string} [loadingExpr] Alpine expression for this card's loading flag (defaults to the section's `loading`)
 */
interface Props {
  label: string;
  averageExpr: string;
  deltaExpr?: string;
  subtextExpr?: string;
  loadingExpr?: string;
}

// Props
const {
  label,
  averageExpr,
  deltaExpr,
  subtextExpr,
  loadingExpr = "loading",
}: Props = Astro.props;

// Data
const value = `${loadingExpr} || ${averageExpr} === null ? '—' : ${averageExpr}.toFixed(1)`;
const showDelta = deltaExpr
  ? `!${loadingExpr} && ${deltaExpr} !== null`
  : "false";
const deltaClass = deltaExpr
  ? `${deltaExpr} >= 0 ? 'text-success' : 'text-error'`
  : "";
const deltaText = deltaExpr
  ? `${deltaExpr} === null ? '' : (${deltaExpr} >= 0 ? '+' : '') + ${deltaExpr}.toFixed(1) + '%'`
  : "''";
const showSubtext = subtextExpr
  ? `!${loadingExpr} && ${subtextExpr} !== null`
  : "false";
const subtext = subtextExpr ? `${subtextExpr} ?? ''` : "''";
---

<div
  class="glass flex aspect-square flex-col items-center justify-center gap-1 rounded-2xl p-3.5 text-center"
>
  <span
    class="font-mono text-3xl font-bold text-accent"
    x-text={value}
  >
  </span>
  <span class="text-sm text-muted-foreground">{label}</span>
  {
    deltaExpr && (
      <span
        class="text-xs"
        x-show={showDelta}
        x-cloak:class={deltaClass}
        x-text={deltaText}
      />
    )
  }
  {
    subtextExpr && (
      <span
        class="text-xs text-muted-foreground"
        x-show={showSubtext}
        x-cloak
        x-text={subtext}
      />
    )
  }
</div>
