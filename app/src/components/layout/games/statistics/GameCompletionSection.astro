---
/**
 * Session-result section of a game's `/statistics` layout: a square doughnut card of completed
 * (green) against abandoned (red) games over the page-level period, filling
 * one cell of the overview's two-column grid. Owns its fetch through `gameCompletionSection()`.
 * Never-started sessions are not shown. The chart is the glass card itself,
 * so no sibling glass layer is needed.
 */
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import Chart from "@components/ui/Chart.astro";
---

<section
  class="w-full"
  x-data="gameCompletionSection()"
>
  <div
    class="glass flex aspect-square flex-col space-y-2 rounded-2xl p-4"
    x-show="loading || error"
    x-cloak
  >
    <h2 class="text-sm text-foreground">Session result</h2>
    <ErrorAlert
      showExpr="error"
      textExpr="error"
    />
    <div
      class="min-h-0 flex-1 animate-pulse rounded-xl bg-muted-foreground/80"
      x-show="loading"
      x-cloak
    >
    </div>
  </div>
  <div
    x-show="!loading && !error"
    x-cloak
  >
    <p
      class="text-sm text-muted-foreground"
      x-show="isEmpty"
      x-cloak
    >
      No finished games in range.
    </p>
    <div
      x-show="!isEmpty"
      x-cloak
    >
      <Chart
        class="flex aspect-square flex-col"
        heightClass="min-h-0 flex-1"
        table={false}
        specExpr="chart"
        title="Session result"
        formatter="integer"
      />
    </div>
  </div>
</section>
