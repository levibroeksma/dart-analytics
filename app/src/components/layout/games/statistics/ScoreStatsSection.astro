---
/**
 * Score Training stat section: a glass card of labelled values over the
 * page-level period. Owns its fetch through the named Alpine factory, whose
 * scope exposes `loading`, `error` and `summary`. The glass surface is a
 * sibling layer, not an ancestor, for the same reason as
 * `ScoreTrendSection.astro`.
 * @param {string} factory Alpine data factory to mount (e.g. `scoreVolumeSection`)
 * @param {string} title Section heading
 * @param {{ label: string; expr: string }[]} stats Tiles; `expr` is an Alpine expression yielding the displayed text
 * @slot default Footnote under the tiles, shown once loaded
 */
interface Props {
  factory: string;
  title: string;
  stats: { label: string; expr: string }[];
}

// Props
const { factory, title, stats }: Props = Astro.props;

// Components
import ErrorAlert from "@components/ui/ErrorAlert.astro";
---

<section
  class="relative"
  x-data={`${factory}()`}
>
  <div
    class="glass absolute inset-0 rounded-2xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative space-y-3 p-4">
    <h2 class="text-sm text-foreground">{title}</h2>
    <ErrorAlert
      showExpr="error"
      textExpr="error"
    />
    <div
      class="grid grid-cols-3 gap-2 text-center text-sm text-muted-foreground"
    >
      {
        stats.map((stat) => (
          <div>
            <span
              class="block text-lg text-foreground"
              x-text={`loading || error ? '—' : ${stat.expr}`}
            />
            {stat.label}
          </div>
        ))
      }
    </div>
    <div
      x-show="!loading && !error"
      x-cloak
    >
      <slot />
    </div>
  </div>
</section>
