---
/**
 * Score Training score-trend section: the trend chart. Reads the enclosing
 * `scoreTrendSection()` scope, which fetches for the page-level `rangeKey`.
 * The glass surface is a sibling layer, not an ancestor: a `backdrop-filter`
 * nested inside another one blurs nothing.
 */
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import Chart from "@components/ui/Chart.astro";
---

<section class="relative">
  <div
    class="glass absolute inset-0 rounded-2xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative space-y-3 p-4">
    <h2 class="text-sm text-foreground">Score trend</h2>
    <ErrorAlert
      showExpr="error"
      textExpr="error"
    />
    <div
      class="space-y-2"
      x-show="loading"
      x-cloak
    >
      <div class="h-48 animate-pulse rounded bg-muted-foreground/80"></div>
    </div>
    <div
      class="space-y-3"
      x-show="!loading && !error"
      x-cloak
    >
      <p
        class="text-sm text-muted-foreground"
        x-show="isEmpty"
        x-cloak
      >
        No sessions in range.
      </p>
      <div
        x-show="!isEmpty"
        x-cloak
      >
        <Chart
          flat
          table={false}
          specExpr="chart"
          formatter="one-decimal"
        />
      </div>
    </div>
  </div>
</section>
