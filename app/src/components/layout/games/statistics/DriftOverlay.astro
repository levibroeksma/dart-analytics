---
/**
 * Aim drift overlay: mean offset and spread for each dart of the visit, then
 * per basis, then the ambiguous-dart count. Reads the enclosing
 * `driftCardSection()` scope.
 */
---

<table class="w-full text-caption">
  <thead>
    <tr class="text-left font-mono text-eyebrow text-muted-foreground">
      <th scope="col">Dart</th>
      <th scope="col">Across</th>
      <th scope="col">Down</th>
      <th scope="col">Spread</th>
    </tr>
  </thead>
  <tbody>
    <template
      x-for="row in table"
      :key="row.label"
    >
      <tr>
        <th
          scope="row"
          class="text-left font-mono"
          x-text="`${row.label} (${row.n})`"
        >
        </th>
        <template x-for="cell in row.cells">
          <td x-text="cell"></td>
        </template>
      </tr>
    </template>
  </tbody>
</table>
<p
  class="text-caption text-muted"
  x-text="`${card.ambiguous} ambiguous darts · ${card.n} 1st-dart samples. Across: negative is left. Down: positive is low.`"
>
</p>
