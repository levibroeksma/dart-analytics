---
/**
 * The 501 statistics layout: averages row, tiles row, then the heatmap and the
 * session list. One `x01Overview()` scope feeds the first two rows; the
 * heatmap and the session list own their fetches. Completion is not shown on
 * 501 (spec `2026-11-14-x01-statistics-page-design.md`).
 */
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import X01AveragesRow from "./X01AveragesRow.astro";
import X01TilesRow from "./X01TilesRow.astro";
import AimCardSection from "./AimCardSection.astro";
import X01DataQualityLine from "./X01DataQualityLine.astro";
import GameHeatmapSection from "./GameHeatmapSection.astro";
import GameSessionList from "./GameSessionList.astro";
---

<div class="flex flex-col gap-2">
  <div
    class="flex flex-col gap-2"
    x-data="x01Overview()"
  >
    <ErrorAlert
      showExpr="error"
      textExpr="error"
    />
    <X01AveragesRow />
    <X01TilesRow />
  </div>
  <X01DataQualityLine />
  <AimCardSection
    factory="trebleCardSection"
    title="TREBLE ACCURACY"
    titleId="treble-card-title"
    headers={["Aim", "Treble", "Single", "Left", "Right", "Other"]}
    footerExpr="`${card.ambiguous} ambiguous darts · ${card.darts} T20 darts`"
  />
  <AimCardSection
    factory="driftCardSection"
    title="AIM DRIFT"
    titleId="drift-card-title"
    headers={["Dart", "Across", "Down", "Spread"]}
    footerExpr="`${card.ambiguous} ambiguous darts · ${card.n} 1st-dart samples. Across: negative is left. Down: positive is low.`"
  />
  <AimCardSection
    factory="doublesCardSection"
    title="DOUBLES"
    titleId="doubles-card-title"
    headers={["Double", "Hit", "Misses in/within/out", "Miss sectors 0-7"]}
    footerExpr="`${card.ambiguous} ambiguous darts · ${card.darts} double darts`"
  />
  <AimCardSection
    factory="preferenceCardSection"
    title="DOUBLE PREFERENCE"
    titleId="preference-card-title"
    headers={["Double", "Split away", "Split rate", "Hits/attempts"]}
    footerExpr="`${card.ambiguous} ambiguous darts · ${card.left} visits left on a double`"
  />
  <AimCardSection
    factory="setupCardSection"
    title="SETUP"
    titleId="setup-card-title"
    headers={["Basis · aim", "Hit", "Hits/attempts"]}
    footerExpr="`${card.ambiguous} ambiguous darts · ${card.attempts} setup darts`"
  />
  <GameHeatmapSection />
  <GameSessionList />
</div>
