---
/**
 * Score Training session-list section: the sessions of the page-level period,
 * newest first, each linking to its replay. Owns its fetch through
 * `scoreSessionList()`. The glass surface is a sibling layer, not an
 * ancestor, for the same reason as `ScoreTrendSection.astro`.
 */
import Button from "@components/forms/Button.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
---

<section
  class="relative"
  x-data="scoreSessionList()"
>
  <div
    class="glass absolute inset-0 rounded-2xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative space-y-3 p-4">
    <h2 class="text-sm text-foreground">Sessions</h2>
    <ErrorAlert
      showExpr="error"
      textExpr="error"
    />
    <div
      class="space-y-2"
      x-show="loading"
      x-cloak
    >
      <div class="h-10 animate-pulse rounded bg-muted-foreground/80"></div>
      <div class="h-10 animate-pulse rounded bg-muted-foreground/80"></div>
    </div>
    <div
      class="space-y-2"
      x-show="!loading"
      x-cloak
    >
      <p
        class="text-sm text-muted-foreground"
        x-show="isEmpty && !error"
        x-cloak
      >
        No sessions in range.
      </p>
      <template
        x-for="row in rows"
        :key="row.id"
      >
        <a
          class="flex items-center justify-between gap-2 text-sm text-foreground no-underline hover:text-accent-hover"
          :href="row.href"
        >
          <span x-text="row.date"></span>
          <span
            class="text-muted-foreground"
            x-text="`${row.average === null ? '—' : row.average.toFixed(1)} avg · ${row.darts} darts · ${row.minutes} min`"
          >
          </span>
          <span
            class="text-xs text-error"
            x-show="row.abandoned"
            x-cloak
          >
            Abandoned
          </span>
        </a>
      </template>
      <div
        x-show="hasMore"
        x-cloak
      >
        <Button
          variant="secondary"
          title="Load more"
          loadingExpr="loadingMore"
          @click="loadMore()"
        />
      </div>
    </div>
  </div>
</section>
