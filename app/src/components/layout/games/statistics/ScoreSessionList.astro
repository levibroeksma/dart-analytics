---
/**
 * Score Training replay section: the completed sessions of the page-level
 * period, newest first, 10 per page, each a card linking to its replay. Owns
 * its fetch through `scoreSessionList()`. The glass surface is a sibling
 * layer, not an ancestor; the cards keep their own glass.
 */
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import Pagination from "@components/ui/Pagination.astro";
import ReplayCard from "@components/layout/statistics/ReplayCard.astro";
---

<section
  class="relative"
  x-data="scoreSessionList()"
>
  <div
    class="glass absolute inset-0 rounded-2xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative space-y-2 p-4">
    <h2 class="text-sm text-foreground">Replay</h2>
    <ErrorAlert
      showExpr="error"
      textExpr="error"
    />
    <div
      class="space-y-2"
      x-show="loading"
      x-cloak
    >
      <div class="h-16 animate-pulse rounded-2xl bg-muted-foreground/80"></div>
      <div class="h-16 animate-pulse rounded-2xl bg-muted-foreground/80"></div>
    </div>
    <div
      class="space-y-2"
      x-show="!loading"
      x-cloak
    >
      <p
        class="text-sm text-muted-foreground"
        x-show="isEmpty && !error"
        x-cloak
      >
        No completed games in range.
      </p>
      <template
        x-for="row in rows"
        :key="row.id"
      >
        <ReplayCard
          hrefExpr="row.href"
          titleExpr="row.date"
          captionExpr="`${row.average === null ? '—' : row.average.toFixed(1)} avg · ${row.darts} darts · ${row.minutes} min`"
        />
      </template>
      <Pagination
        x-show="hasPrevious || hasNext"
        x-cloak
        pageExpr="pageNumber"
        totalExpr="totalPages"
        hasPreviousExpr="hasPrevious"
        hasNextExpr="hasNext"
        onPrevious="previous()"
        onNext="next()"
        disabledExpr="loading"
      />
    </div>
  </div>
</section>
