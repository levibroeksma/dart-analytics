---
/**
 * Score Training replay section: the completed sessions of the page-level
 * period, newest first, 10 per page, each a card linking to its replay. Owns
 * its fetch through `scoreSessionList()`.
 */
import Button from "@components/forms/Button.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import ScoreReplayCard from "./ScoreReplayCard.astro";
---

<section
  class="space-y-2"
  x-data="scoreSessionList()"
>
  <h2 class="text-sm text-foreground">Replay</h2>
  <ErrorAlert
    showExpr="error"
    textExpr="error"
  />
  <div
    class="space-y-2"
    x-show="loading"
    x-cloak
  >
    <div class="h-16 animate-pulse rounded-2xl bg-muted-foreground/80"></div>
    <div class="h-16 animate-pulse rounded-2xl bg-muted-foreground/80"></div>
  </div>
  <div
    class="space-y-2"
    x-show="!loading"
    x-cloak
  >
    <p
      class="text-sm text-muted-foreground"
      x-show="isEmpty && !error"
      x-cloak
    >
      No completed games in range.
    </p>
    <template
      x-for="row in rows"
      :key="row.id"
    >
      <ScoreReplayCard />
    </template>
    <div
      class="flex items-center justify-between gap-2"
      x-show="hasPrevious || hasNext"
      x-cloak
    >
      <Button
        variant="secondary"
        title="Previous"
        :disabled="!hasPrevious"
        @click="previous()"
      />
      <span
        class="text-xs text-muted-foreground"
        x-text="pageLabel"
      >
      </span>
      <Button
        variant="secondary"
        title="Next"
        :disabled="!hasNext"
        @click="next()"
      />
    </div>
  </div>
</section>
