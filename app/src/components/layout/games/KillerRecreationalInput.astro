---
/**
 * Killer's tap input in an `input-well`. Row 1: `RingKeyRow`.
 * Row 2: the numbers 1–20 on a five-column grid. Row 3: BULL and MISS on a
 * two-column grid. Treble cannot apply to the bull, so BULL is disabled
 * while T is armed.
 */
interface Props {
  [key: string]: unknown;
}

// Props
const { ...props }: Props = Astro.props;

// Components
import InputButton from "./InputButton.astro";
import RingKeyRow from "./RingKeyRow.astro";
---

<div
  class="input-well flex flex-col"
  {...props}
>
  <RingKeyRow />
  <div class="grid min-h-0 flex-4 auto-rows-fr grid-cols-5 gap-2">
    <template
      x-for="n in 20"
      :key="n"
    >
      <InputButton
        class="text-2xl"
        :disabled="finished"
        @click="recordNumber(n)"
        x-text="n"
      />
    </template>
  </div>
  <div class="grid min-h-0 flex-1 grid-cols-2 gap-2">
    <InputButton
      class="text-2xl uppercase"
      :disabled="finished || ring === 'TREBLE'"
      @click="recordBull()"
    >
      BULL
    </InputButton>
    <InputButton
      class="text-2xl text-soft-foreground"
      :disabled="finished"
      @click="recordMiss()"
    >
      MISS
    </InputButton>
  </div>
</div>
