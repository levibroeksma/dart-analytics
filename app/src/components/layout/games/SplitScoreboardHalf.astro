---
/**
 * One seat card inside `SplitScoreboard`; seats keep their order. The card
 * lays out two layers at once and cross-fades them: while `activeExpr`
 * holds it grows to fill the band under the `glass-active-seat` glow and
 * shows the panel (name, `LegBars`, the score at `seatValueSize`, the route
 * chips, compact stat rows right of a hairline); otherwise it is a 64px
 * `glass` bar (name over `LegBars`, the muted score, one stat tile). Name
 * and score are `data-seat-twin`s that `seatMorph()` glides between layers;
 * a falling score counts down (`scoreTween`).
 * @param {string} nameExpr Alpine expr for the seat's display name
 * @param {string} activeExpr Alpine expr, true while this seat throws
 * @param {string} scoreExpr Alpine expr for the score
 * @param {string} idleStatExpr Alpine expr for the idle row's stat value
 * @param {string} idleStatLabel The idle row's stat label
 * @param {string} [legsExpr] Alpine expr for legs won; shown with `legsToWinExpr`
 * @param {string} [legsToWinExpr] Alpine expr for the leg target; omit to hide `LegBars`
 * @param {string} [checkoutExpr] Alpine expr for the route ("T20 9 D16"); omit to hide the chips
 * @slot default The active card's compact `PlayStatTile` rows
 */
interface Props {
  nameExpr: string;
  activeExpr: string;
  scoreExpr: string;
  idleStatExpr: string;
  idleStatLabel: string;
  legsExpr?: string;
  legsToWinExpr?: string;
  checkoutExpr?: string;
}

// Props
const {
  nameExpr,
  activeExpr,
  scoreExpr,
  idleStatExpr,
  idleStatLabel,
  legsExpr,
  legsToWinExpr,
  checkoutExpr,
}: Props = Astro.props;

// Components
import LegBars from "./LegBars.astro";
import RouteChips from "./RouteChips.astro";
---

<div
  data-seat-card
  class="glass relative min-h-0 overflow-hidden rounded-key"
  :class={`(${activeExpr}) ? 'flex-1' : 'h-16 shrink-0'`}
>
  <div
    class="glass-active-seat seat-glow pointer-events-none absolute inset-0 rounded-key"
    :class={`(${activeExpr}) ? 'opacity-100' : 'opacity-0'`}
    aria-hidden="true"
  >
  </div>
  <div
    class="seat-panel relative grid min-h-0 grid-cols-scoreboard grid-rows-1 px-4.5 py-4"
    :class={`(${activeExpr}) ? 'opacity-100 seat-layer-in' : 'opacity-0 seat-layer-out'`}
    :data-seat-visible={`String(!!(${activeExpr}))`}
    :inert={`!(${activeExpr})`}
  >
    <div class="@container flex min-w-0 flex-col justify-center gap-2">
      <div
        class="flex min-w-0 flex-col gap-2"
        data-seat-twin="name"
      >
        <span
          class="truncate text-sm font-semibold text-accent-bright"
          x-text={nameExpr}
        ></span>
        {
          legsExpr && legsToWinExpr && (
            <LegBars
              wonExpr={legsExpr}
              toWinExpr={legsToWinExpr}
            />
          )
        }
      </div>
      <p
        class="self-start whitespace-nowrap font-display leading-none tabular-nums text-foreground text-shadow-glow"
        :class={`$seatValueSize(${scoreExpr})`}
        data-seat-twin="score"
        x-data={`scoreTween(() => ${scoreExpr})`}
        x-text="display"
      >
      </p>
      {
        checkoutExpr && (
          <div class="self-start">
            <RouteChips routeExpr={checkoutExpr} />
          </div>
        )
      }
    </div>
    <div
      class="flex min-h-0 min-w-0 flex-col justify-center gap-2 border-l border-white/8 pl-3"
    >
      <slot />
    </div>
  </div>
  <div
    class="absolute inset-x-0 top-0 flex h-16 items-center gap-3 pr-2.5 pl-4"
    :class={`(${activeExpr}) ? 'opacity-0 seat-layer-out' : 'opacity-100 seat-layer-in'`}
    :data-seat-visible={`String(!(${activeExpr}))`}
    :inert={`!!(${activeExpr})`}
  >
    <div
      class="flex min-w-0 flex-col gap-1.5"
      data-seat-twin="name"
    >
      <span
        class="truncate text-sm font-semibold text-muted"
        x-text={nameExpr}
      ></span>
      {
        legsExpr && legsToWinExpr && (
          <LegBars
            wonExpr={legsExpr}
            toWinExpr={legsToWinExpr}
          />
        )
      }
    </div>
    <span
      class="ml-auto font-display text-2xl tabular-nums text-muted"
      data-seat-twin="score"
      x-data={`scoreTween(() => ${scoreExpr})`}
      x-text="display"
    ></span>
    <div
      class="inset-well flex h-11 w-20 shrink-0 flex-col items-center justify-center rounded-row"
    >
      <span
        class="font-mono text-body-sm tabular-nums text-foreground"
        x-text={idleStatExpr}
      ></span>
      <span
        class="font-mono text-eyebrow-sm font-semibold uppercase text-muted"
      >
        {idleStatLabel}
      </span>
    </div>
  </div>
</div>
