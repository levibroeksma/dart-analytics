---
import ResultsModalShell from "@components/layout/games/ResultsModalShell.astro";
import ComparisonSummary from "@components/layout/games/ComparisonSummary.astro";
import OutOrderRow from "@components/layout/games/OutOrderRow.astro";

const STAT_ROWS = [
  { label: "Lives left", key: "livesLeft", hero: true, skeletonWidth: "w-8" },
] as const;

const WINNER_EXPR =
  "resultsSnapshot?.seats?.findIndex((seat) => seat.sideKey === resultsSnapshot?.winningSideKey) ?? -1";
---

<ResultsModalShell overline="Follow the Leader · Summary">
  <h2
    slot="title"
    id="results-title"
    class="text-balance font-display text-xl text-foreground"
    x-text="resultsTitle()"
  >
  </h2>

  <ComparisonSummary
    statRows={STAT_ROWS}
    winnerExpr={WINNER_EXPR}
  />
  <OutOrderRow />
</ResultsModalShell>
