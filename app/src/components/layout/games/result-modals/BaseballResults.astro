---
import ResultsModalShell from "@components/layout/games/ResultsModalShell.astro";
import SinglePlayerSummary from "@components/layout/games/SinglePlayerSummary.astro";
import ComparisonSummary from "@components/layout/games/ComparisonSummary.astro";
import TargetGrid from "@components/layout/games/TargetGrid.astro";

const STAT_ROWS = [
  { label: "Runs", key: "runs", hero: true, skeletonWidth: "w-30" },
  { label: "Accuracy", key: "accuracy", side: true, skeletonWidth: "w-11" },
  {
    label: "Best inning",
    key: "bestInning",
    side: true,
    skeletonWidth: "w-6",
    fallback: "'—'",
  },
] as const;

const WINNER_EXPR =
  "resultsSnapshot?.seats?.findIndex((seat) => seat.sideKey === resultsSnapshot?.winningSideKey) ?? -1";

const INNING_LABELS = ["1", "2", "3", "4", "5", "6", "7", "8", "9"] as const;
---

<ResultsModalShell overline="Baseball Darts · Summary">
  <h2
    slot="title"
    id="results-title"
    class="text-balance font-display text-xl text-foreground"
    x-text="resultsTitle()"
  >
  </h2>

  <SinglePlayerSummary statRows={STAT_ROWS}>
    <TargetGrid
      title="Runs per inning"
      labels={INNING_LABELS}
      valuesExpr="resultsSnapshot?.seats?.[0]?.runsPerInning"
      cols={3}
    />
  </SinglePlayerSummary>
  <ComparisonSummary
    statRows={STAT_ROWS}
    winnerExpr={WINNER_EXPR}
  />
  <div
    class="flex w-full flex-col gap-4"
    x-show="$store.game.seats.length === 2"
    x-cloak
  >
    <TargetGrid
      title="Runs per inning · seat 1"
      labels={INNING_LABELS}
      valuesExpr="resultsSnapshot?.seats?.[0]?.runsPerInning"
      cols={3}
    />
    <TargetGrid
      title="Runs per inning · seat 2"
      labels={INNING_LABELS}
      valuesExpr="resultsSnapshot?.seats?.[1]?.runsPerInning"
      cols={3}
    />
  </div>
</ResultsModalShell>
