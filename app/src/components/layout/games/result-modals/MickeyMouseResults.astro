---
import ResultsModalShell from "@components/layout/games/ResultsModalShell.astro";
import DartsToCloseSummary from "@components/layout/games/DartsToCloseSummary.astro";

const STAT_ROWS = [
  { label: "Darts used", key: "darts", hero: true, skeletonWidth: "w-30" },
] as const;

const TARGET_LABELS = [
  "20",
  "19",
  "18",
  "17",
  "16",
  "15",
  "14",
  "13",
  "12",
  "Doubles",
  "Triples",
  "Bull",
] as const;
---

<ResultsModalShell overline="Mickey Mouse · Summary">
  <h2
    slot="title"
    id="results-title"
    class="text-balance font-display text-xl text-foreground"
    x-text="resultsTitle()"
  >
  </h2>

  <DartsToCloseSummary
    statRows={STAT_ROWS}
    targetLabels={TARGET_LABELS}
  />
</ResultsModalShell>
