---
import ResultsModalShell from "@components/layout/games/ResultsModalShell.astro";
import SinglePlayerSummary from "@components/layout/games/SinglePlayerSummary.astro";
import ComparisonSummary from "@components/layout/games/ComparisonSummary.astro";

const STAT_ROWS = [
  { label: "Total", key: "total", hero: true, skeletonWidth: "w-28" },
  {
    label: "3-dart avg",
    key: "threeDartAverage",
    side: true,
    skeletonWidth: "w-18",
  },
  {
    label: "First 9 avg",
    key: "firstNineAverage",
    side: true,
    skeletonWidth: "w-18",
  },
  { label: "Highest", key: "highestScore", side: true, skeletonWidth: "w-11" },
  { label: "100+", key: "hundredPlus", skeletonWidth: "w-6" },
  { label: "120+", key: "oneTwentyPlus", skeletonWidth: "w-6" },
  { label: "140+", key: "oneFortyPlus", skeletonWidth: "w-6" },
  { label: "180s", key: "oneEighties", skeletonWidth: "w-6" },
] as const;
---

<ResultsModalShell overline="Score training · Summary">
  <h2
    slot="title"
    id="results-title"
    class="text-balance font-display text-xl text-foreground"
    x-text="resultsTitle()"
  >
  </h2>

  <SinglePlayerSummary
    statRows={STAT_ROWS}
    heroSize="sm"
    tileCols={4}
  />
  <ComparisonSummary statRows={STAT_ROWS} />
</ResultsModalShell>
