---
import ResultsModalShell from "@components/layout/games/ResultsModalShell.astro";
import SinglePlayerSummary from "@components/layout/games/SinglePlayerSummary.astro";
import ComparisonSummary from "@components/layout/games/ComparisonSummary.astro";

const STAT_ROWS = [
  { label: "3-dart average", key: "threeDartAverage", hero: true },
  { label: "Legs won", key: "legsWon", side: true },
  {
    label: "Checkout",
    key: "checkoutPercentage",
    fallback: "'—'",
    side: true,
  },
  { label: "Best leg", key: "bestLeg" },
  { label: "60+", key: "sixtyPlus" },
  { label: "100+", key: "hundredPlus" },
  { label: "140+", key: "oneFortyPlus" },
] as const;

const COMPARISON_STAT_ROWS = [
  { label: "3 dart avg", key: "threeDartAverage" },
  { label: "Best leg", key: "bestLeg" },
  { label: "Checkout %", key: "checkoutPercentage", fallback: "'—'" },
  { label: "60+", key: "sixtyPlus" },
  { label: "100+", key: "hundredPlus" },
  { label: "140+", key: "oneFortyPlus" },
  { label: "180s", key: "oneEighties" },
] as const;

const WINNER_EXPR =
  "(resultsSnapshot?.seats?.[0]?.legsWon ?? 0) > (resultsSnapshot?.seats?.[1]?.legsWon ?? 0) ? 0 : (resultsSnapshot?.seats?.[1]?.legsWon ?? 0) > (resultsSnapshot?.seats?.[0]?.legsWon ?? 0) ? 1 : -1";
---

<ResultsModalShell overline="501 · Match summary">
  <h2
    slot="title"
    id="results-title"
    class="text-balance font-display text-xl text-foreground"
    x-text="resultsTitle()"
  >
  </h2>

  <SinglePlayerSummary statRows={STAT_ROWS} />
  <ComparisonSummary
    statRows={COMPARISON_STAT_ROWS}
    winnerExpr={WINNER_EXPR}
    legsBars
  />
</ResultsModalShell>
