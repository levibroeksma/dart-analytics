---
// Components
import ResultsModalShell from "@components/layout/games/ResultsModalShell.astro";
import SinglePlayerSummary from "@components/layout/games/SinglePlayerSummary.astro";
import ComparisonSummary from "@components/layout/games/ComparisonSummary.astro";

// Data
const STAT_ROWS = [
  { label: "Turns", key: "turns", hero: true, skeletonWidth: "w-30" },
  { label: "Accuracy", key: "accuracy", side: true, skeletonWidth: "w-11" },
  {
    label: "Darts thrown",
    key: "totalDarts",
    side: true,
    skeletonWidth: "w-7",
  },
] as const;
const REACHED_ROW = {
  label: "Reached",
  key: "targetAtEnd",
  skeletonWidth: "w-6",
} as const;
const TIMED_ROWS = [
  ...STAT_ROWS,
  { label: "Laps", key: "laps", skeletonWidth: "w-6" },
  REACHED_ROW,
] as const;
const LIVES_ROWS = [
  ...STAT_ROWS,
  { label: "Lives left", key: "lives", skeletonWidth: "w-6" },
  REACHED_ROW,
] as const;
---

<ResultsModalShell overline="Around the Clock · Summary">
  <h2
    slot="title"
    id="results-title"
    class="text-balance font-display text-xl text-foreground"
    x-text="resultsTitle()"
  >
  </h2>

  <template x-if="!isTimed() && !hasLives()">
    <div class="contents">
      <SinglePlayerSummary statRows={STAT_ROWS} />
    </div>
  </template>
  <template x-if="hasLives()">
    <div class="contents">
      <SinglePlayerSummary statRows={LIVES_ROWS} />
    </div>
  </template>
  <template x-if="isTimed()">
    <div class="contents">
      <SinglePlayerSummary statRows={TIMED_ROWS} />
    </div>
  </template>
  <template x-if="!hasLives()">
    <div class="contents">
      <ComparisonSummary
        statRows={STAT_ROWS}
        winnerExpr="resultsSnapshot?.seats?.findIndex((seat) => seat.sideKey === resultsSnapshot?.winningSideKey) ?? -1"
      />
    </div>
  </template>
  <template x-if="hasLives()">
    <div class="contents">
      <ComparisonSummary
        statRows={LIVES_ROWS}
        winnerExpr="resultsSnapshot?.seats?.findIndex((seat) => seat.sideKey === resultsSnapshot?.winningSideKey) ?? -1"
      />
    </div>
  </template>
</ResultsModalShell>
