---
/**
 * Shared chrome for every game's results sheet: `Modal` shell,
 * save-status region (SAVING…/SAVED, failed + retry), play-again error,
 * and the back/rematch button row. Rematch on a two-seat game opens the
 * who-throws-first `StarterStep` first (`requestPlayAgain`). The title is the
 * game's `resultsTitle()`, held as a pulse bar until the save succeeds so a
 * fallback never flashes before the outcome is known; each game supplies its
 * own stat rows (default slot).
 * @param {string} [overline] Eyebrow above the title
 */
interface Props {
  overline?: string;
}

// Props
const { overline }: Props = Astro.props;

// Components
import Button from "@components/forms/Button.astro";
import SaveStatus from "@components/layout/games/SaveStatus.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import Modal from "@components/ui/Modal.astro";
import StarterStep from "@components/layout/games/StarterStep.astro";
import ResultValue from "@components/layout/games/ResultValue.astro";
import SheetActions from "@components/ui/SheetActions.astro";
---

<div
  x-show="finished"
  x-cloak
>
  <Modal
    titleId="results-title"
    dismissible={false}
    overline={overline}
  >
    <h2
      slot="header"
      id="results-title"
      class="text-balance font-display text-xl text-foreground"
    >
      <ResultValue
        valueExpr="resultsTitle()"
        skeletonWidth="w-40"
      />
    </h2>

    <slot />

    {/* Completion status */}
    <div
      x-show="completionStatus === 'failed'"
      x-cloak
    >
      <ErrorAlert
        textExpr="completionError"
        alwaysVisible
      />
      <Button
        variant="sheet-raised"
        class="mt-2 w-full"
        @click="uploadAndCompleteSession()"
        title="Retry"
      />
    </div>
    <SaveStatus />

    {
      /* Play-again failure: separate from completion status, buttons stay enabled */
    }
    <ErrorAlert
      showExpr="playAgainError"
      textExpr="playAgainError"
    />

    {/* Action buttons: enabled only when completionStatus === 'succeeded' */}
    <SheetActions slot="footer">
      <Button
        variant="sheet-muted"
        @click="back()"
        :disabled="completionStatus !== 'succeeded'"
        title="Back to games"
        grow
      />
      <Button
        variant="sheet-raised"
        @click="$data.requestPlayAgain ? requestPlayAgain() : playAgain()"
        :disabled="completionStatus !== 'succeeded' || playAgainLoading"
        loadingExpr="playAgainLoading"
        title="Rematch"
        grow
      />
    </SheetActions>
  </Modal>
  <StarterStep
    showExpr="$data.starterOpen"
    optionsExpr="playAgainStarterOptions()"
  />
</div>
