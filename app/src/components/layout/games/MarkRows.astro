---
/**
 * Cricket / Tactics mark rows for a scoreboard's right column: the
 * objective label, then three pips, one lit per mark. A closed row fades
 * to 50%. Rows that carry `opponentMarks` (1v1) add a muted second pip
 * group, light the label while the row scores (`scoring`) and fade it once
 * both seats closed it (`dead`) and strike a line through label and pips.
 * @param {string} [rowsExpr] Alpine expression for the rows (default `objectiveRowsFor(rowsRef)`)
 */
interface Props {
  rowsExpr?: string;
}

// Props
const { rowsExpr = "objectiveRowsFor(rowsRef)" }: Props = Astro.props;
---

<div class="flex min-h-0 flex-col justify-center gap-1">
  <template
    x-for={`row in ${rowsExpr}`}
    :key="row.objective"
  >
    <div
      class="relative flex items-center justify-between gap-2"
      role="img"
      :class="row.dead ? 'opacity-60' : row.closed && !row.scoring && 'opacity-50'"
      :aria-label="`${row.label}: ${row.marks} of 3 marks` + (row.opponentMarks != null ? `, opponent ${row.opponentMarks} of 3` : '') + (row.scoring ? ', scoring' : row.dead ? ', dead' : '')"
    >
      <span
        class="text-body-sm font-medium text-foreground"
        :class="row.scoring && 'text-accent-bright'"
        x-text="row.label"
      ></span>
      <template x-if="row.opponentMarks != null">
        <span class="ml-auto flex gap-0.5 opacity-40">
          <template
            x-for="pip in [1, 2, 3]"
            :key="pip"
          >
            <span
              class="size-1.5 rounded-full"
              :class="pip <= row.opponentMarks ? 'pip-on' : 'inset-well'"
            ></span>
          </template>
        </span>
      </template>
      <span class="flex gap-1">
        <template
          x-for="pip in [1, 2, 3]"
          :key="pip"
        >
          <span
            class="size-2.5 rounded-full"
            :class="pip <= row.marks ? 'pip-on' : 'inset-well'"
          ></span>
        </template>
      </span>
      <span
        x-show="row.dead"
        x-cloak
        class="absolute inset-x-0 top-1/2 h-px bg-foreground"
        aria-hidden="true"
      ></span>
    </div>
  </template>
</div>
