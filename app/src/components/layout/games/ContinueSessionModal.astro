---
/**
 * Presentational — parent setup page owns showActiveSessionModal (x-if).
 * Custom two-action footer (not cancel/confirm) on Modal shell.
 */
interface Props {
  gameTitle?: string;
}

// Props
const { gameTitle = "Score Training" }: Props = Astro.props;

// Components
import Modal from "@components/ui/Modal.astro";
import InlayRow from "@components/ui/InlayRow.astro";
import Button from "@components/forms/Button.astro";
import SheetActions from "@components/ui/SheetActions.astro";
---

<Modal
  titleId="continue-session-title"
  descriptionId="continue-session-desc"
  dismissible={false}
>
  <h2
    slot="header"
    id="continue-session-title"
    class="text-balance font-display text-xl text-foreground"
  >
    Active session
  </h2>
  <p
    slot="header"
    id="continue-session-desc"
    class="text-pretty text-sm text-muted-foreground"
  >
    You have an active {gameTitle} session. Continue playing or start a new one?
  </p>
  <InlayRow
    rowExpr="$store.game.contextRow(activeSession?.sessionId ?? null, activeSession?.gameTypeName ?? null)"
  />
  <p
    class="text-center text-sm text-error"
    x-show="error"
    x-text="error"
    x-cloak
  >
  </p>

  <SheetActions slot="footer">
    <Button
      type="button"
      variant="sheet-muted"
      title="Start new"
      @click="abandonSession()"
      :disabled="loading"
      grow
    />
    <Button
      type="button"
      variant="sheet-raised"
      title="Continue"
      @click="continueSession()"
      :disabled="loading"
      grow
    />
  </SheetActions>
</Modal>
