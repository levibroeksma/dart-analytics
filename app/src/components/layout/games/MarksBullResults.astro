---
/**
 * Results modal for a marks game scored by bull hits (Tactics, Mickey Mouse):
 * the solo darts-to-close block with marks per round and bulls, then the 1v1
 * comparison of points, darts, marks per round and bulls.
 * @param {string} overline Modal overline, e.g. "Tactics · Summary"
 * @param {readonly string[]} targetLabels Objective labels in display order
 */
interface Props {
  overline: string;
  targetLabels: readonly string[];
}

// Props
const { overline, targetLabels }: Props = Astro.props;

// Components
import ResultsModalShell from "@components/layout/games/ResultsModalShell.astro";
import DartsToCloseSummary from "@components/layout/games/DartsToCloseSummary.astro";
import ComparisonSummary from "@components/layout/games/ComparisonSummary.astro";

const STAT_ROWS = [
  { label: "Darts used", key: "darts", hero: true, skeletonWidth: "w-30" },
  {
    label: "Marks / round",
    key: "marksPerRound",
    side: true,
    skeletonWidth: "w-14",
  },
  { label: "Bulls", key: "bulls", side: true, skeletonWidth: "w-6" },
] as const;

const DUEL_ROWS = [
  { label: "Points", key: "points" },
  { label: "Darts", key: "darts" },
  { label: "Marks / round", key: "marksPerRound" },
  { label: "Bulls", key: "bulls" },
] as const;
---

<ResultsModalShell overline={overline}>
  <DartsToCloseSummary
    statRows={STAT_ROWS}
    targetLabels={targetLabels}
  />
  <ComparisonSummary
    statRows={DUEL_ROWS}
    winnerExpr="resultsSnapshot?.seats?.findIndex((seat) => seat.sideKey === resultsSnapshot?.winningSideKey) ?? -1"
  />
</ResultsModalShell>
