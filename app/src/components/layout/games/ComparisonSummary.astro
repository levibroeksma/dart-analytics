---
import ResultValue from "@components/layout/games/ResultValue.astro";
import StatRowComparison from "@components/layout/games/StatRowComparison.astro";

/**
 * 1v1 results ledger. `winnerExpr` is an Alpine expression evaluating to the
 * winning seat's index (0 or 1), or -1 for none; it tints the winner's column
 * and, with `legsBars`, the score row's bars. `legsBars` shows the legs score
 * and one bar segment per leg needed to win the match. Names, score and
 * values pulse in place until results are saved.
 */
interface Props {
  statRows: readonly { label: string; key: string; fallback?: string }[];
  winnerExpr?: string;
  legsBars?: boolean;
}

const { statRows, winnerExpr = "-1", legsBars = false }: Props = Astro.props;

function seatValueExpr(
  seatIndex: 0 | 1,
  row: (typeof statRows)[number],
): string {
  const base = `resultsSnapshot?.seats?.[${seatIndex}]?.${row.key}`;
  return "fallback" in row && row.fallback !== undefined
    ? `${base} ?? ${row.fallback}`
    : base;
}

const legsWon = (seatIndex: 0 | 1) =>
  `(resultsSnapshot?.seats?.[${seatIndex}]?.legsWon ?? 0)`;
const barTrackAttrs = {
  ":style":
    "`grid-template-columns: repeat(${$store.game.configSnapshot?.legsToWin ?? 0}, minmax(0, 1fr))`",
};
const legsExpr = "$store.game.configSnapshot?.legsToWin ?? 0";
const seatSides = ([0, 1] as const).map((index) => {
  const winnerClass = `winner === ${index}`;
  return {
    index,
    wrapClass:
      index === 0
        ? "flex flex-col gap-[7px]"
        : "flex flex-col items-end gap-[7px]",
    nameAttrs: {
      ":class": `${winnerClass} ? 'text-accent-bright' : 'text-muted-foreground'`,
    },
    nameExpr: `$store.game.seats[${index}]?.displayName`,
    legAttrs: {
      ":class": `leg <= ${legsWon(index)} ? (${winnerClass} ? 'bg-accent' : 'bg-muted-foreground') : 'bg-white/15'`,
    },
  };
});
---

{/* 1v1: comparison ledger — stat label centered, values on either side */}
<div
  class="flex w-full flex-col gap-4"
  x-data={`{ get winner() { return ${winnerExpr}; } }`}
  x-show="$store.game.seats.length === 2"
  x-cloak
>
  {
    legsBars ? (
      <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2">
        {seatSides.map((side) => (
          <>
            <div class={side.wrapClass}>
              <span {...side.nameAttrs}>
                <ResultValue
                  class="text-sm font-semibold"
                  valueExpr={side.nameExpr}
                  skeletonWidth="w-12"
                />
              </span>
              <div
                class="grid w-16 gap-[3px]"
                {...barTrackAttrs}
              >
                <template x-for={`leg in ${legsExpr}`}>
                  <span
                    class="h-1 rounded-full"
                    {...side.legAttrs}
                  />
                </template>
              </div>
            </div>
            {side.index === 0 && (
              <ResultValue
                class="font-display text-[2.5rem] leading-none tabular-nums text-foreground"
                valueExpr={`${legsWon(0)} + ' – ' + ${legsWon(1)}`}
                skeletonWidth="w-26"
              />
            )}
          </>
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2">
        <ResultValue
          class="justify-self-start font-display text-sm text-foreground"
          valueExpr="$store.game.seats[0]?.displayName"
          skeletonWidth="w-12"
        />
        <span class="font-mono text-eyebrow font-semibold text-muted">VS</span>
        <ResultValue
          class="justify-self-end font-display text-sm text-foreground"
          valueExpr="$store.game.seats[1]?.displayName"
          skeletonWidth="w-12"
        />
      </div>
    )
  }

  <dl class="inset-well rounded-2xl px-4 py-1">
    {
      statRows.map((row) => (
        <StatRowComparison
          label={row.label}
          leftValue={seatValueExpr(0, row)}
          rightValue={seatValueExpr(1, row)}
        />
      ))
    }
  </dl>
</div>
