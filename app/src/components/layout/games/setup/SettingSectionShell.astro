---
interface Props {
  [key: string]: any;
}
const { ...props } = Astro.props;
---

<div
  class="flex flex-col gap-3 bg-tab-card border-tab-border rounded-3xl p-3 border"
  {...props}
>
  <h2 class="text-base text-center">Settings</h2>
  <div class="flex flex-col gap-3">
    <fieldset>
      <slot />
    </fieldset>
  </div>
</div>
