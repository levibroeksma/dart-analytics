---
// Components
import DurationField from "./DurationField.astro";
import Switch from "@components/forms/Switch.astro";
import InfoSection from "@components/ui/InfoSection.astro";
import SetupShell from "./SetupShell.astro";
import SettingSectionShell from "./SettingSectionShell.astro";
import UserSection from "./UserSection.astro";
import { supportsDartbot } from "@lib/game/rulesets/capabilities";
import { tuodDurationBounds } from "@lib/game/tuod-duration";

// Data
const durationOpts = [
  { value: "ROUNDS", label: "Rounds" },
  { value: "MINUTES", label: "Time" },
];
const rounds = tuodDurationBounds("ROUNDS");
const minutes = tuodDurationBounds("MINUTES");
const soloHint = "Time is solo only — with a guest or bot, play by rounds.";

const infoSection = {
  title: "Ten Up One Down rules",
  description:
    "Start at 41. One visit (3 darts) to check out on a double. Check out and the next target climbs +10; miss and it drops -1, floored at 2 — the lowest target any double can finish.",
};
---

<SetupShell title="Ten Up One Down">
  <UserSection
    allowGuests
    allowDartbot={supportsDartbot("TUOD_V1")}
  />
  <InfoSection
    title={infoSection.title}
    description={infoSection.description}
  />
  <SettingSectionShell>
    <DurationField
      formatOptions={durationOpts}
      rounds={rounds}
      minutes={minutes}
      soloHint={soloHint}
    />
    <Switch
      label="Show checkout hints"
      x-model="$store.checkoutHints.enabled"
    />
  </SettingSectionShell>
</SetupShell>
