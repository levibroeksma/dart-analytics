---
/**
 * Pill-style toggle. Bind the selected value from a parent scope with
 * `x-model`; the value is exposed through `x-modelable="activeTab"`.
 * @param {ToggleOption[]} options `options[].disabled` is rendered dimmed,
 *   unclickable, `aria-disabled`
 * @param {"horizontal"|"vertical"} orientation
 * @param {string} [initial] Only when there is no parent `x-model`
 * @param {string} [hint] Italic caption rendered under the control
 * @param {string} [class] Extra classes
 */
interface ToggleOption {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  options: ToggleOption[];
  orientation: "horizontal" | "vertical";
  initial?: string;
  hint?: string;
  class?: string;
  [key: string]: unknown;
}

// Props
const {
  options,
  orientation,
  initial,
  hint,
  class: classNameProp,
  ...props
}: Props = Astro.props;

// Components
import ToggleListItem from "./ToggleListItem.astro";

// Lib
import { cn } from "@client/cn";

// Data
const config = {
  options,
  orientation,
  initial: initial ?? options[0]?.value ?? "",
};
const n = options.length;

// Styles
const className = cn("tab-container", classNameProp ?? "w-fit");
const shellClass = cn(
  "relative grow w-full h-full inset-well p-1",
  orientation === "horizontal" ? "rounded-full" : "rounded-[26px]",
);
const listClass = "relative z-1 grid h-full w-full items-stretch gap-1";
const listStyle =
  orientation === "horizontal"
    ? `grid-template-columns: repeat(${n}, minmax(0, 1fr));`
    : `grid-template-rows: repeat(${n}, minmax(0, 1fr));`;
---

<div
  class={className}
  x-data={`toggle(${JSON.stringify(config)})`}
  x-modelable="activeTab"
  {...props}
>
  <div
    x-ref="list"
    class={shellClass}
  >
    <div
      class="pointer-events-none absolute left-0 top-0 z-0 rounded-full glass-blue transition-transform duration-500 ease-out"
      :style="`width:${pill.w}px;height:${pill.h}px;transform:translate(${pill.x}px,${pill.y}px)`"
    >
    </div>
    <ul
      class={listClass}
      style={listStyle}
    >
      {
        options.map((opt) => (
          <ToggleListItem
            value={opt.value}
            label={opt.label}
            disabled={opt.disabled}
            tall={orientation === "vertical"}
          />
        ))
      }
    </ul>
  </div>
</div>
{
  hint && (
    <div class="px-0.5 text-xs text-muted">
      <span x-text={`${hint}`} />
    </div>
  )
}
