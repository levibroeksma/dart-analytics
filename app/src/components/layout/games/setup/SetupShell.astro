---
/**
 * Setup page shell: glass back link and centered title on one row (a
 * 40px / 1fr / 40px grid keeps the title centered while the link sits
 * left), wrapping a form that
 * submits via `start()`. Every setup page's own `x-data` factory exposes
 * `loadingReconciliation` (active-session/preset lookup), which disables
 * submit alongside `loading` (the in-flight `start()` call) so a player
 * can't start before defaults have loaded. Start is a slide gesture
 * (`SlideToStart`), disabled while `loading || loadingReconciliation`.
 * @param {string} title
 */
interface Props {
  title: string;
  [key: string]: unknown;
}

// Props
const { title, ...props }: Props = Astro.props;

// Components
import SlideToStart from "@components/forms/SlideToStart.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";

// Icons
import ChevronDownIcon from "@icons/chevron-down.svg";
---

<div {...props}>
  <header class="grid grid-cols-[40px_1fr_40px] items-center pt-3 pb-2">
    <a
      href="/games"
      aria-label="Back to games"
      class="glass-button flex size-10 items-center justify-center rounded-full"
    >
      <ChevronDownIcon class="size-5.5 rotate-90 text-muted-foreground" />
    </a>
    <h2
      class="text-center font-display text-lg tracking-[0.02em] text-foreground"
    >
      {title}
    </h2>
    <span></span>
  </header>

  <form
    class="mt-1 flex max-w-sm flex-col gap-3 pb-28"
    @submit.prevent="loading || loadingReconciliation || start()"
  >
    <slot />

    <ErrorAlert class="mt-2" />

    <div
      aria-hidden="true"
      class="start-bar-fade pointer-events-none fixed inset-x-0 bottom-0 z-20 h-50"
    >
    </div>
    <SlideToStart
      disabledExpr="loading || loadingReconciliation"
      failedExpr="error || showActiveSessionModal || reconciliationFailed"
    />
  </form>
</div>
