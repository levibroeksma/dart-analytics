---
/**
 * Setup page shell: `PageHeader` (back link + centered title), wrapping a
 * form that submits via `beginStart()` — straight to `start()` solo, or through the
 * who-throws-first `StarterStep` with an opponent. Every setup page's own `x-data` factory exposes
 * `loadingReconciliation` (active-session/preset lookup), which disables
 * submit alongside `loading` (the in-flight `start()` call) so a player
 * can't start before defaults have loaded. Start is a slide gesture
 * (`SlideToStart`), disabled while `loading || loadingReconciliation`.
 * @param {string} title
 */
interface Props {
  title: string;
  [key: string]: unknown;
}

// Props
const { title, ...props }: Props = Astro.props;

// Components
import SlideToStart from "@components/forms/SlideToStart.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import StarterStep from "@components/layout/games/StarterStep.astro";
import PageHeader from "@components/layout/PageHeader.astro";
---

<div {...props}>
  <PageHeader
    backHref="/games"
    backLabel="Back to games"
    title={title}
  />

  <form
    class="mt-2 flex flex-col gap-3 pb-28"
    @submit.prevent="loading || loadingReconciliation || beginStart()"
  >
    <slot />

    <ErrorAlert class="mt-2" />

    <div
      aria-hidden="true"
      class="start-bar-fade pointer-events-none fixed inset-x-0 bottom-0 z-20 h-50"
    >
    </div>
    <SlideToStart
      disabledExpr="loading || loadingReconciliation"
      failedExpr="error || showActiveSessionModal"
    />
  </form>

  <StarterStep
    showExpr="starterOpen"
    optionsExpr="starterOptions()"
  />
</div>
