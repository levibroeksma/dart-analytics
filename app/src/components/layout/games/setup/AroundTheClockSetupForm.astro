---
// Components
import Switch from "@components/forms/Switch.astro";
import InfoSection from "@components/ui/InfoSection.astro";
import SetupShell from "./SetupShell.astro";
import SettingSectionShell from "./SettingSectionShell.astro";
import Toggle from "./Toggle.astro";
import UserSection from "./UserSection.astro";
import SettingLabel from "./SettingLabel.astro";
import RangeSlider from "@components/forms/RangeSlider.astro";
import { supportsDartbot } from "@lib/game/rulesets/capabilities";
import {
  aroundTheClockDurationBounds,
  AROUND_THE_CLOCK_DEFAULT_MINUTES,
} from "@lib/game/around-the-clock-duration";

// Data
const infoSection = {
  title: "Around the Clock rules",
  description:
    "Hit every number in order, then finish on the bull — either bull ring counts. Choose low to high or high to low, and odds before evens. On Easy any hit advances immediately, so a great turn can clear several numbers in three darts. On 1, 2 or 3 darts, a visit needs that many hits to move up one; fall short and you step back one, never below the first number. Outer single only counts just the large single ring (Analytics mode). Timed runs restart at the first number after the bull and count laps until time runs out. Playing the DartBot always uses the classic rules.",
};

const directionOpts = [
  { value: "LOW_TO_HIGH", label: "Low → High" },
  { value: "HIGH_TO_LOW", label: "High → Low" },
];

const segmentOpts = [
  { value: "ANY", label: "Any segment" },
  { value: "OUTER_SINGLE", label: "Outer single" },
];

const difficultyOpts = [
  { value: "EASY", label: "Easy" },
  { value: "INTERMEDIATE", label: "1 dart" },
  { value: "HARD", label: "2 darts" },
  { value: "PRO", label: "3 darts" },
];

const durationOpts = [
  { value: "UNTIMED", label: "Untimed" },
  { value: "MINUTES", label: "Timed" },
];
const minutes = aroundTheClockDurationBounds();
---

<SetupShell title="Around the Clock">
  <UserSection
    allowGuests
    allowDartbot={supportsDartbot("AROUND_THE_CLOCK_V1")}
  />
  <InfoSection
    title={infoSection.title}
    description={infoSection.description}
  />
  <SettingSectionShell>
    <div
      class="flex flex-col gap-4"
      x-show="!bot"
      x-cloak
    >
      <div class="flex flex-col gap-2">
        <SettingLabel text="DIRECTION" />
        <Toggle
          orientation="horizontal"
          options={directionOpts}
          x-model="pathDirection"
          class="w-full"
        />
      </div>
      <Switch
        label="Odds first"
        hint="Play every odd number before the evens"
        x-model="oddsFirst"
      />
      <div class="flex flex-col gap-2">
        <SettingLabel text="DIFFICULTY" />
        <Toggle
          orientation="horizontal"
          options={difficultyOpts}
          x-model="difficulty"
          class="w-full"
        />
      </div>
      <div
        class="flex flex-col gap-2"
        x-show="$store.settings.captureModeKey === 'ANALYTICS'"
        x-cloak
      >
        <SettingLabel
          text="SEGMENT"
          badge="ANALYTICS"
        />
        <Toggle
          orientation="horizontal"
          options={segmentOpts}
          x-model="segmentRule"
          class="w-full"
        />
      </div>
      <div
        class="flex flex-col gap-4"
        x-show="guests.length === 0"
        x-cloak
      >
        <div class="flex flex-col gap-2">
          <SettingLabel text="DURATION" />
          <Toggle
            orientation="horizontal"
            options={durationOpts}
            x-model="durationType"
            class="w-full"
          />
        </div>
        <template x-if="durationType === 'MINUTES'">
          <RangeSlider
            min={minutes.min}
            max={minutes.max}
            fallback={AROUND_THE_CLOCK_DEFAULT_MINUTES}
            label="MINUTES"
            ariaLabel="Number of minutes"
            hint={`${minutes.min}–${minutes.max} minutes. Solo only.`}
            x-model="durationValue"
          />
        </template>
      </div>
    </div>
  </SettingSectionShell>
</SetupShell>
