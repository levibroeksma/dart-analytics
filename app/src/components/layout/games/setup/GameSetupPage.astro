---
/**
 * Page shell for every game setup route: layout, the page's `x-data`
 * scope (passed as a rest attribute, so each page file still declares its
 * own `x-data="<name>Setup()"`), the continue-session modal and the
 * game's setup form in the default slot. The scope must expose
 * `showActiveSessionModal`, `activeSession`, `activeSessionLocal`,
 * `loadingReconciliation`, `retryReconciliation()` and `leaveSetup()`.
 * @param {string} title Display name; also names the game in the modal
 */
interface Props {
  title: string;
  [key: string]: unknown;
}

// Props
const { title, class: classNameProp = "", ...props }: Props = Astro.props;

// Components
import { cn } from "@client/cn";
import AppLayout from "@layouts/AppLayout.astro";
import ContinueSessionModal from "@components/layout/games/ContinueSessionModal.astro";
---

<AppLayout title={`${title} — Setup`}>
  <div
    class={cn("p-4", classNameProp as string)}
    {...props}
  >
    <template x-if="showActiveSessionModal && activeSession">
      <ContinueSessionModal gameTitle={title} />
    </template>

    <template x-if="!showActiveSessionModal">
      <slot />
    </template>
  </div>
</AppLayout>
