---
// Components
import DurationField from "./DurationField.astro";
import InfoSection from "@components/ui/InfoSection.astro";
import SetupShell from "./SetupShell.astro";
import SettingSectionShell from "./SettingSectionShell.astro";
import UserSection from "./UserSection.astro";
import { supportsDartbot } from "@lib/game/rulesets/capabilities";
import { scoreTrainingDurationBounds } from "@lib/game/score-training-duration";

// Data
const formatOpts = [
  { value: "ROUNDS", label: "Rounds" },
  { value: "MINUTES", label: "Time" },
];
const rounds = scoreTrainingDurationBounds("ROUNDS");
const minutes = scoreTrainingDurationBounds("MINUTES");
const soloHint = "Time is solo only — with a guest or bot, play by rounds.";

const infoSection = {
  title: "Scoring Training rules",
  description:
    "The rules are very straightforward: score as many points as you can in the set amount of round or time limit. Try to set, and beat your personal best.",
};
---

<SetupShell title="Score Training">
  <UserSection
    allowGuests
    allowDartbot={supportsDartbot("SCORE_TRAINING_V1")}
  />
  <InfoSection
    title={infoSection.title}
    description={infoSection.description}
  />
  <SettingSectionShell>
    <DurationField
      formatOptions={formatOpts}
      rounds={rounds}
      minutes={minutes}
      soloHint={soloHint}
    />
  </SettingSectionShell>
</SetupShell>
