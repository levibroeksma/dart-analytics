---
/**
 * Circular initials avatar with the player's name underneath.
 * @param {string} name Static fallback, rendered until `nameExpr` hydrates
 * @param {string} [nameExpr] Alpine expression overriding `name` once ready
 * @param {string} [initialsExpr] Alpine expression for the avatar text;
 *   defaults to `$initials(<nameExpr or name>)`
 */
interface Props {
  name: string;
  nameExpr?: string;
  initialsExpr?: string;
}

// Props
const {
  name,
  nameExpr,
  initialsExpr = `$initials(${nameExpr ?? `'${name}'`})`,
}: Props = Astro.props;
---

<div class="flex flex-col items-center gap-1.5">
  <div
    class="glass-blue flex size-13 items-center justify-center rounded-full font-display text-base text-foreground"
    x-text={initialsExpr}
  >
  </div>
  <span
    class="text-xs font-semibold text-foreground"
    x-text={nameExpr}
  >
    {name}
  </span>
</div>
