---
/**
 * One option inside a Toggle. Reads `activeTab` and calls `select()` from the
 * Toggle's Alpine scope.
 * @param {string} value
 * @param {string} label
 */
interface Props {
  value: string;
  label: string;
  [key: string]: unknown;
}

// Props
const { value, label, ...props }: Props = Astro.props;
---

<li
  class="min-w-0 min-h-10 w-full h-full p-2 rounded-full flex items-center justify-center cursor-pointer"
  data-toggle-value={value}
  :class={`activeTab === '${value}' ? 'text-accent' : 'text-muted-foreground'`}
  @click={`select('${value}')`}
  {...props}
>
  <input
    type="radio"
    id={value}
    value={value}
    class="hidden peer"
  />
  <label
    for={value}
    class="w-full"
  >
    <div class="w-full font-semibold text-center">{label}</div>
  </label>
</li>
