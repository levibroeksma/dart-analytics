---
/**
 * Pointer-driven dartboard for a VISUAL_BOARD session, mounted in place of the
 * keypad — a visual session enters every dart on the board, so the keypad is
 * hidden while this is shown and this panel carries its own undo.
 *
 * Declares no `x-data` of its own: it mounts inside the play page's own scope
 * and reads what `boardInputData()` contributes there (`board`, the pointer
 * handlers, `recordUnseen`, `visitMarkers`) plus the page's `finished` /
 * `hasActiveSession` flags, `undoVisit()` and the `game` store's
 * `inputModeKey`. Both play pages spread `boardInputData()` into their
 * factory, so the contract holds for each.
 *
 * The gate reads the ACTIVE session's own mode off `$store.game`, never the
 * `settings` store: app mode can be switched mid-session from the settings
 * screen, and gating on it renders the board over a QUICK_SCORE session, whose
 * dart rows the server refuses for the entire batch at completion.
 *
 * During a Dartbot visit `BotVisitStrip` tops the panel and `BotDartFlight`
 * draws the dart in flight over the board (`botFlight`).
 *
 * Markers show the most recent visit's darts — see `markersForTurns` for why
 * that is the last turn rather than only an open one. They are rendered into
 * `<DartBoard />`'s slot, which overlays the SVG rather than living inside it.
 *
 * `touch-none` on the pointer surface stops the browser turning a drag into a
 * scroll or a pinch, so `pointermove` keeps arriving for the whole gesture.
 * The board area is a `flex-1 min-h-0` row of the panel's column. The panel
 * draws the `input-well` look (`glass`, `rounded-board`) on its own
 * `-z-10` background layer rather than on the root: `glass` carries
 * `backdrop-blur-sm`, and a `backdrop-filter` ancestor becomes the containing
 * block of the `fixed` ring and magnifier, offsetting them from the finger.
 * The pointer surface is `h-full max-w-full aspect-square`, so the board sizes
 * off the height the play screen leaves it, clamped to the width, with no
 * viewport-relative number (#131). While a press is live, the board takes
 * `board-dim` and a 44px ring marks the pointer. Both sit beside the
 * magnifier, never on its ancestors: a `filter` on an ancestor becomes the
 * containing block of the `fixed` magnifier and breaks its placement.
 *
 * @param {string} [showExpr] Alpine expression for when the panel shows;
 *   defaults to the active VISUAL_BOARD game session, unpaused and unfinished
 * @param {string} [undoDisabledExpr] Alpine expression that disables undo;
 *   defaults to no turns in the `game` store
 * @slot actions Extra keys after undo and Bounce out in the bottom row,
 *   which then takes three columns
 */

// Components
import DartBoard from "@components/ui/DartBoard.astro";
import BoardMagnifier from "@components/ui/BoardMagnifier.astro";
import InputButton from "@components/layout/games/InputButton.astro";
import BotDartFlight from "@components/layout/games/BotDartFlight.astro";
import BotVisitStrip from "@components/layout/games/BotVisitStrip.astro";

// Icons
import UndoIcon from "@icons/undo.svg";

// Lib
import { cn } from "@client/cn";

interface Props {
  showExpr?: string;
  undoDisabledExpr?: string;
}

// Props
const {
  showExpr = "!finished && !$store.game.timerPaused && hasActiveSession && $store.game.inputModeKey === 'VISUAL_BOARD'",
  undoDisabledExpr = "!$store.game.turns.length",
}: Props = Astro.props;

// Styles
const actionsClass = cn(
  "grid h-14 w-full shrink-0 gap-2",
  Astro.slots.has("actions") ? "grid-cols-3" : "grid-cols-2",
);
---

<div
  x-show={showExpr}
  x-cloak
  class="relative isolate flex min-h-0 flex-1 flex-col items-center gap-2 rounded-board p-2.5"
>
  <div
    class="glass pointer-events-none absolute inset-0 -z-10 rounded-board"
    aria-hidden="true"
  >
  </div>
  <BotVisitStrip />
  <div class="flex min-h-0 w-full flex-1 items-center justify-center">
    <div
      class="relative aspect-square h-full max-w-full touch-none"
      @pointerdown="onPointerDown($event)"
      @pointermove="onPointerMove($event)"
      @pointerup="onPointerUp()"
      @pointercancel="onPointerCancel()"
    >
      <DartBoard
        boardRef="board"
        class="transition duration-150 ease-out"
        :class="board.active && 'board-dim'"
      >
        <div
          class="pointer-events-none absolute inset-0"
          aria-hidden="true"
        >
          <template
            x-for="marker in visitMarkers()"
            :key="marker.sequence"
          >
            <span
              class="absolute size-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-surface bg-accent"
              :style="`left: ${marker.leftPercent}%; top: ${marker.topPercent}%`"
            >
            </span>
          </template>
        </div>
        <BotDartFlight />
      </DartBoard>
      <span
        class="pointer-events-none fixed z-10 size-11 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/12 ring-1 ring-white/25"
        aria-hidden="true"
        x-show="board.active"
        x-cloak
        :style="{ left: pointerX + 'px', top: pointerY + 'px' }"
      ></span>
      <BoardMagnifier />
    </div>
  </div>

  <div class={actionsClass}>
    <InputButton
      variant="muted"
      aria-label="Undo dart"
      :disabled={undoDisabledExpr}
      @click="undoVisit()"
    >
      <UndoIcon class="size-6 text-muted-foreground" />
    </InputButton>
    <InputButton
      class="font-sans text-control font-medium"
      @click="recordUnseen()"
    >
      Bounce out
    </InputButton>
    <slot name="actions" />
  </div>
</div>
