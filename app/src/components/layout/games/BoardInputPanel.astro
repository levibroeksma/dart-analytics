---
/**
 * Pointer-driven dartboard for a VISUAL_BOARD session, mounted *beside* a play
 * page's keypad rather than replacing it — the keypad stays rendered for every
 * session as the accessible alternative.
 *
 * Declares no `x-data` of its own: it mounts inside the play page's own scope
 * and reads what `boardInputData()` contributes there (`input`, the pointer
 * handlers, `recordUnseen`) plus the page's `finished` / `hasActiveSession`
 * flags and the `settings` store's `inputModeKey`. Both play pages spread
 * `boardInputData()` into their factory, so the contract holds for each.
 *
 * `<template x-if="input !== null">` around `<BoardMagnifier />` is
 * load-bearing, not defensive tidiness: the magnifier's bindings dereference
 * `input` unconditionally and throw while it is still null, which is its state
 * for the whole time between page load and the first press.
 *
 * `touch-none` on the pointer surface stops the browser turning a drag across
 * the board into a scroll or a pinch, so `pointermove` keeps arriving for the
 * length of the gesture; `w-[min(100%,60vh)]` caps the board's width by
 * viewport height, so a landscape phone or a desktop window cannot render a
 * board taller than the screen it has to fit in.
 */

// Components
import DartBoard from "@components/ui/DartBoard.astro";
import BoardMagnifier from "@components/ui/BoardMagnifier.astro";
---

<div
  x-show="!finished && hasActiveSession && $store.settings.inputModeKey === 'VISUAL_BOARD'"
  x-cloak
  class="mt-3 space-y-3"
>
  <div
    class="relative mx-auto w-[min(100%,60vh)] touch-none"
    @pointerdown="onPointerDown($event)"
    @pointermove="onPointerMove($event)"
    @pointerup="onPointerUp()"
    @pointercancel="onPointerCancel()"
  >
    <DartBoard boardRef="board" />
    <template x-if="input !== null">
      <BoardMagnifier />
    </template>
  </div>

  <button
    type="button"
    class="w-full rounded-lg border border-border px-4 py-3 text-foreground"
    @click="recordUnseen()"
  >
    Dart not seen
  </button>
</div>
