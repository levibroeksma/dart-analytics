---
/**
 * Presentational — parent play page owns `showDoubleConfirm` (x-show).
 *
 * One dialog for every quick-score checkout: it confirms the finishing dart
 * landed in a double and, in the same step, collects the visit's shape — how
 * many darts it took and how many of those were thrown at a double. The
 * option rows come from the page's `checkoutDartOptions()`, which narrows them
 * to what the checkout chart allows for the score being finished, so a route
 * with only one possible answer renders one button rather than three.
 *
 * Two actions on the `Modal` shell rather than `ConfirmDialog`'s pair: the
 * dialog carries option rows above the footer, which `ConfirmDialog` has no
 * slot for. There is no bust action — the typed total already says what
 * happened, since the dialog only opens on a total that finishes exactly.
 *
 * Page scope must provide `checkoutDartOptions()`, `dartsToFinish`,
 * `dartsAtDouble`, `confirmDouble()` and `cancelCheckout()`.
 */

// Components
import Modal from "@components/ui/Modal.astro";
import Button from "@components/forms/Button.astro";
import SheetActions from "@components/ui/SheetActions.astro";

// Data
const groups = [
  {
    id: "darts-at-double",
    label: "Darts at a double",
    optionsExpr: "checkoutDartOptions().atDouble",
    model: "dartsAtDouble",
  },
  {
    id: "darts-to-finish",
    label: "Darts to finish",
    optionsExpr: "checkoutDartOptions().toFinish",
    model: "dartsToFinish",
  },
];

// Styles
const optionClass =
  "flex h-10 cursor-pointer items-center justify-center rounded-full text-button font-semibold transition-[color,background-color] duration-150";
---

<Modal
  titleId="checkout-confirm-title"
  descriptionId="checkout-confirm-desc"
  dismissible={false}
  overline="501 · Checkout"
>
  <h2
    slot="header"
    id="checkout-confirm-title"
    class="text-balance font-display text-xl text-foreground"
  >
    Finished on a double?
  </h2>
  <p
    slot="header"
    id="checkout-confirm-desc"
    class="text-pretty text-sm text-muted-foreground"
  >
    Confirm the last dart landed in a double, then say how the visit was thrown.
  </p>

  {
    groups.map((group) => (
      <div class="flex w-full flex-col gap-2">
        <p
          id={`${group.id}-label`}
          class="px-0.5 font-mono text-eyebrow font-semibold uppercase text-muted-foreground"
        >
          {group.label}
        </p>
        <div
          class="inset-well grid gap-1 rounded-full p-1"
          role="radiogroup"
          aria-labelledby={`${group.id}-label`}
          {...{
            ":style": `\`grid-template-columns: repeat(\${${group.optionsExpr}.length}, minmax(0, 1fr))\``,
          }}
        >
          <template x-for={`count in ${group.optionsExpr}`}>
            <button
              type="button"
              role="radio"
              class={optionClass}
              {...{
                ":class": `${group.model} === count ? 'glass-blue text-foreground' : 'text-muted-foreground'`,
                ":aria-checked": `${group.model} === count`,
                ":tabindex": `${group.model} === count ? 0 : -1`,
                ":aria-label": `count + ' ${group.label.toLowerCase()}'`,
                "x-text": "count",
                "x-on:click": `${group.model} = count`,
              }}
            />
          </template>
        </div>
      </div>
    ))
  }

  <SheetActions slot="footer">
    <Button
      variant="sheet-muted"
      title="Cancel"
      @click="cancelCheckout()"
      grow
    />
    <Button
      variant="sheet-raised"
      title="Confirm checkout"
      @click="confirmDouble()"
      :disabled="dartsAtDouble === null || dartsToFinish === null"
      grow
    />
  </SheetActions>
</Modal>
