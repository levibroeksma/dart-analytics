---
interface Props {
  [key: string]: unknown;
}

// Props
const { ...props }: Props = Astro.props;

// Components
import SeatedPlayScreen from "@components/layout/games/SeatedPlayScreen.astro";
import VisitPreview from "@components/layout/games/VisitPreview.astro";
import FivesRecreationalInput from "@components/layout/games/FivesRecreationalInput.astro";
---

<SeatedPlayScreen
  big={{ isTarget: false, value: (c) => c("totalLabel") }}
  tiles={[
    { label: "Visit", value: (c) => c("visitLabel") },
    { label: "Last", value: (c) => c("lastLabel") },
  ]}
  idle={{ label: "Last", value: (c) => c("lastLabel") }}
  {...props}
>
  <VisitPreview />

  <FivesRecreationalInput
    x-show="$store.game.inputModeKey !== 'VISUAL_BOARD'"
    x-cloak
  />
</SeatedPlayScreen>
