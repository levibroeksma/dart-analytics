---
interface Props {
  [key: string]: unknown;
}

// Props
const { ...props }: Props = Astro.props;

// Components
import MarksPlayScreen from "@components/layout/games/MarksPlayScreen.astro";
import TacticsRecreationalInput from "@components/layout/games/TacticsRecreationalInput.astro";
---

<MarksPlayScreen {...props}>
  <TacticsRecreationalInput
    x-show="$store.game.inputModeKey !== 'VISUAL_BOARD'"
    x-cloak
  />
</MarksPlayScreen>
