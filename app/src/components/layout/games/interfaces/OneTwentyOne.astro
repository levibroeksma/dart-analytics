---
interface Props {
  [key: string]: unknown;
}

// Props
const { ...props }: Props = Astro.props;

// Components
import AttemptTargetPlayScreen from "@components/layout/games/AttemptTargetPlayScreen.astro";
---

<AttemptTargetPlayScreen
  tiles={[
    {
      label: "Visit",
      value: (c) => `(${c("visitsThisAttempt")} + 1) + ' / 3'`,
    },
    { label: "Darts", value: (c) => c("dartsThisAttempt") },
  ]}
  finishConfirm="showSessionFinishConfirm"
  {...props}
/>
