---
/**
 * The open visit's darts as a `glass` strip. Each column has an 18px header
 * (HIT with a check, MISS with a cross, or DART n) over a 6px bar: accent for
 * a hit, white/22 for a miss, a well for an empty dart. The next dart's bar
 * takes `next-dart-ring` (`previewColumnState`). Reads `previewSegments()`
 * from the play scope. By default three columns (the games' strip).
 *
 * `labelled` is the exercise strip: one centred column per segment (any
 * count), each dart's `label` replacing HIT / DART n, and a `value` dart
 * shown as its label alone with an accent bar.
 *
 * @param {boolean} [labelled] Exercise preview: per-dart labels, value darts, one column per segment
 */
interface Props {
  labelled?: boolean;
  [key: string]: unknown;
}

// Props
const { labelled = false, ...props }: Props = Astro.props;

// Icons
import CheckIcon from "@icons/check.svg";
import CrossIcon from "@icons/cross.svg";

// Labelled-only differences
const rootAttrs = labelled
  ? {
      ":style":
        "`grid-template-columns: repeat(${previewSegments().length}, minmax(0, 1fr))`",
    }
  : {};
const rootClass = `glass grid shrink-0 ${labelled ? "" : "grid-cols-3 "}gap-2 rounded-key px-4.5 py-3`;
const columnClass = `flex min-w-0 flex-col ${labelled ? "items-center " : ""}gap-1.5`;
const barClass = `h-1.5 ${labelled ? "w-full " : ""}rounded-full`;
const filled = labelled
  ? "column.status === 'hit' || column.status === 'value'"
  : "column.status === 'hit'";
const emptyText = labelled
  ? "column.label ?? 'DART ' + (index + 1)"
  : "'DART ' + (index + 1)";
---

<div
  class={rootClass}
  {...rootAttrs}
  {...props}
>
  <template
    x-for="(column, index) in $previewColumnState(previewSegments())"
    :key="index"
  >
    <div class={columnClass}>
      <div
        class="flex h-4.5 items-center font-mono text-eyebrow font-semibold uppercase"
      >
        <template x-if="column.status === 'hit'">
          <span class="flex items-center gap-1 text-accent">
            <CheckIcon class="size-3.5" />
            {labelled ? <span x-text="column.label ?? 'HIT'" /> : "HIT"}
          </span>
        </template>
        {
          labelled && (
            <template x-if="column.status === 'value'">
              <span
                class="text-accent"
                x-text="column.label"
              />
            </template>
          )
        }
        <template x-if="column.status === 'miss'">
          <span class="flex items-center gap-1 text-muted">
            <CrossIcon class="size-3" />
            MISS
          </span>
        </template>
        <template x-if="column.status === 'empty'">
          <span
            :class="column.next ? 'text-soft-foreground' : 'text-faint-foreground'"
            x-text={emptyText}
          ></span>
        </template>
      </div>
      <span
        class={barClass}
        {...{
          ":class": `${filled} ? 'bg-accent' : column.status === 'miss' ? 'bg-white/22' : column.next ? 'next-dart-ring' : 'inset-well'`,
        }}
      ></span>
    </div>
  </template>
</div>
