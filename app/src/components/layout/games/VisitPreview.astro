---
/**
 * The open visit's dart strip, as a `glass` strip reading `previewSegments()`
 * from the play scope. Games get `GameVisitStrip` (three darts: HIT / MISS /
 * DART n); `labelled` switches to `ExerciseVisitStrip` (per-dart labels,
 * value darts, one column per segment). Split in two because Prettier cannot
 * parse Alpine's `:attr` shorthand inside an Astro expression.
 *
 * @param {boolean} [labelled] Exercise preview: per-dart labels, value darts, one column per segment
 */
interface Props {
  labelled?: boolean;
  [key: string]: unknown;
}

// Props
const { labelled = false, ...props }: Props = Astro.props;

// Strips
import ExerciseVisitStrip from "./ExerciseVisitStrip.astro";
import GameVisitStrip from "./GameVisitStrip.astro";

const Strip = labelled ? ExerciseVisitStrip : GameVisitStrip;
---

<Strip {...props} />
