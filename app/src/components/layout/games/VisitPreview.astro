---
interface Props {
  [key: string]: unknown;
}

// Props
const { ...props }: Props = Astro.props;

// Icons
import CheckIcon from "@icons/check.svg";
import CrossIcon from "@icons/cross.svg";
---

<div
  class="flex flex-col items-center gap-1"
  {...props}
>
  <div
    class="rounded-lg glass border border-border bg-surface-raised flex w-full divide-x divide-border"
  >
    <template
      x-for="(segment, index) in previewSegments()"
      :key="index"
    >
      <div class="relative flex h-12 flex-1 items-center justify-center">
        <span
          class="pointer-events-none absolute inset-x-0 text-center text-muted-foreground uppercase transition-all duration-150"
          :class="segment.status === 'empty' ? 'top-1/2 -translate-y-1/2 text-xs' : 'top-1 text-[10px]'"
          x-text="'Dart ' + (index + 1)"
        >
        </span>
        <CheckIcon
          class="size-5 text-success"
          x-show="segment.status === 'hit'"
          x-cloak
        />
        <CrossIcon
          class="size-5 text-error"
          x-show="segment.status === 'miss'"
          x-cloak
        />
      </div>
    </template>
  </div>
</div>
