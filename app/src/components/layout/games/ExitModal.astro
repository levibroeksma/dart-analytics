---
/**
 * Presentational — parent GameLayout owns showExitModal (x-if).
 */
interface Props {
  description?: string;
}

const { description = "This session will be recorded as abandoned." }: Props =
  Astro.props;

// Components
import ConfirmDialog from "@components/ui/ConfirmDialog.astro";
import InlayRow from "@components/ui/InlayRow.astro";
---

<ConfirmDialog
  titleId="exit-modal-title"
  title="Leave game?"
  description={description}
  cancelLabel="Keep playing"
  confirmLabel="Leave game"
  onCancel="showExitModal = false"
  onConfirm="$dispatch('confirm-exit')"
  loadingExpr="$store.game.loading"
>
  <InlayRow
    slot="context"
    rowExpr="$store.game.contextRow($store.trainingSession.active ? $store.trainingSession.gameSessionId : undefined)"
  />
</ConfirmDialog>
