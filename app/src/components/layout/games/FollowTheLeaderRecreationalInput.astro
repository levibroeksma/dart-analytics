---
/**
 * Follow the Leader's tap pad: `RingKeyRow`, the numbers 1–20 on a
 * five-column grid, then a fixed BULL / MISS / STOP row. STOP stays in place
 * and is disabled until a dart has matched (`canStop()`). Treble cannot apply
 * to the bull, so BULL is disabled while T is armed. The target banner and
 * the Keep/Set prompt live in the interface, not here. Reads `canStop()`,
 * `ring` and `finished` from the surrounding play scope.
 */
interface Props {
  [key: string]: unknown;
}

// Props
const { ...props }: Props = Astro.props;

// Components
import InputButton from "./InputButton.astro";
import RingKeyRow from "./RingKeyRow.astro";
---

<div
  class="flex min-h-0 flex-1 flex-col"
  {...props}
>
  <RingKeyRow />
  <div class="grid min-h-0 flex-4 auto-rows-fr grid-cols-5 gap-2">
    <template
      x-for="n in 20"
      :key="n"
    >
      <InputButton
        class="text-2xl"
        :disabled="finished"
        @click="recordNumber(n)"
        x-text="n"
      />
    </template>
  </div>
  <div
    class="grid min-h-0 flex-1 grid-cols-3 gap-2"
    aria-live="polite"
  >
    <InputButton
      class="text-2xl uppercase"
      :disabled="finished || ring === 'TREBLE'"
      @click="recordBull()"
    >
      BULL
    </InputButton>
    <InputButton
      class="text-2xl text-soft-foreground"
      :disabled="finished"
      @click="recordMiss()"
    >
      MISS
    </InputButton>
    <InputButton
      class="text-2xl uppercase text-accent"
      aria-label="Stop throwing this visit"
      :disabled="finished || !canStop()"
      @click="stop()"
    >
      Stop
    </InputButton>
  </div>
</div>
