---
interface Props {
  label: string;
  leftValue: string;
  rightValue: string;
}
const { label, leftValue, rightValue }: Props = Astro.props;
---

<div class="grid grid-cols-[1fr_auto_1fr] items-center font-display-mono">
  <dd
    class="text-left font-mono text-sm font-bold tabular-nums text-foreground"
    x-text={leftValue}
  >
  </dd>
  <dt class="text-center text-sm text-muted-foreground">{label}</dt>
  <dd
    class="text-right font-mono text-sm font-bold tabular-nums text-foreground"
    x-text={rightValue}
  >
  </dd>
</div>
