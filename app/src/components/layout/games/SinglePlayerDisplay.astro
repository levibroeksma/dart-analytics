---
/**
 * Single-player score/target display with Alpine live binding.
 * @param {string} [score] Alpine expression for score text
 * @param {string} [target] Alpine expression for target text
 * @param {boolean} [isTarget] Show target vs score
 * @param {"lg" | "sm"} [size] Big-number size; "sm" fits the split scoreboard's narrower, shorter columns
 * @param {string} [activeExpr] Alpine expr; while true the card's border turns accent-colored instead of the default border color
 * @param {string} [class] Extra classes
 * @slot above Rendered inside the card, centered, directly above the big number
 */
interface Props {
  score?: string;
  target?: string;
  isTarget?: boolean;
  size?: "lg" | "sm";
  activeExpr?: string;
  class?: string;
}

// Props
const {
  score,
  target,
  isTarget = true,
  size = "lg",
  activeExpr,
  class: classNameProp = "",
}: Props = Astro.props;

// Lib
import { cn } from "@client/cn";

// Styles
const className = cn("flex-1 min-h-0 glass rounded-lg", classNameProp);
---

<div class={className}>
  <div
    class={cn(
      "rounded-lg border bg-surface-raised h-full mx-auto flex flex-col items-center justify-center",
      size === "sm" ? "p-2" : "p-3",
      activeExpr ? "" : "border-border",
    )}
    {...activeExpr
      ? { ":class": `(${activeExpr}) ? 'border-accent' : 'border-border'` }
      : {}}
  >
    <slot name="above" />
    <h1
      class={cn(
        "font-mono font-bold tabular-nums",
        size === "sm" ? "text-4xl" : "text-7xl",
      )}
      x-text={isTarget ? target : score}
    >
    </h1>
    <span class="text-sm text-muted-foreground uppercase">
      {isTarget ? "Target" : "Score"}
    </span>
    {
      /* Per-game progress region — e.g. 501's checkout route plus its
      darts/average/previous stats. Games with nothing to add pass no slot
      content and the region collapses. */
    }
    <slot name="progress" />
  </div>
</div>
