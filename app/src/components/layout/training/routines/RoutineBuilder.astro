---
/**
 * Builder body for create and edit. The page mounts `routineBuilder(mode)`;
 * this renders header inputs, the step list, the picker and the footer.
 * `maxNameLength` is bound from the factory's reactive state, not imported
 * in frontmatter (see `ExercisePicker.astro`'s note on why). The issue
 * list's `:key` is the array index, not the issue text: client
 * (`durationIssues()`) and server (`serverIssues`) can report
 * byte-identical strings once a save has failed and the user keeps editing.
 *
 * `onCancel` defaults to the page flow's `cancel()` (navigate away); a modal
 * host passes an expression that resets the form and closes the panel.
 */
interface Props {
  onCancel?: string;
}

// Props
const { onCancel = "cancel()" }: Props = Astro.props;

// Components
import Input from "@components/forms/Input.astro";
import Button from "@components/forms/Button.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import RoutineStepRow from "./RoutineStepRow.astro";
import ExercisePicker from "./ExercisePicker.astro";
---

<div class="space-y-6 shrink-0 flex flex-col">
  <ErrorAlert />
  <div class="space-y-2">
    <Input
      name="routine-name"
      placeholder="Routine name"
      :maxlength="maxNameLength"
      x-model="name"
    />
    <Input
      name="routine-description"
      placeholder="Description (optional)"
      maxlength="280"
      x-model="description"
    />
  </div>

  <section class="space-y-2">
    <h2 class="text-sm font-semibold text-foreground">Steps</h2>
    <p
      class="text-sm text-muted-foreground"
      x-show="steps.length === 0"
      x-cloak
    >
      No steps yet — add an exercise below.
    </p>
    <ol class="space-y-2">
      <template
        x-for="(step, index) in steps"
        :key="index"
      >
        <RoutineStepRow />
      </template>
    </ol>
  </section>

  <ExercisePicker />

  <div class="space-y-2">
    <div class="flex items-center justify-between text-sm">
      <span class="text-muted-foreground">Total</span>
      <span
        class="font-semibold text-foreground"
        x-text="`${totalMinutes()} min`"
      ></span>
    </div>
    <p
      class="text-xs text-muted-foreground"
      x-text="`A routine runs between ${minMinutes} and ${maxMinutes} minutes.`"
    >
    </p>
    <ul
      class="text-xs text-error"
      x-show="durationIssues().length > 0 || serverIssues.length > 0"
      x-cloak
    >
      <template
        x-for="(issue, index) in [...durationIssues(), ...serverIssues]"
        :key="index"
      >
        <li x-text="issue"></li>
      </template>
    </ul>
  </div>
  <div class="flex gap-2">
    <Button
      title="Cancel"
      variant="secondary"
      grow
      loadingExpr="false"
      x-on:click={onCancel}
    />
    <Button
      title="Save"
      variant="primary"
      grow
      :disabled="!canSave()"
      loadingExpr="saving"
      @click="save()"
    />
  </div>
</div>
