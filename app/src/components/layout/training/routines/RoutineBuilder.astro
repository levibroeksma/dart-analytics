---
/**
 * Builder body for create and edit. The page mounts `routineBuilder(mode)`;
 * this renders header inputs, the step list, the picker and the footer.
 * `maxNameLength` is bound from the factory's reactive state, not imported
 * in frontmatter (see `ExercisePicker.astro`'s note on why). The issue
 * list only shows once `attemptedSave` is set (the first `save()` call), so
 * a routine still under the 30-minute floor stays quiet while the draft is
 * still being built. Its `:key` is the array index, not the issue text:
 * client (`durationIssues()`) and server (`serverIssues`) can report
 * byte-identical strings once a save has failed and the user keeps editing.
 * The Save button itself is disabled only for the name/loading/id checks
 * (`saveDisabled()`) — duration and game-step violations stay clickable so
 * the click is what sets `attemptedSave` and surfaces the issue list.
 * The step list's `:key` is the step's draft key, which `x-sort` needs to
 * survive a drag: `index` would re-key every row on every reorder.
 *
 * `onCancel` defaults to the page flow's `cancel()` (navigate away); a modal
 * host passes an expression that resets the form and closes the panel.
 */
interface Props {
  onCancel?: string;
}

// Props
const { onCancel = "cancel()" }: Props = Astro.props;

// Components
import Input from "@components/forms/Input.astro";
import Button from "@components/forms/Button.astro";
import SheetActions from "@components/ui/SheetActions.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import RoutineStepRow from "./RoutineStepRow.astro";
import ExercisePicker from "./ExercisePicker.astro";
---

<div class="flex shrink-0 flex-col gap-3.5">
  <ErrorAlert />
  <div class="flex flex-col gap-2">
    <Input
      name="routine-name"
      placeholder="Routine name"
      :maxlength="maxNameLength"
      x-model="name"
      @input="clearServerIssues()"
      class="field-inset h-13 rounded-2xl border-0 placeholder:text-placeholder"
    />
    <Input
      name="routine-description"
      placeholder="Description (optional)"
      :maxlength="maxDescriptionLength"
      x-model="description"
      @input="clearServerIssues()"
      class="field-inset h-13 rounded-2xl border-0 placeholder:text-placeholder"
    />
  </div>

  <section class="flex flex-col gap-2.5">
    <div class="flex items-center justify-between px-1">
      <h2 class="font-display text-button text-foreground">Steps</h2>
      <span
        class="font-mono text-eyebrow font-semibold uppercase text-muted"
        x-text="`${steps.length} ${steps.length === 1 ? 'step' : 'steps'}`"
      >
      </span>
    </div>
    <p
      class="flex h-13 items-center rounded-2xl border border-dashed border-white/15 px-4 text-sm text-muted"
      x-show="steps.length === 0"
      x-cloak
    >
      No steps yet — add an exercise below.
    </p>
    <ol
      class="space-y-2"
      x-sort="moveStep($item, $position)"
      x-sort:config="{ animation: 150 }"
    >
      <template
        x-for="(step, index) in steps"
        :key="step.key"
      >
        <RoutineStepRow />
      </template>
    </ol>
    <p
      class="sr-only"
      aria-live="polite"
      x-text="moveAnnouncement"
    >
    </p>
  </section>

  <ExercisePicker />

  <div class="flex flex-col gap-2">
    <div
      class="inset-well flex h-13 items-center justify-between gap-3 rounded-2xl px-4"
    >
      <span class="flex flex-col gap-1">
        <span class="font-mono text-eyebrow font-semibold uppercase text-muted">
          Total
        </span>
        <span
          class="text-xs text-muted"
          x-text="`Runs ${minMinutes}–${maxMinutes} minutes`"
        >
        </span>
      </span>
      <span
        class="font-display text-lg leading-none tabular-nums text-foreground"
        x-text="`${totalMinutes()} min`"
      ></span>
    </div>
    <ul
      class="text-xs text-error"
      x-show="attemptedSave && (durationIssues().length > 0 || serverIssues.length > 0)"
      x-cloak
    >
      <template
        x-for="(issue, index) in [...durationIssues(), ...serverIssues]"
        :key="index"
      >
        <li x-text="issue"></li>
      </template>
    </ul>
  </div>
  <SheetActions>
    <Button
      title="Cancel"
      variant="sheet-muted"
      grow
      loadingExpr="false"
      x-on:click={onCancel}
    />
    <Button
      title="Save"
      variant="sheet-raised"
      grow
      :disabled="saveDisabled()"
      loadingExpr="saving"
      @click="save()"
    />
  </SheetActions>
</div>
