---
/**
 * Routine detail: page header (delete/edit actions for the player's own
 * routines), summary card, step list, Start. Reads `routineDetail()` state
 * from the parent scope (`routine-detail.data.ts`).
 */
import PageHeader from "@components/layout/PageHeader.astro";
import RoutineSummaryCard from "@components/layout/training/routines/RoutineSummaryCard.astro";
import RoutineStepList from "@components/layout/training/routines/RoutineStepList.astro";
import IconBtn from "@components/forms/IconBtn.astro";
import Button from "@components/forms/Button.astro";
import InlayRow from "@components/ui/InlayRow.astro";
import ConfirmDialog from "@components/ui/ConfirmDialog.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";

// Icons
import TrashIcon from "@icons/trash.svg";
import PencilIcon from "@icons/pencil.svg";
---

<div class="space-y-4">
  <PageHeader
    backHref="/training"
    backLabel="Back to training"
    title="Routine"
  >
    <template
      slot="actions"
      x-if="canEdit()"
    >
      <div class="flex gap-2">
        <IconBtn
          variant="destructive"
          ariaLabel="Delete routine"
          class="size-10"
          @click="requestDelete()"
        >
          <TrashIcon class="size-5" />
        </IconBtn>
        <IconBtn
          variant="glass"
          ariaLabel="Edit routine"
          class="size-10"
          @click="navigate(editPath())"
        >
          <PencilIcon class="size-5" />
        </IconBtn>
      </div>
    </template>
  </PageHeader>
  <ErrorAlert />
  <template x-if="routine">
    <div class="space-y-4">
      <RoutineSummaryCard />
      <RoutineStepList />
      <Button
        title="Start"
        variant="primary"
        grow
        @click="start()"
        loadingExpr="starting"
      />
    </div>
  </template>
  <div
    x-show="deleting"
    x-cloak
  >
    <ConfirmDialog
      titleId="routine-delete-title"
      title="Delete this routine?"
      description="Completed sessions keep their own record. The routine itself is removed."
      cancelLabel="Keep routine"
      confirmLabel="Delete"
      confirmVariant="sheet-destructive"
      onCancel="cancelDelete()"
      onConfirm="confirmDelete()"
      loadingExpr="deleteBusy"
    >
      <InlayRow
        slot="context"
        parts={[
          "routine?.routineName",
          "`${routine?.steps.length} ${routine?.steps.length === 1 ? 'step' : 'steps'}`",
        ]}
        valueExpr="durationLabel()"
      />
    </ConfirmDialog>
  </div>
</div>
