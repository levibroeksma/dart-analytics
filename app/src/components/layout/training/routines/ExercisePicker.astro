---
/**
 * The exercise catalog as one `CatalogCard variant="exercise"` per type
 * (`routineBuilder().groups()`): name, blurb and tags, with a config well
 * holding one row per template (difficulty meter, label, level name and a
 * `+` button). Tapping `+` appends a step (`routineBuilder().addStep`) and
 * does nothing else. Reads `groups()`/`steps`/`maxSteps` from the parent
 * scope (`maxSteps` is `routineBuilder()`'s reactive mirror of
 * `MAX_BUILDER_STEPS`, not a frontmatter import — see the note below).
 * The `+` is hand-rolled per `components/CLAUDE.md`'s "multi-part custom
 * control a shared primitive cannot express as-is" exemption (precedent:
 * `AppModeForm.astro`): each button needs a per-row dynamic `aria-label` and
 * disabled state, and `Button.astro` offers neither an Alpine-bindable label
 * nor a bindable disabled state.
 *
 * Bounds always cross this boundary as directive-string reads of the
 * factory's own reactive state (`:disabled="... maxSteps"` below), never as
 * a frontmatter import of a value from `routine-builder.data.ts`: that
 * module is browser-only (`globalThis.location`, `fetch` via
 * `@client/api/*`), and an `.astro` frontmatter import would run it during
 * SSR/prerendering instead.
 */

// Components
import CatalogCard from "@components/ui/CatalogCard.astro";
import DifficultyLegend from "@components/ui/DifficultyLegend.astro";
import DifficultyMeter from "@components/ui/DifficultyMeter.astro";
import Tag from "@components/ui/Tag.astro";

// Icons
import PlusIcon from "@icons/plus.svg";

// Lib
import { DIFFICULTY_LEVEL_NAMES } from "@lib/catalog/difficulty";

// Styles
const levelNameExpr = `entry.level ? (${JSON.stringify(DIFFICULTY_LEVEL_NAMES)})[entry.level - 1] : ''`;
---

<section class="flex flex-col gap-2.5">
  <div class="flex items-center justify-between px-1">
    <h2 class="font-display text-control text-foreground">Add an exercise</h2>
    <span
      class="font-mono text-eyebrow font-semibold uppercase text-muted"
      x-text="`${groups().length} ${groups().length === 1 ? 'type' : 'types'}`"
    >
    </span>
  </div>
  <div class="px-1">
    <DifficultyLegend />
  </div>
  <div class="catalog-grid grid items-start gap-3">
    <template
      x-for="group in groups()"
      :key="group.key"
    >
      <CatalogCard variant="exercise">
        <span
          slot="title"
          x-text="group.name"
        ></span>
        <span
          slot="caption"
          x-text="group.blurb ?? ''"
        ></span>
        <template
          slot="tags"
          x-for="tag in group.tags"
          :key="tag.key"
        >
          <Tag
            nameExpr="tag.name"
            axisExpr="tag.axis"
            primaryExpr="tag.primary"
          />
        </template>
        <div class="catalog-well">
          <template
            x-for="entry in group.entries"
            :key="entry.exerciseTemplateId"
          >
            <div
              class="flex min-h-12 items-center gap-3 border-t border-white/8 first:border-t-0"
            >
              <DifficultyMeter levelExpr="entry.level" />
              <span
                class="min-w-0 flex-1 truncate font-display text-sm font-semibold text-foreground"
                x-text="entry.label"
              ></span>
              <span
                class="font-mono text-eyebrow font-medium text-muted"
                x-text={levelNameExpr}
              ></span>
              <button
                type="button"
                class="glass-button flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-foreground disabled:cursor-not-allowed disabled:opacity-40"
                :aria-label="`Add ${entry.label}`"
                :disabled="steps.length >= maxSteps"
                @click="addStep(entry)"
              >
                <PlusIcon class="size-3.5" />
              </button>
            </div>
          </template>
        </div>
      </CatalogCard>
    </template>
  </div>
</section>
