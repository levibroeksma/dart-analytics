---
/**
 * Routine builder inside `ExpandingModal` — the create flow itself (the
 * `/training/routines/new` page is retired) and the modal form for `/edit`.
 * It mounts its own
 * `routineBuilder(mode)` scope *around* the modal, not inside its slot, so
 * every close path — Cancel, the toggle, Escape — can reach `resetForm()`;
 * `edit` still reads its routine id from `?routine=` like the page does.
 *
 * Closing discards the draft rather than navigating: `cancel()`'s
 * `navigate()` would reload the host page out from under the panel.
 * @param {"create"|"edit"} [mode="create"]
 * @param {string} openExpr Alpine expression, true while the panel is open
 * @param {string} [titleId] Stable unique heading id for this call site
 */
interface Props {
  mode?: "create" | "edit";
  openExpr: string;
  titleId?: string;
}

// Props
const {
  mode = "create",
  openExpr,
  titleId = `routine-form-modal-${mode}`,
}: Props = Astro.props;

// Components
import ExpandingModal from "@components/ui/ExpandingModal.astro";
import RoutineBuilder from "./RoutineBuilder.astro";

// Data
const title = mode === "edit" ? "Edit routine" : "New routine";
const close = `(${openExpr} = false, resetForm())`;
const toggle = `${openExpr} ? ${close} : ${openExpr} = true`;
---

<div x-data={`routineBuilder('${mode}')`}>
  <ExpandingModal
    openExpr={openExpr}
    onToggle={toggle}
    onClose={close}
    title={title}
    titleId={titleId}
    toggleLabelClosed={title}
    toggleLabelOpen="Close"
  >
    <div class="shrink-0 space-y-4">
      <RoutineBuilder onCancel={close} />
    </div>
  </ExpandingModal>
</div>
