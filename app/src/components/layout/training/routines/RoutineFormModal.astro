---
/**
 * Routine builder inside `ExpandingModal` — the modal replacement for the
 * `/training/routines/new` and `/edit` pages. It mounts its own
 * `routineBuilder(mode)` scope, so a host page only owns the open flag;
 * `edit` still reads its routine id from `?routine=` like the page does.
 * @param {"create"|"edit"} [mode="create"]
 * @param {string} openExpr Alpine expression, true while the panel is open
 * @param {string} onToggle Alpine expression run by the toggle
 * @param {string} onClose Alpine expression run on Escape
 * @param {string} [titleId] Stable unique heading id for this call site
 */
interface Props {
  mode?: "create" | "edit";
  openExpr: string;
  onToggle: string;
  onClose: string;
  titleId?: string;
}

// Props
const {
  mode = "create",
  openExpr,
  onToggle,
  onClose,
  titleId = `routine-form-modal-${mode}`,
}: Props = Astro.props;

// Components
import ExpandingModal from "@components/ui/ExpandingModal.astro";
import RoutineBuilder from "./RoutineBuilder.astro";

// Data
const title = mode === "edit" ? "Edit routine" : "New routine";
---

<ExpandingModal
  openExpr={openExpr}
  onToggle={onToggle}
  onClose={onClose}
  title={title}
  titleId={titleId}
  toggleLabelClosed={title}
  toggleLabelOpen="Close"
>
  <div
    class="shrink-0 space-y-4"
    x-data={`routineBuilder('${mode}')`}
  >
    <RoutineBuilder />
  </div>
</ExpandingModal>
