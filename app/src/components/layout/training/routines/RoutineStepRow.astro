---
/**
 * One builder step: position, exercise name, minutes input, move/remove.
 * Reads `step`/`index` from the enclosing `x-for` and the builder's helpers,
 * including its `stepMinMinutes`/`stepMaxMinutes` reactive bounds (bound via
 * `:min`/`:max` — see `ExercisePicker.astro`'s note on why a bound crosses
 * this boundary as a directive-string read, never a frontmatter import, of
 * the browser-only `routine-builder.data.ts`).
 * A GAME step (`step.exerciseTypeKey === 'GAME'`) additionally shows a
 * "3–30 min" hint: every routine-eligible ruleset's own MINUTES bound
 * (`ROUTINE_GAME_STEPS` in `app/src/services/routines/game-step.ts`) is
 * 3–30, so one literal covers TUOD, Score Training and 121 alike. This is
 * UI hint text only, static and not derived from `stepMinMinutes`/
 * `stepMaxMinutes` (the builder-wide 1–60 bounds the `:min`/`:max` above
 * bind to) — the authoritative bound is the server's per-step check in
 * `routine.service.ts`.
 * Only `chevron-down.svg` and `cross.svg` exist under `app/src/icons/` for
 * this purpose — "move up" is `chevron-down` rotated 180deg, "move down" is
 * `chevron-down` unrotated, "remove" is `cross`.
 */
import Input from "@components/forms/Input.astro";
import IconBtn from "@components/forms/IconBtn.astro";
import ChevronDownIcon from "@icons/chevron-down.svg";
import CrossIcon from "@icons/cross.svg";
---

<li class="flex items-center gap-2 rounded-md border border-border p-2">
  <span
    class="w-6 text-sm font-semibold text-accent"
    x-text="index + 1"
  ></span>
  <span class="flex-1 min-w-0">
    <span
      class="block text-sm text-foreground"
      x-text="step.name"
    ></span>
    <span
      class="block text-xs text-muted-foreground"
      x-show="step.exerciseTypeKey === 'GAME'"
      x-cloak
    >
      3–30 min
    </span>
  </span>
  <Input
    type="number"
    class="w-16 text-center"
    :min="stepMinMinutes"
    :max="stepMaxMinutes"
    inputmode="numeric"
    :value="step.durationValue"
    @change="setMinutes(index, $event.target.valueAsNumber)"
    aria-label="Minutes"
  />
  <span class="text-xs text-muted-foreground">min</span>
  <IconBtn
    variant="ghost"
    class="p-1.5"
    ariaLabel="Move up"
    :disabled="index === 0"
    @click="moveUp(index)"
  >
    <ChevronDownIcon class="rotate-180" />
  </IconBtn>
  <IconBtn
    variant="ghost"
    class="p-1.5"
    ariaLabel="Move down"
    :disabled="index === steps.length - 1"
    @click="moveDown(index)"
  >
    <ChevronDownIcon />
  </IconBtn>
  <IconBtn
    variant="ghost"
    class="p-1.5"
    ariaLabel="Remove step"
    @click="removeStep(index)"
  >
    <CrossIcon />
  </IconBtn>
</li>
