---
/**
 * One builder step: drag handle, exercise name, minutes input, remove.
 * Reads `step`/`index` from the enclosing `x-for` and the builder's helpers,
 * including its `stepMinMinutes`/`stepMaxMinutes` reactive bounds (bound via
 * `:min`/`:max` — see `ExercisePicker.astro`'s note on why a bound crosses
 * this boundary as a directive-string read, never a frontmatter import, of
 * the browser-only `routine-builder.data.ts`).
 *
 * Ordering is by drag or keyboard: `x-sort:item` publishes the step's draft
 * key to the `x-sort` handler on the parent `<ol>`, and `x-sort:handle`
 * confines the drag to the grip so the minutes input stays usable. The grip
 * is a focusable button; ArrowUp/ArrowDown call `nudgeStep` and refocus it,
 * since the keyed row is moved in the DOM. The key is the step's own, not
 * `index`, because a routine may hold the same exercise twice.
 *
 * A GAME step (`step.exerciseTypeKey === 'GAME'`) additionally shows a
 * "3–30 min" hint: every routine-eligible ruleset's own MINUTES bound
 * (`ROUTINE_GAME_STEPS` in `app/src/services/routines/game-step.ts`) is
 * 3–30, so one literal covers TUOD, Score Training and 121 alike. The hint
 * is static; the input's `:min`/`:max` come from the builder's `stepMinFor`/
 * `stepMaxFor`, which narrow a GAME step to that bound. The authoritative
 * bound is the server's per-step check in `routine.service.ts`.
 */
import Input from "@components/forms/Input.astro";
import IconBtn from "@components/forms/IconBtn.astro";
import GripIcon from "@icons/grip.svg";
import CrossIcon from "@icons/cross.svg";
---

<li
  class="inset-well flex items-center gap-2 rounded-2xl p-2"
  x-sort:item="step.key"
>
  <IconBtn
    variant="ghost"
    class="shrink-0 cursor-grab p-1.5 active:cursor-grabbing"
    ariaLabel="Reorder step, drag or use arrow up and down"
    x-sort:handle=""
    @keydown.up.prevent="nudgeStep(step.key, -1); $nextTick(() => $el.focus())"
    @keydown.down.prevent="nudgeStep(step.key, 1); $nextTick(() => $el.focus())"
  >
    <GripIcon />
  </IconBtn>
  <span class="min-w-0 flex-1">
    <span
      class="block truncate text-sm text-foreground"
      x-text="step.name"
    ></span>
    <span
      class="block text-xs text-muted-foreground"
      x-show="step.exerciseTypeKey === 'GAME'"
      x-cloak
    >
      3–30 min
    </span>
  </span>
  <Input
    type="number"
    class="w-16 text-center"
    :min="stepMinFor(step)"
    :max="stepMaxFor(step)"
    inputmode="numeric"
    :value="step.durationValue"
    @change="setMinutes(index, $event.target.valueAsNumber)"
    aria-label="Minutes"
  />
  <span class="text-xs text-muted-foreground">min</span>
  <IconBtn
    variant="ghost"
    class="p-1.5"
    ariaLabel="Remove step"
    @click="removeStep(index)"
  >
    <CrossIcon />
  </IconBtn>
</li>
