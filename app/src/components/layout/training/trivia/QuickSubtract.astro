---
// Components
import ScoreInput from "@components/layout/games/ScoreInput.astro";
import Button from "@components/forms/Button.astro";
import Modal from "@components/ui/Modal.astro";
import SheetActions from "@components/ui/SheetActions.astro";
import StatTile from "@components/layout/games/StatTile.astro";
import Toggle from "@components/layout/games/setup/Toggle.astro";
import Input from "@components/forms/Input.astro";
import SettingSectionShell from "@components/layout/games/setup/SettingSectionShell.astro";
import StatRow from "@components/layout/games/StatRow.astro";
import SinglePlayerDisplay from "@components/layout/games/SinglePlayerDisplay.astro";

// Data
const modeOptions = [
  { value: "count", label: "Fixed Count" },
  { value: "timer", label: "Timer" },
];
---

<div
  class="flex flex-col flex-1 min-h-0"
  x-data="{ mode: 'count', count: 20, minutes: 5 }"
>
  <div
    class="flex flex-col gap-4"
    x-show="status === 'idle'"
    x-cloak
  >
    <SettingSectionShell>
      <Toggle
        orientation="horizontal"
        options={modeOptions}
        x-model="mode"
        class="w-full"
      />
      <template x-if="mode === 'count'">
        <div class="contents">
          <Input
            id="count"
            name="count"
            type="text"
            inputmode="numeric"
            x-model.number="count"
            class="glass border-tab-border rounded-full mt-4"
          />
          <label
            for="count"
            class="text-xs text-muted-foreground px-4 py-0 italic"
          >
            Correct answers to finish (10–100)
          </label>
        </div>
      </template>
      <template x-if="mode === 'timer'">
        <div class="contents">
          <Input
            id="minutes"
            name="minutes"
            type="text"
            inputmode="numeric"
            x-model.number="minutes"
            class="glass border-tab-border rounded-full mt-4"
          />
          <label
            for="minutes"
            class="text-xs text-muted-foreground px-4 py-0 italic"
          >
            Minutes (1–15)
          </label>
        </div>
      </template>
    </SettingSectionShell>
    <Button
      type="button"
      variant="primary"
      title="Start"
      class="rounded-full w-full"
      @click="mode === 'count' ? startCount(count) : startTimer(minutes)"
    />
  </div>

  <div
    class="flex flex-col flex-1 min-h-0 gap-3"
    x-show="status === 'running'"
    x-cloak
  >
    <SinglePlayerDisplay
      isTarget={false}
      score="current?.expression ?? ''"
    >
      <div
        slot="above"
        class="text-sm text-muted-foreground tabular-nums"
        x-text="mode === 'count' ? formattedElapsed() : formattedRemaining()"
      >
      </div>
      <div
        slot="progress"
        class="mt-2 flex w-full flex-col items-center gap-2 px-4"
      >
        <dl class="w-full space-y-1">
          <StatRow
            label="Correct"
            value="correctAnswers"
          />
          <StatRow
            label="Incorrect"
            value="incorrectAnswers"
          />
        </dl>
      </div>
    </SinglePlayerDisplay>
    <ScoreInput
      value="scoreInput.value"
      digitHandler="scoreInput.appendDigit"
      onDelete="scoreInput.deleteLast($event)"
      onSubmit="submit()"
    />
  </div>

  <div
    x-show="status === 'finished'"
    x-cloak
  >
    <Modal
      titleId="quick-subtract-results-title"
      dismissible={false}
      overline="Trivia"
    >
      <h2
        slot="header"
        id="quick-subtract-results-title"
        class="text-balance font-display text-xl text-foreground"
      >
        Session complete
      </h2>
      <dl class="grid w-full grid-cols-2 gap-2">
        <StatTile
          labelExpr="'Correct'"
          valueExpr="correctAnswers"
        />
        <StatTile
          labelExpr="'Incorrect'"
          valueExpr="incorrectAnswers"
        />
        <StatTile
          labelExpr="'Attempts'"
          valueExpr="attempts"
        />
        <StatTile
          labelExpr="'Time'"
          valueExpr="formattedElapsed()"
        />
      </dl>
      <SheetActions slot="footer">
        <Button
          type="button"
          variant="sheet-muted"
          title="Back to Trivia"
          @click="exit()"
          grow
        />
        <Button
          type="button"
          variant="sheet-raised"
          title="Play again"
          @click="reset()"
          grow
        />
      </SheetActions>
    </Modal>
  </div>
</div>
