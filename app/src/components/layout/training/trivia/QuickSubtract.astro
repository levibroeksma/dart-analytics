---
// Components
import ScoreInput from "@components/layout/games/ScoreInput.astro";
import Button from "@components/forms/Button.astro";
import Toggle from "@components/layout/games/setup/Toggle.astro";
import Input from "@components/forms/Input.astro";
import SettingSectionShell from "@components/layout/games/setup/SettingSectionShell.astro";
import StatRow from "@components/layout/games/StatRow.astro";
import SinglePlayerDisplay from "@components/layout/games/SinglePlayerDisplay.astro";

// Data
const modeOptions = [
  { value: "count", label: "Fixed Count" },
  { value: "timer", label: "Timer" },
];
---

<div
  class="flex flex-col flex-1 min-h-0"
  x-data="{ mode: 'count', count: 20, minutes: 5 }"
>
  <div
    class="flex flex-col gap-4"
    x-show="status === 'idle'"
    x-cloak
  >
    <SettingSectionShell>
      <Toggle
        orientation="horizontal"
        options={modeOptions}
        x-model="mode"
        class="w-full"
      />
      <template x-if="mode === 'count'">
        <div class="contents">
          <Input
            id="count"
            name="count"
            type="text"
            inputmode="numeric"
            x-model.number="count"
            class="glass border-tab-border rounded-full mt-4"
          />
          <label
            for="count"
            class="text-xs text-muted-foreground px-4 py-0 italic"
          >
            Correct answers to finish (10–100)
          </label>
        </div>
      </template>
      <template x-if="mode === 'timer'">
        <div class="contents">
          <Input
            id="minutes"
            name="minutes"
            type="text"
            inputmode="numeric"
            x-model.number="minutes"
            class="glass border-tab-border rounded-full mt-4"
          />
          <label
            for="minutes"
            class="text-xs text-muted-foreground px-4 py-0 italic"
          >
            Minutes (1–15)
          </label>
        </div>
      </template>
    </SettingSectionShell>
    <Button
      type="button"
      variant="primary"
      title="Start"
      class="rounded-full w-full"
      @click="mode === 'count' ? startCount(count) : startTimer(minutes)"
    />
  </div>

  <div
    class="flex flex-col flex-1 min-h-0 gap-3"
    x-show="status === 'running'"
    x-cloak
  >
    <SinglePlayerDisplay
      isTarget={false}
      score="current?.expression ?? ''"
      fluid
      class="max-h-2/5 h-full"
    >
      <div
        slot="above"
        class="text-sm text-muted-foreground tabular-nums"
        x-text="mode === 'count' ? formattedElapsed() : formattedRemaining()"
      >
      </div>
      <div
        slot="progress"
        class="mt-2 flex w-full flex-col items-center gap-2 px-4"
      >
        <dl class="w-full space-y-1">
          <StatRow
            label="Correct"
            value="correctAnswers"
          />
          <StatRow
            label="Incorrect"
            value="incorrectAnswers"
          />
        </dl>
      </div>
    </SinglePlayerDisplay>
    <ScoreInput
      value="scoreInput.value"
      digitHandler="scoreInput.appendDigit"
      onDelete="scoreInput.deleteLast($event)"
      onSubmit="submit()"
    />
  </div>

  <div
    class="fixed inset-0 flex items-center justify-center bg-black/50 z-50 w-full p-4"
    x-show="status === 'finished'"
    x-cloak
  >
    <div
      class="glass rounded-lg border border-border bg-surface-raised p-6 shadow-lg max-w-sm w-full"
    >
      <h2 class="font-display text-lg font-semibold text-foreground">
        Session complete
      </h2>
      <dl class="mt-4 space-y-1 text-sm text-muted-foreground flex flex-col">
        <StatRow
          label="Correct"
          value="correctAnswers"
        />
        <StatRow
          label="Incorrect"
          value="incorrectAnswers"
        />
        <StatRow
          label="Attempts"
          value="attempts"
        />
        <StatRow
          label="Time"
          value="formattedElapsed()"
        />
      </dl>
      <div class="mt-6 flex gap-3">
        <Button
          type="button"
          variant="secondary"
          title="Back to Trivia"
          @click="exit()"
          grow
        />
        <Button
          type="button"
          title="Play again"
          @click="reset()"
          grow
        />
      </div>
    </div>
  </div>
</div>
