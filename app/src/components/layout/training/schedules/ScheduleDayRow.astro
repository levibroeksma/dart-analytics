---
/**
 * One weekday row in `ScheduleEditor.astro`: the weekday label and a
 * routine picker. Reads `row`/`index` from the enclosing `x-for` and
 * `routineOptions()`/`weekdayLabel()` from `scheduleEditor()`.
 *
 * The picker's "Rest" option's value is `null`, matching a freshly-created
 * rest row; `schedule-editor.data.ts`'s `payload()` treats any falsy
 * `routineTemplateId` as rest.
 */
import Select from "@components/forms/Select.astro";
---

<li class="flex items-center gap-3">
  <span
    class="w-24 shrink-0 text-sm font-semibold text-foreground"
    x-text="weekdayLabel(index)"
  ></span>
  <Select
    class="min-w-0 flex-1"
    model="row.routineTemplateId"
    optionsExpr="routineOptions()"
    ariaLabel="Routine"
  />
</li>
