---
/**
 * `/training`'s "Today" card: the active schedule's routine for today (or
 * rest), with a Start button and a link to the schedules list. Mounted by
 * `todayCard()` on the page; the card is hidden entirely when the player has
 * no active schedule.
 *
 * The error alert sits outside that gate on purpose: `todayCard()` sets
 * `error` only where the load threw, and that path leaves `schedule` null,
 * so an alert inside the gate could never render.
 */
import CardWrapper from "@components/ui/CardWrapper.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/forms/Button.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
---

<ErrorAlert class="mb-2" />
<div
  x-show="schedule"
  x-cloak
>
  <CardWrapper class="gap-3 glass">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-muted-foreground">
        Today &middot; <span x-text="schedule?.name"></span>
      </h2>
      <a
        href="/training/schedules"
        class="text-xs text-accent"
      >
        Schedules
      </a>
    </div>
    <div class="flex items-center justify-between gap-4">
      <div class="flex flex-col gap-0.5">
        <p
          class="font-semibold text-base text-foreground"
          x-show="!isRestDay()"
          x-cloak
          x-text="entry()?.routineName"
        >
        </p>
        <p
          class="font-semibold text-base text-foreground"
          x-show="isRestDay()"
          x-cloak
        >
          Rest day
        </p>
        <Badge
          class="text-xs w-fit"
          x-show="!isRestDay()"
          x-cloak
          x-text="`${entry()?.routineMinutes} min`"
        />
      </div>
      <Button
        title="Start"
        variant="primary"
        x-show="!isRestDay()"
        x-cloak
        @click="start()"
      />
    </div>
  </CardWrapper>
</div>
