---
/**
 * "My schedule" card in its own `trainingWeek()` scope, shared by `/` and
 * `/training`: the week's done/missed/to-go line (or the intro copy without a
 * schedule), the status strip, and the page's own round action button in the
 * `action` slot.
 */

// Components
import ScheduleStrip from "@components/layout/training/schedules/ScheduleStrip.astro";
---

<section
  class="glass flex flex-col gap-3.5 rounded-2xl p-4 shadow-none"
  x-data="trainingWeek()"
  @schedule-saved.window="applySaved($event.detail)"
>
  <div class="flex items-center justify-between gap-3">
    <div class="flex flex-col gap-1.5">
      <h2 class="font-display text-[13px]/[normal] tracking-[0.06em]">
        My schedule
      </h2>
      <div
        class="h-[18px] w-40 animate-pulse rounded-md bg-white/12"
        x-show="loading"
        x-cloak
        aria-hidden="true"
      >
      </div>
      <p
        class="text-xs/normal text-pretty text-muted"
        x-show="!loading && hasSchedule()"
        x-cloak
      >
        <span x-text="`${counts().done} done · `"></span><span
          class="text-missed"
          x-text="`${counts().missed} missed`"
        ></span><span x-text="` · ${counts().toGo} to go`"></span>
      </p>
      <p
        class="text-xs/normal text-pretty text-muted"
        x-show="!loading && !hasSchedule()"
        x-cloak
      >
        Plan your weekly routine to get your game to the next level. Don't
        forget to build in some recovery!
      </p>
    </div>
    <slot name="action" />
  </div>
  <ScheduleStrip />
</section>
