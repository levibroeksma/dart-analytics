---
/**
 * "My schedule" editor inside a detached `ExpandingModal`, opened from the
 * `/training` schedule card. Mounts its own `myScheduleForm()` scope around
 * the modal so every close path can reach `resetForm()`. The seven weekday
 * circles pick the day to edit; the routine list below assigns (or clears)
 * that day's routine. Save closes the panel once `save()` resolves `true`.
 * @param {string} openExpr Alpine expression, true while the panel is open
 * @param {string} [titleId] Stable unique heading id for this call site
 */
interface Props {
  openExpr: string;
  titleId?: string;
}

// Props
const { openExpr, titleId = "schedule-form-modal" }: Props = Astro.props;

// Components
import ExpandingModal from "@components/ui/ExpandingModal.astro";
import Button from "@components/forms/Button.astro";
import SheetActions from "@components/ui/SheetActions.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";

// Icons
import CheckIcon from "@icons/check.svg";

// Data
const title = "My schedule";
const close = `(${openExpr} = false, resetForm())`;
const toggle = `${openExpr} ? ${close} : ${openExpr} = true`;
const saveAndClose = `(await save()) && (${openExpr} = false)`;
---

<div x-data="myScheduleForm()">
  <ExpandingModal
    openExpr={openExpr}
    onToggle={toggle}
    onClose={close}
    title={title}
    titleId={titleId}
    toggleLabelClosed={title}
    toggleLabelOpen="Close"
    overline="Training"
    detached
  >
    <div class="shrink-0 space-y-6">
      <ErrorAlert />
      <div
        class="inset-well grid grid-cols-7 gap-1.5 rounded-full p-1.5"
        role="group"
        aria-label="Day to edit"
      >
        <template
          x-for="index in [0, 1, 2, 3, 4, 5, 6]"
          :key="index"
        >
          <button
            type="button"
            class="flex h-10 cursor-pointer flex-col items-center justify-center gap-[3px] rounded-full text-sm font-semibold uppercase transition-[color,background-color] duration-150"
            :class="selectedIndex === index ? 'glass-button text-foreground' : (hasRoutine(index) ? 'text-foreground' : 'text-muted')"
            :aria-pressed="selectedIndex === index"
            :aria-label="dayLabel(index)"
            @click="selectDay(index)"
          >
            <span x-text="dayInitial(index)"></span>
            <span
              class="size-1 rounded-full"
              :class="hasRoutine(index) ? 'bg-accent' : 'bg-transparent'"
            ></span>
          </button>
        </template>
      </div>

      <section class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between px-1">
          <h2
            class="font-display text-button text-foreground"
            x-text="selectedDayLabel()"
          >
          </h2>
          <span
            class="font-mono text-eyebrow font-semibold uppercase text-muted"
            x-text="hasRoutine(selectedIndex) ? '1 routine' : 'Rest'"
          >
          </span>
        </div>
        <ul class="flex flex-col gap-2">
          <template
            x-for="routine in routines"
            :key="routine.routineId"
          >
            <li>
              <button
                type="button"
                class="flex h-16 w-full cursor-pointer items-center justify-between gap-3 rounded-2xl px-4 text-left"
                :class="isRoutineSelected(routine) ? 'bg-linear-to-b from-accent/18 to-accent/4 ring-1 ring-inset ring-accent/45' : 'inset-well'"
                :aria-pressed="isRoutineSelected(routine)"
                @click="toggleRoutine(routine)"
              >
                <span class="flex min-w-0 flex-col gap-1">
                  <span
                    class="truncate font-display text-sm"
                    :class="isRoutineSelected(routine) ? 'text-foreground' : 'text-soft-foreground'"
                    x-text="routine.routineName"
                  ></span>
                  <span
                    class="font-mono text-eyebrow font-semibold uppercase text-muted"
                    x-text="`${routine.totalMinutes} min · ${routine.stepCount} ${routine.stepCount === 1 ? 'step' : 'steps'}`"
                  ></span>
                </span>
                <span
                  class="flex size-6 shrink-0 items-center justify-center rounded-full"
                  :class="isRoutineSelected(routine) ? 'bg-accent text-accent-foreground' : 'border-[1.5px] border-white/20'"
                >
                  <span
                    class="flex"
                    x-show="isRoutineSelected(routine)"
                    x-cloak
                  >
                    <CheckIcon class="size-3.5" />
                  </span>
                </span>
              </button>
            </li>
          </template>
        </ul>
      </section>

      <ul
        class="text-xs text-error"
        x-show="serverIssues.length > 0"
        x-cloak
      >
        <template
          x-for="(issue, index) in serverIssues"
          :key="index"
        >
          <li x-text="issue"></li>
        </template>
      </ul>

      <p
        class="text-xs text-muted-foreground"
        x-show="!loading && !canSave() && !saving"
        x-cloak
      >
        Assign a routine to at least one day to save.
      </p>

      <SheetActions>
        <Button
          title="Cancel"
          variant="sheet-muted"
          grow
          loadingExpr="false"
          @click={close}
        />
        <Button
          title="Save"
          variant="sheet-raised"
          grow
          :disabled="!canSave()"
          loadingExpr="saving"
          @click={saveAndClose}
        />
      </SheetActions>
    </div>
  </ExpandingModal>
</div>
