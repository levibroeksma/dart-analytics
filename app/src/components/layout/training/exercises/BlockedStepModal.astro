---
/**
 * Presentational — the routine's play page owns `blockingSession` (x-if).
 * Shown when an unfinished Ten Up One Down game blocks the Finishing step:
 * abandoning it resumes the routine where it stands, so a forgotten game no
 * longer costs the whole run (issue #357). Not `ContinueSessionModal` — its
 * Continue action leaves for that game, which is the dead end here.
 */

// Components
import Modal from "@components/ui/Modal.astro";
import Button from "@components/forms/Button.astro";
import SheetActions from "@components/ui/SheetActions.astro";
import InlayRow from "@components/ui/InlayRow.astro";
---

<Modal
  titleId="blocked-step-title"
  descriptionId="blocked-step-desc"
  dismissible={false}
  overline="Routine"
>
  <h2
    slot="header"
    id="blocked-step-title"
    class="text-balance font-display text-xl text-foreground"
  >
    Unfinished game
  </h2>
  <p
    slot="header"
    id="blocked-step-desc"
    class="text-pretty text-sm text-muted-foreground"
  >
    A Ten Up One Down game
    <span
      x-show="blockingStartedLabel()"
      x-cloak
      >from <span x-text="blockingStartedLabel()"></span></span
    > is still open, so this step cannot start. Abandon it to play your Finishing
    step now.
  </p>
  <InlayRow parts={["'Ten Up One Down'", "blockingStartedLabel()"]} />
  <p
    class="text-center text-sm text-error"
    x-show="blockingError"
    x-text="blockingError"
    x-cloak
  >
  </p>

  <SheetActions slot="footer">
    <Button
      type="button"
      variant="sheet-muted"
      title="Leave"
      @click="abandonAndExit()"
      :disabled="resolvingBlockingSession"
      grow
    />
    <Button
      type="button"
      variant="sheet-raised"
      title="Continue"
      @click="resolveBlockingSession()"
      loadingExpr="resolvingBlockingSession"
      :disabled="resolvingBlockingSession"
      grow
    />
  </SheetActions>
</Modal>
