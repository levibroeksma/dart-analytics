---
import DartBoard from "@components/ui/DartBoard.astro";
import Button from "@components/forms/Button.astro";
---

<div class="flex flex-1 min-h-0 flex-col items-center justify-center gap-4 p-4">
  <template x-if="!warmUpReady">
    <div class="flex flex-col items-center gap-4">
      <p class="text-2xl font-semibold text-foreground">Are you ready?</p>
      <Button
        title="Let's play!"
        @click="confirmWarmUpReady()"
      />
    </div>
  </template>

  <template x-if="warmUpReady">
    <div class="flex flex-col items-center gap-4">
      <p
        class="text-2xl font-semibold text-foreground tabular-nums"
        x-text="formattedWarmUpElapsed()"
      >
      </p>
      <DartBoard
        highlightPathExpr="warmUpHighlightPath()"
        class="max-w-xs"
      />
    </div>
  </template>
</div>
