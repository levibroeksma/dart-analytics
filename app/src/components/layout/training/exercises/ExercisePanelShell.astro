---
/**
 * Solo exercise panel: score card with a `StatRow` column, the visit
 * preview and the exercise board input. A closing "Time" row is always added.
 * @param {string} score Alpine expression for the big value
 * @param {object[]} rows `{ label, value, showExpr? }`; `showExpr` hides the row until truthy
 */
interface Row {
  label: string;
  value: string;
  showExpr?: string;
}

interface Props {
  score: string;
  rows: Row[];
}

// Props
const { score, rows }: Props = Astro.props;

// Components
import SinglePlayerDisplay from "@components/layout/games/SinglePlayerDisplay.astro";
import VisitPreview from "@components/layout/games/VisitPreview.astro";
import StatRow from "@components/layout/games/StatRow.astro";
import ExerciseBoardInputPanel from "./ExerciseBoardInputPanel.astro";
---

<div class="flex flex-col flex-1 min-h-0 gap-3 p-3">
  <SinglePlayerDisplay
    isTarget={false}
    score={score}
  >
    <div
      slot="progress"
      class="mt-2 flex w-full flex-col items-center gap-2 px-4"
    >
      <dl class="w-full space-y-1">
        {
          rows.map((row) =>
            row.showExpr ? (
              <div
                x-show={row.showExpr}
                x-cloak
              >
                <StatRow
                  label={row.label}
                  value={row.value}
                />
              </div>
            ) : (
              <StatRow
                label={row.label}
                value={row.value}
              />
            ),
          )
        }
        <StatRow
          label="Time"
          value="formattedStepRemaining()"
        />
      </dl>
    </div>
  </SinglePlayerDisplay>

  <VisitPreview />

  <ExerciseBoardInputPanel />
</div>
