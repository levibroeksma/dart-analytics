---
/**
 * Homepage weekday strip: seven day-initial circles in one row. Reads
 * `isToday(index)`/`hasRoutine(index)` from the enclosing `homeWeek()` scope —
 * today in accent at 110%, a day with a scheduled routine filled, a rest day
 * outlined.
 */
import { weekdayNames } from "@lib/training/schedules/today";

// Data
const letters = weekdayNames().map((name) => name.charAt(0).toLowerCase());
---

<div class="flex justify-between">
  <template
    x-for={`(letter, index) in ${JSON.stringify(letters)}`}
    :key="index"
  >
    <span
      class="flex size-10 items-center justify-center rounded-full border-2 font-normal transition-[transform,color,background-color,border-color] duration-150"
      :class="isToday(index) ? (hasRoutine(index) ? 'scale-110 border-accent bg-accent text-accent-foreground' : 'scale-110 border-accent text-accent') : (hasRoutine(index) ? 'border-muted bg-muted text-foreground' : 'border-muted text-muted')"
      x-text="letter"
    ></span>
  </template>
</div>
