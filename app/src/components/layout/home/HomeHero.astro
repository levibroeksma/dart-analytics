---
/**
 * Homepage hero stat inside the `homeSnapshot()` scope: mono eyebrow,
 * display-size value, and its change over the window with the delta in
 * accent; a hidden delta keeps its line.
 */
---

<div class="flex flex-col gap-2.5 px-1 pt-9 pb-7">
  <span
    class="font-mono text-eyebrow-lg font-semibold text-soft-foreground"
    x-text="hero.label"
  ></span>
  <span
    class="font-display text-hero text-shadow-hero"
    x-text="hero.value"
  ></span>
  <span
    class="text-sm text-muted"
    :class="hero.showDelta ? '' : 'invisible'"
  >
    <span x-text="hero.direction"></span>
    <span
      class="font-semibold text-accent-bright"
      x-text="hero.delta"
    ></span> in the <span x-text="hero.window"></span>
  </span>
</div>
