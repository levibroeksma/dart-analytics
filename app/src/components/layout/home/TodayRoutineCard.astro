---
/**
 * Homepage card for today's scheduled routine, inside the `homeWeek()`
 * scope: the active schedule's routine with a Start button (or "Rest day")
 * while today's routine has not been completed, then a "You're on fire"
 * completion state. Renders nothing without an active schedule.
 */
import CardWrapper from "@components/ui/CardWrapper.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/forms/Button.astro";

// Icons
import FlameIcon from "@icons/flame.svg";
---

<div
  x-show="showStart()"
  x-cloak
>
  <CardWrapper class="gap-3 glass">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-semibold text-muted-foreground">
        Today &middot; <span x-text="schedule?.name"></span>
      </h2>
      <a
        href="/training/schedules"
        class="text-xs text-accent"
      >
        Schedules
      </a>
    </div>
    <div class="flex items-center justify-between gap-4">
      <div class="flex flex-col gap-0.5">
        <p
          class="font-semibold text-base text-foreground"
          x-show="!isRestDay()"
          x-cloak
          x-text="todayEntry()?.routineName"
        >
        </p>
        <p
          class="font-semibold text-base text-foreground"
          x-show="isRestDay()"
          x-cloak
        >
          Rest day
        </p>
        <Badge
          class="text-xs w-fit"
          x-show="!isRestDay()"
          x-cloak
          x-text="`${todayEntry()?.routineMinutes} min`"
        />
      </div>
      <Button
        title="Start"
        variant="primary"
        loadingExpr="false"
        x-show="!isRestDay()"
        x-cloak
        @click="start()"
      />
    </div>
  </CardWrapper>
</div>
<div
  x-show="showDone()"
  x-cloak
>
  <CardWrapper
    color="orange"
    class="flex-row items-center gap-4"
  >
    <FlameIcon class="size-8 shrink-0 text-foreground" />
    <div class="flex flex-col gap-0.5">
      <h3 class="font-semibold text-base text-foreground">You're on fire</h3>
      <p
        class="text-xs text-muted-foreground"
        x-text="`${todayEntry()?.routineName} done for today.`"
      >
      </p>
    </div>
  </CardWrapper>
</div>
