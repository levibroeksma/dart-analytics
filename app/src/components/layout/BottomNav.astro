---
// Components
import NavBtn from "@components/layout/NavBtn.astro";

// Icons
import HomeIcon from "@icons/home-circle.svg";
import DartboardIcon from "@icons/dartboard.svg";
import TargetIcon from "@icons/target.svg";
import UserIcon from "@icons/user.svg";
import StatsIcon from "@icons/stats.svg";

// Lib
import { NAV_TABS } from "@lib/utils/nav-tabs";

// Data
const icons: Record<string, typeof HomeIcon> = {
  "/": HomeIcon,
  "/games": DartboardIcon,
  "/training": TargetIcon,
  "/statistics": StatsIcon,
  "/profile": UserIcon,
};
const pages = NAV_TABS.map((tab) => ({ ...tab, icon: icons[tab.href] }));
---

<nav
  class="pointer-events-none fixed inset-x-0 bottom-[max(0.5rem,calc(env(safe-area-inset-bottom)-0.5rem))] z-40 px-4"
  aria-label="Main navigation"
>
  <div
    class="glass-nav pointer-events-auto mx-auto flex max-w-lg justify-around gap-1 rounded-full p-1.5"
  >
    {
      pages.map((page) => (
        <NavBtn
          href={page.href}
          label={page.label}
        >
          <page.icon aria-hidden="true" />
        </NavBtn>
      ))
    }
  </div>
</nav>
