---
/**
 * Profile identity row in its own `profileSnapshot()` scope: initials
 * avatar and name from `$store.profile`, fixture stats line beneath. Until
 * the profile's first load settles, the avatar, name and stats line render
 * as same-size pulsing placeholders so nothing shifts when data arrives;
 * each text line reserves `1lh` so the row holds its height pre-hydration.
 */

// Lib
import { cn } from "@client/cn";

// Styles
const avatarClass =
  "flex size-14 shrink-0 items-center justify-center rounded-full font-display text-lg/[normal]";
const skeletonBarClass =
  "inline-block h-[1lh] animate-pulse rounded-md bg-foreground/12 align-top";
const nameSkeletonClass = cn(skeletonBarClass, "w-16");
const statsSkeletonClass = cn(skeletonBarClass, "w-52");
---

<div
  class="flex items-center gap-3.5 px-1 pt-1 pb-2"
  x-data="profileSnapshot()"
>
  <div
    class={cn(avatarClass, "accent-orb accent-orb-halo")}
    x-show="$store.profile.loaded"
    x-cloak
    aria-hidden="true"
    x-text="initials($store.profile.displayName)"
  >
  </div>
  <div
    class={cn(
      avatarClass,
      "animate-pulse bg-foreground/10 inset-ring inset-ring-foreground/12",
    )}
    x-show="!$store.profile.loaded"
    x-cloak
    aria-hidden="true"
  >
  </div>
  <div class="flex min-w-0 flex-col gap-1">
    <span class="min-h-[1lh] truncate font-display text-lg/[normal]">
      <span
        x-show="$store.profile.loaded"
        x-cloak
        x-text="$store.profile.displayName"
      ></span>
      <span
        class={nameSkeletonClass}
        x-show="!$store.profile.loaded"
        x-cloak
        aria-hidden="true"
      ></span>
    </span>
    <span class="min-h-[1lh] text-[13px]/[normal] text-strong-foreground">
      <span
        x-show="$store.profile.loaded"
        x-cloak
        x-text="statsLine"
      ></span>
      <span
        class={statsSkeletonClass}
        x-show="!$store.profile.loaded"
        x-cloak
        aria-hidden="true"
      ></span>
    </span>
  </div>
</div>
