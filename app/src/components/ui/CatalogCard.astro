---
/**
 * Card shell for a catalog entry. `game` is a link with the dart hover and
 * throw animation (`cardThrow()`); `exercise` is a static card whose body
 * slot holds the config well.
 * @param {"game"|"exercise"} variant
 * @param {string} [href] Destination of a `game` card
 * @param {string} [tagsLoadingExpr] Alpine expression, true while the card's
 *   tags and difficulty meter are still loading; shows pulsing placeholders
 * Slots: `title`, `meter`, `caption`, `tags`, default (body).
 */
type Props = { tagsLoadingExpr?: string } & (
  { variant: "game"; href: string } | { variant: "exercise"; href?: undefined }
);

// Props
const { variant, href, tagsLoadingExpr }: Props = Astro.props;

// Icons
import dartAccentUrl from "@icons/dart-accent.svg?url";

// Styles
const activate = `activate($event, ${JSON.stringify(href ?? "")})`;
---

{
  variant === "game" ? (
    <a
      href={href}
      class="catalog-card"
      x-data="cardThrow()"
      @mouseenter="enter()"
      @mouseleave="leave()"
      @focus="enter()"
      @blur="leave()"
      {...{ "@click": activate }}
    >
      <img
        src={dartAccentUrl}
        alt=""
        aria-hidden="true"
        width="96"
        height="96"
        class="card-dart"
        {...{ ":class": "dartClass()" }}
      />
      <div class="relative z-1 flex items-start justify-between gap-3">
        <span class="font-display text-control font-normal">
          <slot name="title" />
        </span>
        {tagsLoadingExpr && (
          <span
            class="h-3.5 w-5.5 shrink-0 animate-pulse rounded-sm bg-white/12"
            aria-hidden="true"
            x-cloak
            {...{ "x-show": tagsLoadingExpr }}
          />
        )}
        <slot name="meter" />
      </div>
      <p class="relative z-1 text-xs font-normal text-muted-foreground">
        <slot name="caption" />
      </p>
      <slot />
      <div class="relative z-1 mt-auto flex flex-wrap gap-1.5">
        {tagsLoadingExpr && (
          <>
            <span
              class="h-5.25 w-14 animate-pulse rounded-full bg-white/12"
              aria-hidden="true"
              x-cloak
              {...{ "x-show": tagsLoadingExpr }}
            />
            <span
              class="h-5.25 w-18 animate-pulse rounded-full bg-white/12"
              aria-hidden="true"
              x-cloak
              {...{ "x-show": tagsLoadingExpr }}
            />
          </>
        )}
        <slot name="tags" />
      </div>
    </a>
  ) : (
    <div class="catalog-card">
      <div class="flex items-start justify-between gap-3">
        <span class="font-display text-control font-normal">
          <slot name="title" />
        </span>
        {tagsLoadingExpr && (
          <span
            class="h-3.5 w-5.5 shrink-0 animate-pulse rounded-sm bg-white/12"
            aria-hidden="true"
            x-cloak
            {...{ "x-show": tagsLoadingExpr }}
          />
        )}
        <slot name="meter" />
      </div>
      <p class="text-xs font-normal text-muted-foreground">
        <slot name="caption" />
      </p>
      <div class="flex flex-wrap gap-1.5">
        {tagsLoadingExpr && (
          <>
            <span
              class="h-5.25 w-14 animate-pulse rounded-full bg-white/12"
              aria-hidden="true"
              x-cloak
              {...{ "x-show": tagsLoadingExpr }}
            />
            <span
              class="h-5.25 w-18 animate-pulse rounded-full bg-white/12"
              aria-hidden="true"
              x-cloak
              {...{ "x-show": tagsLoadingExpr }}
            />
          </>
        )}
        <slot name="tags" />
      </div>
      <slot />
    </div>
  )
}
