---
/**
 * Key to the four difficulty meters; shown once per screen.
 */

// Components
import DifficultyMeter from "@components/ui/DifficultyMeter.astro";
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
  <span
    class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-muted-foreground"
  >
    <DifficultyMeter level={1} />BEGINNER
  </span>
  <span
    class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-muted-foreground"
  >
    <DifficultyMeter level={2} />INTERMEDIATE
  </span>
  <span
    class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-muted-foreground"
  >
    <DifficultyMeter level={3} />ADVANCED
  </span>
  <span
    class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-muted-foreground"
  >
    <DifficultyMeter level={4} />EXPERT
  </span>
</div>
