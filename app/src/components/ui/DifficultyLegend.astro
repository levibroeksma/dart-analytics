---
/**
 * Key to the four difficulty meters; shown once per screen.
 * @param {boolean} [inlay] Inset well with the levels on a 2x2 grid
 */
import type { DifficultyLevel } from "@lib/types";

interface Props {
  inlay?: boolean;
}

// Props
const { inlay = false }: Props = Astro.props;

// Components
import DifficultyMeter from "@components/ui/DifficultyMeter.astro";

// Lib
import { cn } from "@client/cn";
import { DIFFICULTY_LEVEL_NAMES } from "@lib/catalog/difficulty";

// Styles
const className = cn(
  inlay
    ? "inset-well grid grid-cols-2 gap-x-4 gap-y-2 rounded-2xl px-4 py-3 backdrop-blur-sm dark:backdrop-blur bg-background/60 dark:bg-background/30"
    : "flex flex-wrap items-center gap-x-4 gap-y-2",
);
---

<div class={className}>
  <div class="col-span-2">
    <h4 class="text-xs">Legend</h4>
  </div>
  {
    DIFFICULTY_LEVEL_NAMES.map((name, index) => (
      <span class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase text-muted-foreground">
        <DifficultyMeter level={(index + 1) as DifficultyLevel} />
        {name}
      </span>
    ))
  }
</div>
