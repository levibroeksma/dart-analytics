---
/**
 * Corner toggle that opens a bottom glass sheet (`Modal`). Visibility is
 * owned by the caller — `openExpr` is read, never written.
 * @param {string} openExpr Alpine expression, true while the sheet is open
 * @param {string} onToggle Alpine expression run by the toggle
 * @param {string} onClose Alpine expression run on Escape or backdrop click
 * @param {string} title Heading
 * @param {string} titleId Stable unique heading id for this call site
 * @param {string} [overline] Eyebrow above the title
 * @param {string} [toggleLabelClosed="Open"] Accessible name while collapsed
 * @param {string} [toggleLabelOpen="Close"] Accessible name while open
 * @param {boolean} [detached=false] Hide the corner toggle; the caller opens the sheet from its own control
 * @param {string} [class] Extra sheet classes
 */
interface Props {
  openExpr: string;
  onToggle: string;
  onClose: string;
  title: string;
  titleId: string;
  overline?: string;
  toggleLabelClosed?: string;
  toggleLabelOpen?: string;
  detached?: boolean;
  class?: string;
}

// Props
const {
  openExpr,
  onToggle,
  onClose,
  title,
  titleId,
  overline,
  toggleLabelClosed = "Open",
  toggleLabelOpen = "Close",
  detached = false,
  class: classNameProp,
}: Props = Astro.props;

// Components
import Button from "@components/forms/Button.astro";
import Modal from "@components/ui/Modal.astro";

// Icons
import PlusIcon from "@icons/plus.svg";

// Data
const bodyId = `${titleId}-body`;
const toggleAttrs = {
  "@click": onToggle,
  ":aria-expanded": openExpr,
  ":aria-label": `${openExpr} ? '${toggleLabelOpen}' : '${toggleLabelClosed}'`,
};
const iconAttrs = { ":class": `${openExpr} ? 'rotate-45' : ''` };
---

{
  !detached && (
    <div class="pointer-events-none fixed inset-x-0 top-0 z-40 mx-auto flex max-w-lg justify-end p-4 pt-[calc(env(safe-area-inset-top)+1rem)]">
      <Button
        variant="sheet-raised"
        icon
        class="pointer-events-auto size-11 rounded-full p-0"
        loadingExpr="false"
        ariaLabel={toggleLabelClosed}
        aria-controls={bodyId}
        {...toggleAttrs}
      >
        <span
          slot="iconBefore"
          class="flex transition-transform duration-200"
          {...iconAttrs}
        >
          <PlusIcon class="size-4" />
        </span>
      </Button>
    </div>
  )
}

<div
  x-show={openExpr}
  x-cloak
>
  <Modal
    titleId={titleId}
    onDismiss={onClose}
    overline={overline}
    class={classNameProp}
  >
    <h2
      slot="header"
      id={titleId}
      class="text-balance font-display text-xl text-foreground"
    >
      {title}
    </h2>
    <div
      id={bodyId}
      class="w-full space-y-4"
    >
      <slot />
    </div>
  </Modal>
</div>
