---
/**
 * Round 44px glass sign-out button for the profile header, wired to
 * `logoutButton()`; the icon swaps for a spinner while the request runs.
 */

// Components
import Button from "@components/forms/Button.astro";

// Icons
import LogoutIcon from "@icons/logout.svg";
---

<Button
  type="button"
  variant="secondary"
  icon
  ariaLabel="Log out"
  class="glass-button size-11 shrink-0 rounded-full p-0 text-foreground"
  x-data="logoutButton()"
  @click="submit"
  :disabled="loading"
>
  <LogoutIcon
    x-show="!loading"
    slot="iconBefore"
    x-cloak
    class="size-5"
  />
</Button>
