---
// Components
import Button from "@components/forms/Button.astro";

// Icons
import LogoutIcon from "@icons/logout.svg";
---

<Button
  type="button"
  variant="ghost"
  icon
  ariaLabel="Log out"
  x-data="logoutButton()"
  @click="submit"
  :disabled="loading"
>
  <LogoutIcon
    x-show="!loading"
    slot="iconBefore"
    x-cloak
    class="size-6"
  />
</Button>
