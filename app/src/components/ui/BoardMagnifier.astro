---
/**
 * Zoomed inset that follows the fingertip while a board press is active, so
 * a 10 mm treble ring stays hittable on a phone. Renders a second, unlabelled
 * `<DartBoard />` inside a clipped circle, transformed so the board point
 * under the finger sits under the crosshair at the configured zoom, plus the
 * resolved read below it.
 *
 * Mounts inside an ancestor's `x-data` scope — it declares none of its own.
 * That ancestor (`boardInputData()`) must expose these as plain reactive
 * properties, reachable by name from wherever this component sits in the
 * DOM:
 * - `board: BoardView` — reads `active`, `point`, `preview`, `placement`,
 *   `magnifierSize` and `pxPerMm`
 * - `pointerX` / `pointerY: number` — last pointer position, viewport px
 *
 * Every binding here reads `board`, never the controller behind it. The
 * controller publishes its state through getters over closure variables, which
 * Alpine cannot observe: bound directly, this whole component renders the
 * press position and never updates again for the rest of the drag.
 *
 * The rendered diameter is read from `board.magnifierSize` rather than passed
 * in alongside it, so the size this component draws and the size the
 * controller clamps its placement against are one value that cannot drift.
 * Zoom is purely visual — the controller never consumes it — so it stays an
 * Astro prop, applied through the `--mag-zoom` custom property and never
 * entering Alpine's scope at all.
 *
 * The inner board is scaled by `zoom * board.pxPerMm`, not `zoom` alone. The
 * board underneath is `w-full`, so its displayed scale ranges from ~0.65
 * px/mm on a small phone to ~3.2 px/mm on desktop; multiplying zoom by the
 * live px/mm reading keeps magnification a fixed multiple of the displayed
 * board (`zoom`×) across every viewport, rather than a fixed absolute scale
 * that is barely visible on a wide screen. `--mag-zoom` supplies the `zoom`
 * factor; `board.pxPerMm` supplies the rest, so the two numbers are never
 * duplicated into one.
 *
 * The circle's `:style` binding is an OBJECT, not a template-literal string,
 * and this is load-bearing: Alpine's string-form style binding replaces the
 * whole `style` attribute (`setAttribute("style", value)`), which would wipe
 * the static `--mag-zoom` custom property the instant Alpine mounts. The
 * object form merges individual properties instead (`style.setProperty`) and
 * leaves the rest of the attribute — including `--mag-zoom` — intact, so the
 * child's `var(--mag-zoom)` still resolves. Confirmed with a real browser:
 * the string form silently drops the whole `transform` declaration (invalid
 * `var()`), which a hand-written Alpine stub never exercises.
 *
 * Positioned `fixed`, not `absolute`: `pointerX`/`pointerY` are `clientX`/
 * `clientY`, and the controller clamps its placement against the visual
 * viewport, so both halves of the position must be read in viewport
 * coordinates. Under `absolute` the magnifier would be displaced by however
 * far the nearest positioned ancestor sits from the viewport origin.
 *
 * A visual aid duplicating the live announced read, so the whole subtree is
 * `aria-hidden` rather than announced twice (Task 9 verifies this).
 * @param {string} [class] Extra classes on the visible magnifier circle
 */
interface Props {
  zoom?: number;
  class?: string;
  [key: string]: unknown;
}

// Props
const { zoom = 4, class: classNameProp, ...props }: Props = Astro.props;

// Components
import DartBoard from "@components/ui/DartBoard.astro";

// Lib
import { cn } from "@client/cn";

// Styles
const circleClass = cn(
  "absolute left-0 top-0 -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-full border-2 border-accent bg-surface",
  classNameProp,
);
---

<div
  class="pointer-events-none fixed z-10"
  aria-hidden="true"
  x-cloak
  x-show="board.active"
  :style="`left: ${pointerX + (board.placement?.offsetX ?? 0)}px; top: ${pointerY + (board.placement?.offsetY ?? 0)}px`"
  {...props}
>
  <div
    class={circleClass}
    style={`--mag-zoom: ${zoom}`}
    :style="{ width: `${board.magnifierSize}px`, height: `${board.magnifierSize}px` }"
  >
    <div class="absolute inset-0 flex items-center justify-center">
      <div
        class="h-[440px] w-[440px] shrink-0"
        :style="`transform: scale(calc(var(--mag-zoom) * ${board.pxPerMm})) translate(${-(board.point?.x ?? 0)}px, ${-(board.point?.y ?? 0)}px)`"
      >
        <DartBoard />
      </div>
    </div>

    <div
      class="absolute left-1/2 top-1/2 h-4 w-px -translate-x-1/2 -translate-y-1/2 bg-foreground"
    >
    </div>
    <div
      class="absolute left-1/2 top-1/2 h-px w-4 -translate-x-1/2 -translate-y-1/2 bg-foreground"
    >
    </div>
  </div>

  <p
    class="absolute left-0 -translate-x-1/2 whitespace-nowrap text-center text-sm font-semibold text-foreground"
    :style="`top: ${board.magnifierSize + 8}px`"
    x-text="board.preview ? `${board.preview.zoneKey} ${board.preview.targetNumber ?? ''} · ${board.preview.score}` : ''"
  >
  </p>
</div>
