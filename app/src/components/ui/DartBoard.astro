---
/**
 * Presentational dartboard: inline SVG only, no behaviour attached.
 * Alpine wiring (the board-input controller) binds externally by ref name,
 * because this component is also rendered a second time inside the
 * magnifier overlay (`BoardMagnifier.astro`) — only one instance may claim
 * a given `x-ref` name per Alpine scope, so the caller opts in per instance.
 *
 * The default slot renders as a sibling of the `<svg>` inside the wrapper, not
 * inside the SVG itself, and overlays it. Dart markers go there. They are
 * deliberately NOT SVG children: Alpine's `x-for` needs a real HTML
 * `<template>`, and the HTML parser puts a `<template>` written inside
 * `<svg>` into the SVG namespace, where it has no `.content` and `x-for`
 * cannot clone it. An absolutely positioned overlay, positioned in percent of
 * the wrapper, scales with the board without that trap.
 * @param {string} [boardRef] `x-ref` name for the root `<svg>`; omit on an
 *   instance that is not the controller's binding target
 * @param {string} [class] Extra wrapper classes
 * @param {string} [highlightPathExpr] Raw Alpine expression evaluating to an
 *   SVG path `d` string (e.g. `warmUpHighlightPath()`); when supplied,
 *   renders it as a highlight outline overlay, reactively re-evaluated.
 * @param {string} [dimPathExpr] Raw Alpine expression for an even-odd mask
 *   path dimming the board outside the highlight
 */
interface Props {
  boardRef?: string;
  class?: string;
  highlightPathExpr?: string;
  dimPathExpr?: string;
  [key: string]: unknown;
}

// Props
const {
  boardRef,
  class: classNameProp,
  highlightPathExpr,
  dimPathExpr,
  ...props
}: Props = Astro.props;

// Lib
import { cn } from "@client/cn";
import { BOARD_SEGMENTS } from "@lib/ui/dart-board-segments";

// Styles
const wrapperClass = cn("relative touch-none select-none", classNameProp);
const refAttrs = boardRef ? { "x-ref": boardRef } : {};
---

<div
  class={wrapperClass}
  {...props}
>
  <svg
    viewBox="-220,-220,440,440"
    class="block h-auto w-full"
    role="img"
    aria-label="Dartboard: twenty numbered segments with treble and double rings around a bullseye"
    {...refAttrs}
  >
    <g class="dartboard-group">
      {
        BOARD_SEGMENTS.map((segment) => (
          <g class={`segment ${segment.tone}`}>
            <path
              d={segment.singleBig}
              class="single big"
            />
            <path
              d={segment.singleSmall}
              class="single small"
            />
            <path
              d={segment.treble}
              class="multiplier treble"
            />
            <path
              d={segment.double}
              class="multiplier double"
            />
            <text
              x={segment.labelX}
              y={segment.labelY}
              dy="0.35em"
              text-anchor="middle"
              font-size="16px"
              font-weight="bold"
              font-family="sans-serif"
            >
              {segment.label}
            </text>
          </g>
        ))
      }
      <g class="bullSegment">
        <circle
          r="15.9"
          class="single"
        ></circle>
        <circle
          class="double"
          r="6.35"
        ></circle>
      </g>
    </g>
    {
      (highlightPathExpr || dimPathExpr) && (
        <g
          class="board-highlight-group pointer-events-none"
          aria-hidden="true"
        >
          {dimPathExpr && (
            <path
              class="fill-black/60"
              fill-rule="evenodd"
              {...{ ":d": dimPathExpr }}
            />
          )}
          {highlightPathExpr && (
            <path
              stroke-width="3"
              class="highlight-glow fill-none stroke-accent"
              {...{ ":d": highlightPathExpr }}
            />
          )}
        </g>
      )
    }
  </svg>

  <slot />
</div>
