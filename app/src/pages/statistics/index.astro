---
export const prerender = true;
import AppLayout from "@layouts/AppLayout.astro";
import Select from "@components/forms/Select.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import Badge from "@components/ui/Badge.astro";
import StatsHeatmap from "@components/ui/StatsHeatmap.astro";
import Toggle from "@components/layout/games/setup/Toggle.astro";
import { GAME_CARDS } from "@lib/game/rulesets/games-visibility";

const tabOptions = [
  { value: "games", label: "Games" },
  { value: "routines", label: "Routines" },
];
const gameOptions = GAME_CARDS.map((game) => ({
  value: game.rulesetVersionKey,
  label: game.title,
}));
const scope = JSON.stringify({
  tab: "games",
  game: gameOptions[0]?.value ?? "",
  titles: Object.fromEntries(
    gameOptions.map((option) => [option.value, option.label]),
  ),
});
---

<AppLayout title="Statistics">
  <div class="space-y-4 p-4">
    <h1 class="text-xl font-semibold text-foreground">Statistics</h1>

    <div
      class="space-y-4"
      x-data={scope}
    >
      <Toggle
        orientation="horizontal"
        options={tabOptions}
        x-model="tab"
        class="w-full"
      />
      <div
        class="space-y-4"
        x-show="tab === 'games'"
        x-cloak
        x-effect="$store.gameStats.selectGame(game)"
      >
        <Select
          options={gameOptions}
          model="game"
          ariaLabel="Game"
        />
        <ErrorAlert
          showExpr="$store.gameStats.error"
          textExpr="$store.gameStats.error"
        />
        <div
          class="space-y-4"
          x-show="!$store.gameStats.loading"
          x-cloak
        >
          <div
            class="gradient-card space-y-2 p-4"
            x-show="$store.gameStats.sections['target-accuracy']"
            x-cloak
          >
            <h2 class="text-sm font-semibold text-foreground">
              Target accuracy
            </h2>
            <template
              x-for="row in $store.gameStats.accuracyRows"
              :key="row.targetKey"
            >
              <div class="flex items-center gap-2 text-sm">
                <span
                  class="w-20 shrink-0 text-foreground"
                  x-text="row.targetKey"
                ></span>
                <div
                  class="h-2 flex-1 overflow-hidden rounded-sm bg-surface-overlay"
                >
                  <div
                    class="h-full bg-accent"
                    :style="{ width: (row.rate * 100) + '%' }"
                  >
                  </div>
                </div>
                <span
                  class="w-16 shrink-0 text-right text-muted-foreground"
                  x-text="row.attempts >= 30 ? Math.round(row.rate * 100) + '%' : 'not enough darts yet'"
                ></span>
              </div>
            </template>
            <p
              class="text-xs text-accent"
              x-show="$store.gameStats.favoriteTarget"
              x-cloak
              x-text="$store.gameStats.favoriteTarget ? `Favourite: ${$store.gameStats.favoriteTarget.targetKey}` : ''"
            >
            </p>
            <p
              class="text-xs text-muted-foreground"
              x-show="$store.gameStats.weakestTarget"
              x-cloak
              x-text="$store.gameStats.weakestTarget ? `Weakest: ${$store.gameStats.weakestTarget.targetKey}` : ''"
            >
            </p>
          </div>

          <div
            class="gradient-card space-y-2 p-4"
            x-data="{ confusionTarget: '' }"
            x-effect="confusionTarget = confusionTarget || ($store.gameStats.accuracyRows[0]?.targetKey ?? '')"
            x-show="$store.gameStats.sections.confusion"
            x-cloak
          >
            <h2 class="text-sm font-semibold text-foreground">Confusion</h2>
            <Select
              optionsExpr="$store.gameStats.accuracyRows.map((row) => ({ value: row.targetKey, label: row.targetKey }))"
              model="confusionTarget"
              ariaLabel="Confusion target"
            />
            <template
              x-for="landing in $store.gameStats.confusionTop(confusionTarget, 3)"
              :key="landing.hitKey"
            >
              <div class="flex items-center justify-between text-sm">
                <span
                  class="text-foreground"
                  x-text="landing.hitKey"
                ></span>
                <span
                  class="text-muted-foreground"
                  x-text="landing.count"
                ></span>
              </div>
            </template>
          </div>

          <div
            class="gradient-card space-y-2 p-4"
            x-show="$store.gameStats.sections.grouping"
            x-cloak
          >
            <h2 class="text-sm font-semibold text-foreground">Grouping</h2>
            <template
              x-for="row in $store.gameStats.groupingRows"
              :key="row.targetKey"
            >
              <div class="flex items-center justify-between text-sm">
                <span
                  class="text-foreground"
                  x-text="row.targetKey"
                ></span>
                <span
                  class="text-muted-foreground"
                  x-show="row.summary"
                  x-cloak
                  x-text="row.summary ? `${Math.round(row.summary.spreadMm)} mm spread` : ''"
                ></span>
                <span
                  class="text-muted-foreground"
                  x-show="!row.summary"
                  x-cloak
                >
                  not enough darts yet
                </span>
              </div>
            </template>
          </div>

          <div
            class="gradient-card space-y-2 p-4"
            x-data="{ missTarget: '' }"
            x-effect="missTarget = missTarget || ($store.gameStats.accuracyRows[0]?.targetKey ?? '')"
            x-show="$store.gameStats.sections['miss-direction']"
            x-cloak
          >
            <h2 class="text-sm font-semibold text-foreground">
              Miss direction
            </h2>
            <Select
              optionsExpr="$store.gameStats.accuracyRows.map((row) => ({ value: row.targetKey, label: row.targetKey }))"
              model="missTarget"
              ariaLabel="Miss direction target"
            />
            <div class="grid grid-cols-8 gap-1">
              <template
                x-for="sector in $store.gameStats.missRose(missTarget)"
                :key="sector.sector"
              >
                <div
                  class="flex flex-col items-center gap-1 text-xs text-muted-foreground"
                >
                  <div
                    class="h-8 w-2 rounded-sm bg-accent"
                    :style="{ opacity: 0.15 + Math.min(1, (sector.inside + sector.within + sector.outside) / 10) * 0.85 }"
                  >
                  </div>
                  <span x-text="sector.sector"></span>
                </div>
              </template>
            </div>
          </div>

          <div
            class="gradient-card space-y-2 p-4"
            x-show="$store.gameStats.sections['loose-darts']"
            x-cloak
          >
            <h2 class="text-sm font-semibold text-foreground">Loose darts</h2>
            <template
              x-for="bucket in $store.gameStats.looseDartsTrend"
              :key="bucket.start"
            >
              <div class="flex items-center justify-between text-sm">
                <span
                  class="text-muted-foreground"
                  x-text="new Date(bucket.start).toLocaleDateString(undefined, { month: 'short', year: 'numeric' })"
                ></span>
                <span
                  class="text-foreground"
                  x-text="`${bucket.onTarget} on · ${bucket.nearMiss} near · ${bucket.loose} loose`"
                ></span>
              </div>
            </template>
          </div>

          <div
            class="gradient-card space-y-2 p-4"
            x-data="{ heatmapTarget: '' }"
            x-effect="$store.gameStats.selectHeatmapTarget(heatmapTarget || null)"
            x-show="$store.gameStats.sections.heatmap"
            x-cloak
          >
            <h2 class="text-sm font-semibold text-foreground">Heatmap</h2>
            <div
              x-show="$store.gameStats.accuracyRows.length"
              x-cloak
            >
              <Select
                optionsExpr="[{ value: '', label: 'Whole board' }, ...$store.gameStats.accuracyRows.map((row) => ({ value: row.targetKey, label: row.targetKey }))]"
                model="heatmapTarget"
                ariaLabel="Heatmap target"
              />
            </div>
            <StatsHeatmap class="mx-auto max-w-56" />
          </div>

          <div class="gradient-card space-y-2 p-4">
            <h2 class="text-sm font-semibold text-foreground">Completion</h2>
            <div
              class="grid grid-cols-3 gap-2 text-center text-sm text-muted-foreground"
            >
              <div>
                <span
                  class="block text-lg text-foreground"
                  x-text="$store.gameStats.completionTotals?.completed ?? 0"
                >
                </span>
                Completed
              </div>
              <div>
                <span
                  class="block text-lg text-foreground"
                  x-text="$store.gameStats.completionTotals?.abandoned ?? 0"
                >
                </span>
                Abandoned
              </div>
              <div>
                <span
                  class="block text-lg text-foreground"
                  x-text="$store.gameStats.completionTotals?.neverStarted ?? 0"
                >
                </span>
                Never started
              </div>
            </div>
            <p
              class="text-xs text-muted-foreground"
              x-show="$store.gameStats.abandonRate !== null"
              x-cloak
              x-text="`Abandon rate: ${Math.round($store.gameStats.abandonRate * 100)}%`"
            >
            </p>
          </div>

          <div class="gradient-card space-y-2 p-4">
            <h2 class="text-sm font-semibold text-foreground">Volume</h2>
            <div
              class="grid grid-cols-3 gap-2 text-center text-sm text-muted-foreground"
            >
              <div>
                <span
                  class="block text-lg text-foreground"
                  x-text="($store.gameStats.volumeTotals?.sessions.standalone ?? 0) + ($store.gameStats.volumeTotals?.sessions.routine ?? 0)"
                >
                </span>
                Sessions
              </div>
              <div>
                <span
                  class="block text-lg text-foreground"
                  x-text="($store.gameStats.volumeTotals?.darts.standalone ?? 0) + ($store.gameStats.volumeTotals?.darts.routine ?? 0)"
                >
                </span>
                Darts
              </div>
              <div>
                <span
                  class="block text-lg text-foreground"
                  x-text="Math.round((($store.gameStats.volumeTotals?.durationSeconds.standalone ?? 0) + ($store.gameStats.volumeTotals?.durationSeconds.routine ?? 0)) / 60)"
                >
                </span>
                Minutes
              </div>
            </div>
          </div>

          <div
            class="gradient-card space-y-2 p-4"
            x-show="$store.gameStats.sessionResultRows.length"
            x-cloak
          >
            <h2 class="text-sm font-semibold text-foreground">
              Session result
            </h2>
            <template
              x-for="row in $store.gameStats.sessionResultRows"
              :key="row.rulesetVersionKey"
            >
              <div class="flex items-center justify-between gap-2 text-sm">
                <span
                  class="text-foreground"
                  x-text="row.rulesetVersionKey"
                >
                </span>
                <span
                  class="text-muted-foreground"
                  x-show="row.averageCountedScore !== null"
                  x-cloak
                  x-text="`avg ${Math.round(row.averageCountedScore)}`"
                >
                </span>
                <span
                  class="text-accent"
                  x-show="row.personalBest"
                  x-cloak
                  x-text="row.personalBest ? `PB ${row.personalBest.value}` : ''"
                >
                </span>
              </div>
            </template>
          </div>

          <div class="space-y-2">
            <h2 class="text-sm font-semibold text-foreground">Sessions</h2>
            <template
              x-for="item in $store.gameStats.sessions"
              :key="item.sessionId"
            >
              <div
                class="flex items-center justify-between gap-2 rounded-lg border border-border p-3 text-sm"
              >
                <div class="flex flex-col gap-1">
                  <span
                    class="text-foreground"
                    x-text="new Date(item.completedAt).toLocaleDateString()"
                  >
                  </span>
                  <span
                    class="text-xs text-muted-foreground"
                    x-text="`${item.turnCount} turns · ${item.dartCount} darts · ${item.countedScore} pts`"
                  >
                  </span>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <Badge
                    variant="neutral"
                    class="text-xs"
                    x-text="item.contextKey"
                  />
                  <Badge
                    class="text-xs"
                    x-text="item.statusKey"
                  />
                </div>
              </div>
            </template>
            <p
              class="text-sm text-muted-foreground"
              x-show="!$store.gameStats.sessions.length"
              x-cloak
            >
              No sessions in range.
            </p>
            <button
              type="button"
              class="btn btn-ghost w-full"
              x-show="$store.gameStats.nextCursor"
              x-cloak
              @click="$store.gameStats.loadMoreSessions()"
            >
              Load more
            </button>
          </div>
        </div>
      </div>
      <div
        class="space-y-4"
        x-data="statisticsRoutines()"
        x-show="tab === 'routines'"
        x-cloak
      >
        <div
          x-show="routines.length"
          x-cloak
        >
          <Select
            optionsExpr="routineOptions()"
            model="routine"
            ariaLabel="Routine"
          />
        </div>
        <p
          class="text-sm text-muted-foreground"
          x-show="!loading && !error"
          x-cloak
          x-text="routines.length ? `${routineName()} statistics coming soon.` : 'No routines available'"
        >
        </p>
        <ErrorAlert />
      </div>
    </div>
  </div>
</AppLayout>
