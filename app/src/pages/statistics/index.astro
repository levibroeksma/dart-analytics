---
export const prerender = true;
import AppLayout from "@layouts/AppLayout.astro";
import Select from "@components/forms/Select.astro";
import Toggle from "@components/layout/games/setup/Toggle.astro";
import ScoreTrainingStatsOverview from "@components/layout/games/statistics/ScoreTrainingStatsOverview.astro";
import HeatmapStatsOverview from "@components/layout/games/statistics/HeatmapStatsOverview.astro";
import { HEATMAP_ONLY_LAYOUTS } from "@lib/stats/constants";
import { GAME_CARDS } from "@lib/game/rulesets/games-visibility";
import { TREND_RANGE_OPTIONS } from "@lib/stats/sections/score-trend-window";

const tabOptions = [
  { value: "games", label: "Games" },
  { value: "routines", label: "Routines" },
];
const gameOptions = GAME_CARDS.map((game) => ({
  value: game.rulesetVersionKey,
  label: game.title,
}));
const heatmapOnly = JSON.stringify([...HEATMAP_ONLY_LAYOUTS]);
const scope = `{ tab: $store.routineStats.initialTab, game: ${JSON.stringify(gameOptions[0]?.value ?? "")}, rangeKey: "30d" }`;
---

<AppLayout title="Statistics">
  <div class="space-y-4 p-4">
    <h1 class="text-xl font-semibold text-foreground">Statistics</h1>

    <div
      class="space-y-4"
      x-data={scope}
    >
      <Toggle
        orientation="horizontal"
        options={tabOptions}
        x-model="tab"
        class="w-full"
      />
      <div
        class="space-y-4"
        x-show="tab === 'games'"
        x-cloak
      >
        <div class="grid grid-cols-2 gap-2">
          <Select
            options={gameOptions}
            model="game"
            ariaLabel="Game"
          />
          <Select
            options={TREND_RANGE_OPTIONS}
            model="rangeKey"
            ariaLabel="Period"
          />
        </div>
        <template x-if="game === 'SCORE_TRAINING_V1'">
          <ScoreTrainingStatsOverview />
        </template>
        <template x-if={`${heatmapOnly}.includes(game)`}>
          <HeatmapStatsOverview />
        </template>
        <template
          x-if={`game !== 'SCORE_TRAINING_V1' && !${heatmapOnly}.includes(game)`}
        >
          <p class="glass rounded-2xl p-4 text-sm text-muted-foreground">
            Statistics for this game are being rebuilt.
          </p>
        </template>
      </div>
      <p
        class="glass rounded-2xl p-4 text-sm text-muted-foreground"
        x-show="tab === 'routines'"
        x-cloak
      >
        Routine statistics are being rebuilt.
      </p>
    </div>
  </div>
</AppLayout>
