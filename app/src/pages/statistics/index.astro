---
export const prerender = true;
import AppLayout from "@layouts/AppLayout.astro";
import Select from "@components/forms/Select.astro";
import Toggle from "@components/layout/games/setup/Toggle.astro";
import ScoreTrainingStatsOverview from "@components/layout/games/statistics/ScoreTrainingStatsOverview.astro";
import { GAME_CARDS } from "@lib/game/rulesets/games-visibility";

const tabOptions = [
  { value: "games", label: "Games" },
  { value: "routines", label: "Routines" },
];
const gameOptions = GAME_CARDS.map((game) => ({
  value: game.rulesetVersionKey,
  label: game.title,
}));
const scope = JSON.stringify({
  tab: "games",
  game: gameOptions[0]?.value ?? "",
});
---

<AppLayout title="Statistics">
  <div class="space-y-4 p-4">
    <h1 class="text-xl font-semibold text-foreground">Statistics</h1>

    <div
      class="space-y-4"
      x-data={scope}
    >
      <Toggle
        orientation="horizontal"
        options={tabOptions}
        x-model="tab"
        class="w-full"
      />
      <div
        class="space-y-4"
        x-show="tab === 'games'"
        x-cloak
      >
        <Select
          options={gameOptions}
          model="game"
          ariaLabel="Game"
        />
        <template x-if="game === 'SCORE_TRAINING_V1'">
          <ScoreTrainingStatsOverview />
        </template>
        <template x-if="game !== 'SCORE_TRAINING_V1'">
          <p class="glass rounded-2xl p-4 text-sm text-muted-foreground">
            Statistics for this game are being rebuilt.
          </p>
        </template>
      </div>
      <p
        class="glass rounded-2xl p-4 text-sm text-muted-foreground"
        x-show="tab === 'routines'"
        x-cloak
      >
        Routine statistics are being rebuilt.
      </p>
    </div>
  </div>
</AppLayout>
