---
export const prerender = true;
import AppLayout from "@layouts/AppLayout.astro";
import Select from "@components/forms/Select.astro";
import Toggle from "@components/layout/games/setup/Toggle.astro";
import ScoreTrainingStatsOverview from "@components/layout/games/statistics/ScoreTrainingStatsOverview.astro";
import X01StatsOverview from "@components/layout/games/statistics/X01StatsOverview.astro";
import DoublesTrainingStatsOverview from "@components/layout/games/statistics/DoublesTrainingStatsOverview.astro";
import AceStatsOverview from "@components/layout/games/statistics/AceStatsOverview.astro";
import CheckoutStatsOverview from "@components/layout/games/statistics/CheckoutStatsOverview.astro";
import MarksStatsOverview from "@components/layout/games/statistics/MarksStatsOverview.astro";
import EliminationStatsOverview from "@components/layout/games/statistics/EliminationStatsOverview.astro";
import TrackGamesStatsOverview from "@components/layout/games/statistics/TrackGamesStatsOverview.astro";
import HeatmapStatsOverview from "@components/layout/games/statistics/HeatmapStatsOverview.astro";
import GameVariationSelect from "@components/layout/games/statistics/GameVariationSelect.astro";
import {
  ACE_LAYOUTS,
  CHECKOUT_LAYOUTS,
  DOUBLES_TRAINING_LAYOUTS,
  ELIMINATION_LAYOUTS,
  HEATMAP_ONLY_LAYOUTS,
  MARKS_LAYOUTS,
  TRACK_LAYOUTS,
  X01_LAYOUTS,
} from "@lib/stats/constants";
import { primaryCards } from "@lib/game/rulesets/games-visibility";
import { TREND_RANGE_OPTIONS } from "@lib/stats/sections/score-trend-window";

const tabOptions = [
  { value: "games", label: "Games" },
  { value: "routines", label: "Routines" },
];
const gameOptions = primaryCards().map((game) => ({
  value: game.rulesetVersionKey,
  label: game.title,
}));
const aceRulesets = JSON.stringify([...ACE_LAYOUTS]);
const checkoutRulesets = JSON.stringify([...CHECKOUT_LAYOUTS]);
const marksRulesets = JSON.stringify([...MARKS_LAYOUTS]);
const eliminationRulesets = JSON.stringify([...ELIMINATION_LAYOUTS]);
const trackRulesets = JSON.stringify([...TRACK_LAYOUTS]);
const heatmapOnly = JSON.stringify([...HEATMAP_ONLY_LAYOUTS]);
const doublesTrainingRulesets = JSON.stringify([...DOUBLES_TRAINING_LAYOUTS]);
const x01Rulesets = JSON.stringify([...X01_LAYOUTS]);
const scope = `{ tab: $store.routineStats.initialTab, game: ${JSON.stringify(gameOptions[0]?.value ?? "")}, rangeKey: "30d", variation: $store.statsVariation.value }`;
---

<AppLayout title="Statistics">
  <div class="space-y-4 p-4">
    <h1 class="text-xl font-semibold text-foreground">Statistics</h1>

    <div
      class="space-y-4"
      x-data={scope}
    >
      <Toggle
        orientation="horizontal"
        options={tabOptions}
        x-model="tab"
        class="w-full"
      />
      <div
        class="space-y-4"
        x-show="tab === 'games'"
        x-cloak
      >
        <div class="grid grid-cols-2 gap-2">
          <Select
            options={gameOptions}
            model="game"
            ariaLabel="Game"
          />
          <Select
            options={TREND_RANGE_OPTIONS}
            model="rangeKey"
            ariaLabel="Period"
          />
        </div>
        <template x-if={`${x01Rulesets}.includes(game)`}>
          <GameVariationSelect />
        </template>
        <template x-if={`${x01Rulesets}.includes(game)`}>
          <X01StatsOverview />
        </template>
        <template x-if="game === 'SCORE_TRAINING_V1'">
          <ScoreTrainingStatsOverview />
        </template>
        <template x-if={`${doublesTrainingRulesets}.includes(game)`}>
          <DoublesTrainingStatsOverview />
        </template>
        <template x-if={`${trackRulesets}.includes(game)`}>
          <TrackGamesStatsOverview />
        </template>
        <template x-if={`${aceRulesets}.includes(game)`}>
          <AceStatsOverview />
        </template>
        <template x-if={`${checkoutRulesets}.includes(game)`}>
          <CheckoutStatsOverview />
        </template>
        <template x-if={`${marksRulesets}.includes(game)`}>
          <MarksStatsOverview />
        </template>
        <template x-if={`${eliminationRulesets}.includes(game)`}>
          <EliminationStatsOverview />
        </template>
        <template x-if={`${heatmapOnly}.includes(game)`}>
          <HeatmapStatsOverview />
        </template>
        <template
          x-if={`game !== 'SCORE_TRAINING_V1' && !${x01Rulesets}.includes(game) && !${doublesTrainingRulesets}.includes(game) && !${trackRulesets}.includes(game) && !${aceRulesets}.includes(game) && !${checkoutRulesets}.includes(game) && !${marksRulesets}.includes(game) && !${eliminationRulesets}.includes(game) && !${heatmapOnly}.includes(game)`}
        >
          <p class="glass rounded-2xl p-4 text-sm text-muted-foreground">
            Statistics for this game are being rebuilt.
          </p>
        </template>
      </div>
      <p
        class="glass rounded-2xl p-4 text-sm text-muted-foreground"
        x-show="tab === 'routines'"
        x-cloak
      >
        Routine statistics are being rebuilt.
      </p>
    </div>
  </div>
</AppLayout>
