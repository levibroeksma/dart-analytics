---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import WarmUpPanel from "@components/layout/training/exercises/WarmUpPanel.astro";
import SwitchingPanel from "@components/layout/training/exercises/SwitchingPanel.astro";
import DoublePatternPanel from "@components/layout/training/exercises/DoublePatternPanel.astro";
import TargetScoringPanel from "@components/layout/training/exercises/TargetScoringPanel.astro";
import ScoreThresholdPanel from "@components/layout/training/exercises/ScoreThresholdPanel.astro";
import BullseyeCheckoutPanel from "@components/layout/training/exercises/BullseyeCheckoutPanel.astro";
import BullUpPanel from "@components/layout/training/exercises/BullUpPanel.astro";
import CheckoutSequencePanel from "@components/layout/training/exercises/CheckoutSequencePanel.astro";
import RandomCheckoutPanel from "@components/layout/training/exercises/RandomCheckoutPanel.astro";
import HitCountPanel from "@components/layout/training/exercises/HitCountPanel.astro";
import SwitchbladePanel from "@components/layout/training/exercises/SwitchbladePanel.astro";
import DoublesLockPanel from "@components/layout/training/exercises/DoublesLockPanel.astro";
import TenUpOneDown from "@components/layout/games/interfaces/TenUpOneDown.astro";
import ScoreTraining from "@components/layout/games/interfaces/ScoreTraining.astro";
import OneTwentyOne from "@components/layout/games/interfaces/OneTwentyOne.astro";
import AroundTheClock from "@components/layout/games/interfaces/AroundTheClock.astro";
import CountdownPauseControl from "@components/layout/games/CountdownPauseControl.astro";
import HeaderClockPill from "@components/layout/games/HeaderClockPill.astro";
import CheckoutConfirm from "@components/layout/games/CheckoutConfirm.astro";
import ConfirmDialog from "@components/ui/ConfirmDialog.astro";
import InlayRow from "@components/ui/InlayRow.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import Button from "@components/forms/Button.astro";
import RoutineReadyGate from "@components/layout/training/routines/RoutineReadyGate.astro";
import RoutineSummaryModal from "@components/layout/training/routines/RoutineSummaryModal.astro";
import BlockedStepModal from "@components/layout/training/exercises/BlockedStepModal.astro";
import OpenRoutineModal from "@components/layout/training/routines/OpenRoutineModal.astro";
---

<GameLayout
  title="Routine — Play"
  gameTitleExpr="headerTitle()"
  gameSubtitleExpr="headerSubtitle()"
  x-data="routinePlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <HeaderClockPill
    slot="header-end"
    valueExpr="headerClock()"
    ariaLabelExpr="headerClockLabel()"
    showExpr="headerClock() !== ''"
  />
  <CountdownPauseControl
    slot="header-end"
    scopeExpr="game"
    disabledExpr="game?.finished || game?.showDoubleConfirm || game?.showFinishConfirm || game?.showSessionFinishConfirm"
  />
  <div class="flex flex-col flex-1 min-h-0">
    <ErrorAlert />

    <template x-if="!loading && !routineReady && training">
      <RoutineReadyGate />
    </template>

    <template x-if="routineReady && !loading">
      <div class="flex min-h-0 flex-1 flex-col">
        <template x-if="adapter?.panel === 'warm-up' && warmUpEngine">
          <WarmUpPanel />
        </template>

        <template x-if="adapter?.panel === 'switching' && switchingEngine">
          <SwitchingPanel />
        </template>

        <template
          x-if="adapter?.panel === 'double-pattern' && doublePatternEngine"
        >
          <DoublePatternPanel />
        </template>

        <template
          x-if="adapter?.panel === 'target-scoring' && targetScoringEngine"
        >
          <TargetScoringPanel />
        </template>

        <template
          x-if="adapter?.panel === 'score-threshold' && scoreThresholdEngine"
        >
          <ScoreThresholdPanel />
        </template>

        <template
          x-if="adapter?.panel === 'bullseye-checkout' && bullseyeCheckoutEngine"
        >
          <BullseyeCheckoutPanel />
        </template>

        <template x-if="adapter?.panel === 'bull-up' && bullUpEngine">
          <BullUpPanel />
        </template>

        <template
          x-if="adapter?.panel === 'checkout-sequence' && checkoutSequenceEngine"
        >
          <CheckoutSequencePanel />
        </template>

        <template
          x-if="adapter?.panel === 'random-checkout' && randomCheckoutEngine"
        >
          <RandomCheckoutPanel />
        </template>
        <template x-if="adapter?.panel === 'hit-count' && hitCountEngine">
          <HitCountPanel />
        </template>
        <template x-if="adapter?.panel === 'switchblade' && switchbladeEngine">
          <SwitchbladePanel />
        </template>
        <template x-if="adapter?.panel === 'doubles-lock' && doublesLockEngine">
          <DoublesLockPanel />
        </template>

        <template x-if="adapter?.panel === 'tuod' && game">
          <div
            x-data="game"
            class="flex min-h-0 flex-1 flex-col"
          >
            <div class="flex items-center justify-between gap-2">
              <p
                class="min-w-0 truncate font-mono text-eyebrow font-semibold uppercase text-muted-foreground"
                x-text="subtitle()"
              >
              </p>
            </div>
            <TenUpOneDown
              x-show="!finished"
              x-cloak
            />
            {
              /* TUOD's own confirm gates, same wiring as `games/tuod/play`. The
            store raises these instead of recording: a session-ending dart sets
            `showFinishConfirm` and waits, so without the dialog the step can
            never finish and the routine hangs. */
            }
            <div
              x-show="showDoubleConfirm"
              x-cloak
            >
              <CheckoutConfirm />
            </div>
            <div
              x-show="showFinishConfirm"
              x-cloak
            >
              <ConfirmDialog
                titleId="routine-finish-confirm-title"
                title="Finish session?"
                description="This attempt completes the session. Confirm to save and finish, or cancel to reconsider."
                confirmLabel="Finish"
                onCancel="cancelFinish()"
                onConfirm="confirmFinish()"
                dismissible={false}
              >
                <InlayRow
                  slot="context"
                  rowExpr="stepContextRow()"
                />
              </ConfirmDialog>
            </div>
            <div
              x-show="finished && completionStatus === 'failed'"
              x-cloak
              class="p-4"
            >
              <ErrorAlert
                textExpr="completionError"
                alwaysVisible
              />
              <Button
                class="mt-2"
                @click="uploadAndCompleteSession()"
                title="Retry"
              />
            </div>
            <div
              x-show="finished && completionStatus !== 'failed'"
              x-cloak
              class="p-4 text-center"
            >
              <p class="text-foreground">Saving your finishing session…</p>
            </div>
          </div>
        </template>

        <template x-if="adapter?.panel === 'score-training' && game">
          <div
            x-data="game"
            class="flex min-h-0 flex-1 flex-col"
          >
            <div class="flex items-center justify-between gap-2">
              <p
                class="min-w-0 truncate font-mono text-eyebrow font-semibold uppercase text-muted-foreground"
                x-text="subtitle()"
              >
              </p>
            </div>
            <ScoreTraining
              x-show="!finished"
              x-cloak
            />
            {
              /* Score Training's own confirm gate, same wiring as
            `games/score-training/play`. */
            }
            <div
              x-show="showFinishConfirm"
              x-cloak
            >
              <ConfirmDialog
                titleId="routine-finish-confirm-title"
                title="Finish session?"
                description="This visit completes the session. Confirm to save and finish, or cancel to reconsider."
                confirmLabel="Finish"
                onCancel="cancelFinish()"
                onConfirm="confirmFinish()"
                dismissible={false}
              >
                <InlayRow
                  slot="context"
                  rowExpr="stepContextRow()"
                />
              </ConfirmDialog>
            </div>
            <div
              x-show="finished && completionStatus === 'failed'"
              x-cloak
              class="p-4"
            >
              <ErrorAlert
                textExpr="completionError"
                alwaysVisible
              />
              <Button
                class="mt-2"
                @click="uploadAndCompleteSession()"
                title="Retry"
              />
            </div>
            <div
              x-show="finished && completionStatus !== 'failed'"
              x-cloak
              class="p-4 text-center"
            >
              <p class="text-foreground">Saving your scoring session…</p>
            </div>
          </div>
        </template>

        <template x-if="adapter?.panel === 'one-twenty-one' && game">
          <div
            x-data="game"
            class="flex min-h-0 flex-1 flex-col"
          >
            <div class="flex items-center justify-between gap-2">
              <p
                class="min-w-0 truncate font-mono text-eyebrow font-semibold uppercase text-muted-foreground"
                x-text="subtitle()"
              >
              </p>
            </div>
            <OneTwentyOne
              x-show="!finished"
              x-cloak
            />
            {/* 121's own confirm gates, same wiring as `games/121/play`. */}
            <div
              x-show="showDoubleConfirm"
              x-cloak
            >
              <CheckoutConfirm />
            </div>
            <div
              x-show="showSessionFinishConfirm"
              x-cloak
            >
              <ConfirmDialog
                titleId="routine-session-finish-confirm-title"
                title="Check out 170?"
                description="This checkout wins the session. Confirm to save and finish, or cancel to reconsider."
                cancelLabel="Cancel"
                confirmLabel="Check out"
                onCancel="cancelSessionFinish()"
                onConfirm="confirmSessionFinish()"
                dismissible={false}
              >
                <InlayRow
                  slot="context"
                  rowExpr="stepContextRow()"
                />
              </ConfirmDialog>
            </div>
            <div
              x-show="finished && completionStatus === 'failed'"
              x-cloak
              class="p-4"
            >
              <ErrorAlert
                textExpr="completionError"
                alwaysVisible
              />
              <Button
                class="mt-2"
                @click="uploadAndCompleteSession()"
                title="Retry"
              />
            </div>
            <div
              x-show="finished && completionStatus !== 'failed'"
              x-cloak
              class="p-4 text-center"
            >
              <p class="text-foreground">Saving your 121 session…</p>
            </div>
          </div>
        </template>

        <template x-if="adapter?.panel === 'around-the-clock' && game">
          <div
            x-data="game"
            class="flex min-h-0 flex-1 flex-col"
          >
            <div class="flex items-center justify-between gap-2">
              <p
                class="min-w-0 truncate font-mono text-eyebrow font-semibold uppercase text-muted-foreground"
                x-text="subtitle()"
              >
              </p>
            </div>
            <AroundTheClock
              x-show="!finished"
              x-cloak
            />
            <div
              x-show="finished && completionStatus === 'failed'"
              x-cloak
              class="p-4"
            >
              <ErrorAlert
                textExpr="completionError"
                alwaysVisible
              />
              <Button
                class="mt-2"
                @click="uploadAndCompleteSession()"
                title="Retry"
              />
            </div>
            <div
              x-show="finished && completionStatus !== 'failed'"
              x-cloak
              class="p-4 text-center"
            >
              <p class="text-foreground">
                Saving your Around the Clock session…
              </p>
            </div>
          </div>
        </template>
      </div>
    </template>

    <template x-if="blockingSession">
      <BlockedStepModal />
    </template>

    <template x-if="openRoutine">
      <OpenRoutineModal />
    </template>

    <RoutineSummaryModal />
  </div>
</GameLayout>
