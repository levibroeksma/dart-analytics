---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import GameCard from "@components/layout/games/GameCard.astro";
import RoutineCard from "@components/layout/training/routines/RoutineCard.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";

import CardWrapper from "@components/ui/CardWrapper.astro";
import RoutineFormModal from "@components/layout/training/routines/RoutineFormModal.astro";
import ScheduleFormModal from "@components/layout/training/schedules/ScheduleFormModal.astro";
import Button from "@components/forms/Button.astro";
import Select from "@components/forms/Select.astro";
---

<AppLayout title="Training">
  <div
    class="p-4 space-y-8"
    x-data="trainingIndex()"
  >
    <div class="flex h-12 items-center justify-between">
      <h1 class="text-xl font-semibold text-foreground">Training</h1>
    </div>
    <ErrorAlert />
    <CardWrapper
      color="teal"
      class="flex-row items-center justify-between gap-4"
    >
      <div>
        <h2 class="text-sm font-semibold text-foreground">My schedule</h2>
        <p class="text-xs text-muted-foreground">
          Plan your weekly routine to get your game to the next level. Don't
          forget to build in some recovery!
        </p>
      </div>
      <Button
        title="Plan"
        variant="secondary"
        class="shrink-0"
        loadingExpr="false"
        @click="showScheduleModal = true"
      />
    </CardWrapper>
    <CardWrapper
      color="sky"
      class="flex flex-col gap-4 overflow-visible"
    >
      <div>
        <h2 class="text-sm font-semibold text-foreground">Routines</h2>
        <p class="text-xs text-muted-foreground">
          Practice the default routines or the ones you built yourself, so you
          can perform them quickly and accurately.
        </p>
      </div>
      <div
        class="space-y-4"
        x-show="routines.length"
        x-cloak
      >
        <Select
          optionsExpr="routineOptions()"
          model="selectedRoutineId"
          ariaLabel="Routine"
        />
        <template
          x-for="routine in selectedRoutine() ? [selectedRoutine()] : []"
          :key="routine.routineId"
        >
          <RoutineCard />
        </template>
      </div>
      <p
        class="text-xs text-muted-foreground"
        x-show="!loading && !routines.length"
        x-cloak
      >
        No routines available
      </p>

      <div
        class="space-y-4"
        x-show="loading"
        x-cloak
        aria-hidden="true"
      >
        {
          [0, 1].map(() => (
            <div class="card-wrapper glass flex flex-row items-center justify-between gap-3 rounded-2xl p-3.5 animate-pulse">
              <div class="flex flex-col gap-2">
                <div class="h-4 w-32 rounded bg-surface-raised" />
                <div class="h-3 w-48 rounded bg-surface-raised" />
              </div>
            </div>
          ))
        }
      </div>
    </CardWrapper>
    <CardWrapper
      color="violet"
      class="flex flex-col gap-4"
    >
      <div>
        <h2 class="text-sm font-semibold text-foreground">Trivia</h2>
        <p class="text-xs text-muted-foreground">
          Practice checkout mental math, so you don't loose your rhythm in the
          heat of the moment.
        </p>
      </div>
      <GameCard
        href="/training/quick-subtract"
        title="Quick Subtract"
        caption="Drill checkout mental math against the clock or a target count"
      />
    </CardWrapper>
    <RoutineFormModal
      mode="create"
      openExpr="showModal"
    />
    <ScheduleFormModal openExpr="showScheduleModal" />
  </div>
</AppLayout>
