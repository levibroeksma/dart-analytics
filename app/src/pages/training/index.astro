---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import GameCard from "@components/layout/games/GameCard.astro";
import RoutineCard from "@components/layout/training/routines/RoutineCard.astro";
import TodayCard from "@components/layout/training/schedules/TodayCard.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";

import CardWrapper from "@components/ui/CardWrapper.astro";
import RoutineFormModal from "@components/layout/training/routines/RoutineFormModal.astro";
---

<AppLayout title="Training">
  <div
    class="p-4 space-y-8"
    x-data="trainingIndex()"
  >
    <div class="flex h-12 items-center justify-between">
      <h1 class="text-xl font-semibold text-foreground">Training</h1>
    </div>
    <div x-data="todayCard()">
      <TodayCard />
    </div>
    <ErrorAlert />
    <CardWrapper
      color="sky"
      class="flex flex-col gap-4"
    >
      <div>
        <h2 class="text-sm font-semibold text-foreground">Routines</h2>
        <p class="text-xs text-muted-foreground">
          Practice your routines, so you can perform them quickly and
          accurately.
        </p>
      </div>
      <template
        x-for="routine in systemRoutines()"
        :key="routine.routineId"
      >
        <RoutineCard />
      </template>

      <div
        class="space-y-4"
        x-show="!routines.length"
        x-cloak
        aria-hidden="true"
      >
        {
          [0, 1, 2].map(() => (
            <div class="card-wrapper glass flex flex-row items-center justify-between gap-3 rounded-2xl p-3.5 animate-pulse">
              <div class="flex flex-col gap-2">
                <div class="h-4 w-32 rounded bg-surface-raised" />
                <div class="h-3 w-48 rounded bg-surface-raised" />
              </div>
            </div>
          ))
        }
      </div>
    </CardWrapper>
    <CardWrapper
      color="fuchsia"
      class="flex flex-col gap-4"
    >
      <div>
        <h2 class="text-sm font-semibold text-foreground">Personal routines</h2>
        <p class="text-xs text-muted-foreground">
          The routines you built yourself, ready to run whenever you want them.
        </p>
      </div>
      <template
        x-for="routine in personalRoutines()"
        :key="routine.routineId"
      >
        <RoutineCard />
      </template>
      <p
        class="text-xs text-muted-foreground"
        x-show="!loading && !personalRoutines().length"
        x-cloak
      >
        No custom routines available
      </p>
    </CardWrapper>
    <CardWrapper
      color="violet"
      class="flex flex-col gap-4"
    >
      <div>
        <h2 class="text-sm font-semibold text-foreground">Trivia</h2>
        <p class="text-xs text-muted-foreground">
          Practice checkout mental math, so you don't loose your rhythm in the
          heat of the moment.
        </p>
      </div>
      <GameCard
        href="/training/quick-subtract"
        title="Quick Subtract"
        caption="Drill checkout mental math against the clock or a target count"
      />
    </CardWrapper>
    <RoutineFormModal
      mode="create"
      openExpr="showModal"
    />
  </div>
</AppLayout>
