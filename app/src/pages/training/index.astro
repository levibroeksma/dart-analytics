---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import ErrorAlert from "@components/ui/ErrorAlert.astro";
import RoutineRow from "@components/layout/training/routines/RoutineRow.astro";
import RoutineFormModal from "@components/layout/training/routines/RoutineFormModal.astro";
import ScheduleFormModal from "@components/layout/training/schedules/ScheduleFormModal.astro";
import TrainingScheduleCard from "@components/layout/training/schedules/TrainingScheduleCard.astro";
import DartIcon from "@icons/dart.svg";
import PlayIcon from "@icons/play-rounded.svg";
import PlusIcon from "@icons/plus.svg";
---

<AppLayout
  title="Training"
  backdrop="home"
>
  <div
    class="flex flex-col gap-3 px-4 pt-2"
    x-data="trainingIndex()"
  >
    <div class="flex items-center justify-between px-1 pt-5 pb-3">
      <h1 class="font-display text-[26px]/[normal] tracking-[0.02em]">
        Training
      </h1>
    </div>
    <ErrorAlert />

    <TrainingScheduleCard />

    <span class="section-eyebrow pt-2.5">ROUTINES</span>
    <div class="glass flex flex-col rounded-2xl px-4 shadow-none">
      <template
        x-for="(routine, index) in systemRoutines()"
        :key="routine.routineId"
      >
        <RoutineRow />
      </template>
      <div
        class="flex flex-col divide-y divide-border"
        x-show="loading"
        x-cloak
        aria-hidden="true"
      >
        {
          [0, 1, 2].map(() => (
            <div class="flex items-center gap-3 py-3.5">
              <div class="flex flex-1 flex-col gap-1.5">
                <div class="h-[18px] w-35 animate-pulse rounded bg-white/12" />
                <div class="flex gap-1.5">
                  <div class="h-4 w-11 animate-pulse rounded-md bg-white/12" />
                  <div class="h-4 w-18 animate-pulse rounded-md bg-white/12" />
                </div>
              </div>
              <div class="glass-button flex size-10 shrink-0 items-center justify-center rounded-full text-foreground">
                <PlayIcon class="size-4" />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <span class="section-eyebrow pt-2.5">PERSONAL ROUTINES</span>
    <div class="glass flex flex-col rounded-2xl px-4 shadow-none">
      <template
        x-for="(routine, index) in personalRoutines()"
        :key="routine.routineId"
      >
        <RoutineRow />
      </template>
      <div
        class="flex items-center justify-between gap-3 py-4"
        :class="personalRoutines().length ? 'border-t border-border' : ''"
      >
        <div
          class="h-9 flex-1 animate-pulse rounded-lg bg-white/12"
          x-show="loading"
          x-cloak
          aria-hidden="true"
        >
        </div>
        <p
          class="text-xs/normal text-pretty text-muted"
          x-show="!loading"
          x-cloak
          x-text="personalRoutines().length ? 'Build another from any game or drill.' : 'No custom routines yet. Build one from any game or drill.'"
        >
        </p>
        <button
          type="button"
          class="glass-button flex size-11 shrink-0 items-center justify-center rounded-full text-foreground"
          aria-label="Create routine"
          @click="showModal = true"
        >
          <PlusIcon
            class="size-4"
            aria-hidden="true"
          />
        </button>
      </div>
    </div>

    <span class="section-eyebrow pt-2.5">TRIVIA</span>
    <a
      href="/training/quick-subtract"
      class="glass flex items-center gap-3 rounded-2xl p-4 text-foreground shadow-none"
    >
      <div class="flex min-w-0 flex-1 flex-col gap-1.5">
        <span class="font-display text-[13px]/[normal] tracking-[0.06em]">
          Quick Subtract
        </span>
        <span class="text-xs/normal text-pretty text-muted">
          Drill checkout mental math against the clock or a target count
        </span>
      </div>
      <DartIcon
        class="size-6.5 shrink-0 -rotate-45 text-accent"
        aria-hidden="true"
      />
    </a>

    <RoutineFormModal
      mode="create"
      openExpr="showModal"
      detached
    />
    <ScheduleFormModal openExpr="showScheduleModal" />
  </div>
</AppLayout>
