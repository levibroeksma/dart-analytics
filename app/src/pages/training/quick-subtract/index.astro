---
export const prerender = true;

import GameLayout from "@layouts/GameLayout.astro";
import QuickSubtract from "@components/layout/trivia/QuickSubtract.astro";
---

<GameLayout
  title="Quick Subtract"
  gameTitle="Quick Subtract"
  exitDescription="Your progress in this session will be lost."
>
  <div
    class="flex flex-col flex-1 min-h-0 p-3"
    x-data="quickSubtractPlay()"
    @confirm-exit.window="exit()"
  >
    <QuickSubtract />
  </div>
</GameLayout>
