---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Prisoner from "@components/layout/games/interfaces/Prisoner.astro";
import PrisonerResults from "@components/layout/games/result-modals/PrisonerResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Prisoner — Play"
  gameTitle="Prisoner"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="prisonerPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/prisoner/setup">
    {/* Gameplay view */}
    <Prisoner
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <PrisonerResults />
  </PlayPageShell>
</GameLayout>
