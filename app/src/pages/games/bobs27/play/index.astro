---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Bobs27 from "@components/layout/games/interfaces/Bobs27.astro";
import Bobs27Results from "@components/layout/games/result-modals/Bobs27Results.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Bob's 27 — Play"
  gameTitle="Bob's 27"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="bobs27Play()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/bobs27/setup">
    {/* Gameplay view */}
    <Bobs27
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <Bobs27Results />
  </PlayPageShell>
</GameLayout>
