---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import TenUpOneDown from "@components/layout/games/interfaces/TenUpOneDown.astro";
import CountdownPauseControl from "@components/layout/games/CountdownPauseControl.astro";
import ConfirmDialog from "@components/ui/ConfirmDialog.astro";
import InlayRow from "@components/ui/InlayRow.astro";
import CheckoutConfirm from "@components/layout/games/CheckoutConfirm.astro";
import TenUpOneDownResults from "@components/layout/games/result-modals/TenUpOneDownResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Ten Up One Down — Play"
  gameTitle="Ten Up One Down"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="tuodPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <CountdownPauseControl
    slot="header-end"
    disabledExpr="finished || showDoubleConfirm || showFinishConfirm"
  />
  <PlayPageShell setupHref="/games/tuod/setup">
    {/* Gameplay view */}
    <TenUpOneDown
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {
      /* Checkout confirm — a typed total that matches the target is only a
      success when the finishing dart landed in a double, which the number
      alone cannot say */
    }
    <div
      x-show="showDoubleConfirm"
      x-cloak
    >
      <CheckoutConfirm />
    </div>

    {/* Finish confirm (before results) */}
    <div
      x-show="showFinishConfirm"
      x-cloak
    >
      <ConfirmDialog
        titleId="finish-confirm-title"
        title="Finish session?"
        description="This attempt completes the session. Confirm to save and finish, or cancel to reconsider."
        confirmLabel="Finish"
        onCancel="cancelFinish()"
        onConfirm="confirmFinish()"
        dismissible={false}
      >
        <InlayRow
          slot="context"
          rowExpr="$store.game.contextRow()"
        />
      </ConfirmDialog>
    </div>

    {/* Results modal (overlay) */}
    <TenUpOneDownResults />
  </PlayPageShell>
</GameLayout>
