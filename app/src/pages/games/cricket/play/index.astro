---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Cricket from "@components/layout/games/interfaces/Cricket.astro";
import CricketResults from "@components/layout/games/result-modals/CricketResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Cricket — Play"
  gameTitle="Cricket"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="cricketPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/cricket/setup">
    {/* Gameplay view */}
    <Cricket
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <CricketResults />
  </PlayPageShell>
</GameLayout>
