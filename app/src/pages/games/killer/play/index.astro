---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Killer from "@components/layout/games/interfaces/Killer.astro";
import KillerResults from "@components/layout/games/result-modals/KillerResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Killer — Play"
  gameTitle="Killer"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="killerPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/killer/setup">
    {/* Gameplay view */}
    <Killer
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <KillerResults />
  </PlayPageShell>
</GameLayout>
