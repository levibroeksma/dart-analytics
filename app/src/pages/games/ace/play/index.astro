---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Ace from "@components/layout/games/interfaces/Ace.astro";
import AceResults from "@components/layout/games/result-modals/AceResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Ace — Play"
  gameTitle="Ace"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="acePlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/ace/setup">
    {/* Gameplay view */}
    <Ace
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <AceResults />
  </PlayPageShell>
</GameLayout>
