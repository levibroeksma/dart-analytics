---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Fives from "@components/layout/games/interfaces/Fives.astro";
import FivesResults from "@components/layout/games/result-modals/FivesResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Fives — Play"
  gameTitle="Fives"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="fivesPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/fives/setup">
    {/* Gameplay view */}
    <Fives
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <FivesResults />
  </PlayPageShell>
</GameLayout>
