---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import FollowTheLeader from "@components/layout/games/interfaces/FollowTheLeader.astro";
import FollowTheLeaderResults from "@components/layout/games/result-modals/FollowTheLeaderResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Follow the Leader — Play"
  gameTitle="Follow the Leader"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="followTheLeaderPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/follow-the-leader/setup">
    {/* Gameplay view */}
    <FollowTheLeader
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <FollowTheLeaderResults />
  </PlayPageShell>
</GameLayout>
