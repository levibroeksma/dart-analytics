---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Tactics from "@components/layout/games/interfaces/Tactics.astro";
import TacticsResults from "@components/layout/games/result-modals/TacticsResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Tactics — Play"
  gameTitle="Tactics"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="tacticsPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/tactics/setup">
    {/* Gameplay view */}
    <Tactics
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <TacticsResults />
  </PlayPageShell>
</GameLayout>
