---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Tactics from "@components/layout/games/interfaces/Tactics.astro";
import TacticsResults from "@components/layout/games/result-modals/TacticsResults.astro";
import NoSessionPanel from "@components/layout/games/NoSessionPanel.astro";
import ReconciliationBlocked from "@components/layout/games/ReconciliationBlocked.astro";
---

<GameLayout
  title="Tactics — Play"
  gameTitle="Tactics"
  gameSubtitleExpr="subtitle()"
  x-data="tacticsPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <div class="flex flex-col flex-1 min-h-0">
    {/* Loading / reconciliation-blocked */}
    <ReconciliationBlocked />

    {/* No active session view */}
    <NoSessionPanel href="/games/tactics/setup" />

    {/* Gameplay view */}
    <Tactics
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <TacticsResults />
  </div>
</GameLayout>
