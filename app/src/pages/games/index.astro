---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import CatalogCard from "@components/ui/CatalogCard.astro";
import Tag from "@components/ui/Tag.astro";
import DifficultyMeter from "@components/ui/DifficultyMeter.astro";
import DifficultyLegend from "@components/ui/DifficultyLegend.astro";
import ResumeSessionDeck from "@components/layout/sessions/ResumeSessionDeck.astro";
import { groupedGames } from "@lib/game/rulesets/games-visibility";
---

<AppLayout title="Games">
  <div
    class="flex flex-col gap-3 px-4 pt-2"
    x-data="gamesIndex()"
  >
    <div class="flex items-center justify-between px-1 pt-5 pb-3">
      <h1 class="font-display text-title">Games</h1>
      <span
        class="mode-pill"
        x-show="analyticsMode()"
        x-cloak
      >
        ANALYTICS
      </span>
    </div>

    <ResumeSessionDeck />

    <div
      class="px-1"
      x-show="!noneVisible()"
      x-cloak
    >
      <DifficultyLegend />
    </div>

    {
      groupedGames().map((group) => (
        <div
          class="flex flex-col gap-2 pt-2.5"
          x-show={`groupVisible('${group.key}')`}
          x-cloak
        >
          <span class="section-eyebrow">{group.title}</span>
          <div class="catalog-grid grid gap-3">
            {group.games.map((game) => (
              <div
                class="contents"
                x-show={`isVisible('${game.rulesetVersionKey}')`}
                x-cloak
              >
                <CatalogCard
                  variant="game"
                  href={game.href}
                >
                  <Fragment slot="title">{game.title}</Fragment>
                  <DifficultyMeter
                    slot="meter"
                    levelExpr={`gameLevel('${game.gameTypeKey}')`}
                  />
                  <Fragment slot="caption">{game.caption}</Fragment>
                  <template
                    slot="tags"
                    x-for={`tag in gameTags('${game.gameTypeKey}')`}
                    {...{ ":key": "tag.key" }}
                  >
                    <Tag
                      overArt
                      nameExpr="tag.name"
                      axisExpr="tag.axis"
                      primaryExpr="tag.primary"
                    />
                  </template>
                </CatalogCard>
              </div>
            ))}
          </div>
        </div>
      ))
    }

    <div
      class="alert rounded-md border border-border px-4 py-3 space-y-2"
      x-show="!loading() && noneVisible()"
      x-cloak
    >
      <p class="text-sm text-muted-foreground">
        No game supports your current app mode, so there is nothing to start
        here until you pick a mode one of them records.
      </p>
      <a
        class="text-sm text-accent"
        href="/profile"
      >
        Change your app mode on your profile
      </a>
    </div>
  </div>
</AppLayout>
