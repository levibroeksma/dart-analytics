---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import ScoreTraining from "@components/layout/games/interfaces/ScoreTraining.astro";
import ConfirmDialog from "@components/ui/ConfirmDialog.astro";
import ScoreTrainingResults from "@components/layout/games/result-modals/ScoreTrainingResults.astro";
import NoSessionPanel from "@components/layout/games/NoSessionPanel.astro";
import ReconciliationBlocked from "@components/layout/games/ReconciliationBlocked.astro";
import BoardInputPanel from "@components/layout/games/BoardInputPanel.astro";
---

<GameLayout
  title="Score Training — Play"
  gameTitle="Score Training"
>
  <div
    class="flex flex-col flex-1 min-h-0 p-3"
    x-data="scoreTrainingPlay()"
    @confirm-exit.window="abandonAndExit()"
  >
    {/* Loading / reconciliation-blocked */}
    <ReconciliationBlocked />

    {/* No active session view */}
    <NoSessionPanel />

    {/* Gameplay view */}
    <ScoreTraining
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {
      /* Visual board — shown instead of the keypad above for an
      ANALYTICS + VISUAL_BOARD session, which enters every dart by pointer. */
    }
    <BoardInputPanel />

    {/* Finish confirm (before results) */}
    <div
      x-show="showFinishConfirm"
      x-cloak
    >
      <ConfirmDialog
        titleId="finish-confirm-title"
        title="Finish session?"
        description="This visit completes the session. Confirm to save and finish, or cancel to reconsider."
        confirmLabel="Confirm"
        onCancel="cancelFinish()"
        onConfirm="confirmFinish()"
        dismissible={false}
      />
    </div>

    {/* Results modal (overlay) */}
    <ScoreTrainingResults />
  </div>
</GameLayout>
