---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Shanghai from "@components/layout/games/interfaces/Shanghai.astro";
import ShanghaiResults from "@components/layout/games/result-modals/ShanghaiResults.astro";
import NoSessionPanel from "@components/layout/games/NoSessionPanel.astro";
import ReconciliationBlocked from "@components/layout/games/ReconciliationBlocked.astro";
---

<GameLayout
  title="Shanghai — Play"
  gameTitle="SHANGHAI"
>
  <div
    class="flex flex-col flex-1 min-h-0 p-3"
    x-data="shanghaiPlay()"
    @confirm-exit.window="abandonAndExit()"
  >
    {/* Loading / reconciliation-blocked */}
    <ReconciliationBlocked />

    {/* No active session view */}
    <NoSessionPanel href="/games/shanghai/setup" />

    {/* Gameplay view */}
    <Shanghai
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <ShanghaiResults />
  </div>
</GameLayout>
