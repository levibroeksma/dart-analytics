---
export const prerender = true;
import GameLayout from "@layouts/GameLayout.astro";
import Shanghai from "@components/layout/games/interfaces/Shanghai.astro";
import ShanghaiResults from "@components/layout/games/result-modals/ShanghaiResults.astro";
import PlayPageShell from "@components/layout/games/PlayPageShell.astro";
---

<GameLayout
  title="Shanghai — Play"
  gameTitle="Shanghai"
  gameSubtitleExpr="hasActiveSession ? subtitle() : ''"
  x-data="shanghaiPlay()"
  @confirm-exit.window="abandonAndExit()"
>
  <PlayPageShell setupHref="/games/shanghai/setup">
    {/* Gameplay view */}
    <Shanghai
      x-show="!finished && hasActiveSession"
      x-cloak
    />

    {/* Results modal (overlay) */}
    <ShanghaiResults />
  </PlayPageShell>
</GameLayout>
