---
export const prerender = true;
import AppLayout from "@layouts/AppLayout.astro";
import LogoutButton from "@components/ui/LogoutButton.astro";
import LogoLockup from "../assets/logo-lockup.svg";
---

<AppLayout title="Home">
  <div class="p-4 flex">
    <LogoutButton />
  </div>
  <div class="px-4">
    <LogoLockup
      aria-hidden="true"
      class="size-40"
    />
    <article
      class="flex flex-col gap-2 px-2 text-sm text-muted-foreground space-y-4 pt-4"
    >
      <p>
        Welcome to the <strong
          class="font-semibold font-display text-xs text-accent"
          >Darts Analytics</strong
        > platform.
      </p>
      <p>
        This platform is designed to help you track your darts performance and
        improve your skills.
      </p>
      <p>
        It offers a variety of games for recreational, training and competitive
        use. Helps you track every dart, game and training session and offers
        extensive insights and statistics to help you improve your game.
      </p>
    </article>
  </div>
</AppLayout>
